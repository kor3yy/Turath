---
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');
const archivePosts = posts
  .filter((post) => !`${post.slug} ${post.data.title}`.toLowerCase().includes('acknowledg'))
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0));
const timelinePosts = [...posts]
  .filter((post) => post.data.pubDate)
  .sort((a, b) => (a.data.pubDate?.valueOf() ?? 0) - (b.data.pubDate?.valueOf() ?? 0));
---

<div class="turath-interactions" data-turath-interactions>
  <div class="ti-discover-source" hidden>
    {archivePosts.map((post) => <a href={`/blog/${post.slug}/`}><strong>{post.data.title}</strong><span>{post.data.description}</span></a>)}
  </div>
  <button class="ti-discover-trigger" type="button">✳ Discover</button>
  <section class="ti-discover" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="ti-discover-title">
    <div class="ti-discover-panel">
      <button class="ti-close" type="button" aria-label="Close">×</button>
      <p class="ti-kicker">A small detour</p>
      <h2 id="ti-discover-title">Discover something.</h2>
      <div class="ti-result" aria-live="polite">Let Turath take you somewhere unexpected.</div>
      <button class="ti-again" type="button">Show me something →</button>
    </div>
  </section>

  <button class="ti-timeline-trigger" type="button" aria-expanded="false" aria-controls="ti-timeline">Explore the archive through time</button>
  <section class="ti-timeline" id="ti-timeline" hidden>
    <p class="ti-kicker">The archive, in time</p>
    <h2>Stories leave traces.</h2>
    <div class="ti-timeline-track">
      {timelinePosts.map((post) => (
        <a class="ti-timeline-item" href={`/blog/${post.slug}/`}>
          <time>{post.data.pubDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</time>
          <strong>{post.data.title}</strong>
          <span>{post.data.description}</span>
        </a>
      ))}
    </div>
  </section>
  <aside class="ti-note" hidden role="status">
    <button class="ti-note-close" type="button" aria-label="Close note">×</button>
    <p class="ti-kicker">A note in the margin</p>
    <p class="ti-note-copy"></p>
  </aside>
  <div class="ti-secret" hidden>Some things are carried, not archived.</div>
</div>

<style>
  .ti-kicker{margin:0 0 .55rem;color:var(--muted);font-size:.66rem;letter-spacing:.2em;text-transform:uppercase}
  .ti-discover-trigger{position:fixed;right:1.2rem;bottom:1.2rem;z-index:900;padding:.72rem 1rem;border:1px solid var(--border-color);border-radius:999px;color:var(--page-text);background:var(--surface-bg);font:inherit;font-size:.78rem;cursor:pointer;backdrop-filter:blur(14px);transition:transform .25s ease}
  .ti-discover-trigger:hover{transform:translateY(-3px)}
  .ti-timeline-trigger{display:block;margin:3.5rem auto;padding:.8rem 1.15rem;border:1px solid var(--border-color);border-radius:999px;color:var(--page-text);background:var(--surface-bg);font:inherit;font-size:.82rem;cursor:pointer}
  .ti-timeline{width:min(100% - 2rem,1000px);margin:3rem auto 5rem;padding:2rem 0;border-block:1px solid var(--border-color)}
  .ti-timeline h2{margin:0 0 1.5rem;font-size:clamp(1.7rem,4vw,2.7rem);letter-spacing:-.05em}
  .ti-timeline-track{display:flex;gap:1rem;overflow-x:auto;padding:.5rem 0 1.2rem;scroll-snap-type:x mandatory}
  .ti-timeline-item{display:flex;flex:0 0 min(280px,78vw);min-height:150px;flex-direction:column;justify-content:space-between;gap:.8rem;padding:1rem;border:1px solid var(--border-color);border-radius:10px;color:var(--page-text);background:var(--surface-bg);text-decoration:none;scroll-snap-align:start;transition:transform .25s ease,border-color .25s ease}
  .ti-timeline-item:hover{transform:translateY(-4px);border-color:var(--page-text)}
  .ti-timeline-item time,.ti-timeline-item span{color:var(--muted);font-size:.78rem}.ti-timeline-item strong{font-size:1rem;line-height:1.35}
  .ti-discover[hidden],.ti-timeline[hidden],.ti-note[hidden],.ti-secret[hidden]{display:none!important}
  .ti-discover{position:fixed;inset:0;z-index:10020;display:grid;place-items:center;padding:1rem;background:rgb(0 0 0 / 65%);backdrop-filter:blur(12px)}
  .ti-discover-panel{position:relative;width:min(100%,540px);padding:clamp(1.5rem,5vw,3rem);border:1px solid var(--border-color);border-radius:16px;color:var(--page-text);background:var(--surface-bg);box-shadow:0 25px 90px rgb(0 0 0 / 35%);animation:ti-enter .45s ease both}
  .ti-discover-panel h2{margin:0 0 1.5rem;font-size:clamp(2rem,6vw,3.5rem);letter-spacing:-.06em}.ti-result{min-height:110px;padding:1rem 0;line-height:1.6}.ti-result a{color:inherit;text-underline-offset:4px}.ti-result p{color:var(--muted)}
  .ti-again{padding:.8rem 1rem;border:1px solid var(--border-color);border-radius:999px;color:var(--page-text);background:transparent;font:inherit;cursor:pointer}
  .ti-close,.ti-note-close{position:absolute;top:.8rem;right:.9rem;width:36px;height:36px;border:1px solid var(--border-color);border-radius:50%;color:var(--page-text);background:transparent;font-size:1.4rem;cursor:pointer}
  .ti-note{position:fixed;right:1.2rem;bottom:5rem;z-index:10010;width:min(340px,calc(100vw - 2.4rem));padding:1.2rem 1.3rem;border:1px solid var(--border-color);border-radius:12px;color:var(--page-text);background:var(--surface-bg);box-shadow:0 15px 50px rgb(0 0 0 / 22%)}.ti-note-copy{margin:0;padding-right:1rem;font-size:.9rem;line-height:1.6}
  .ti-secret{position:fixed;inset:auto 1rem 1rem;z-index:10030;padding:1rem;border:1px solid var(--border-color);border-radius:10px;color:var(--page-text);background:var(--surface-bg);text-align:center;letter-spacing:.08em;animation:ti-enter .5s ease both}
  .ti-cursor-label{position:fixed;z-index:10001;left:0;top:0;pointer-events:none;opacity:0;color:var(--page-text);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;mix-blend-mode:difference}.ti-cursor-label.is-visible{opacity:.9}
  [data-ti-type]{display:inline-block;transition:filter .25s ease,letter-spacing .25s ease,transform .25s ease}[data-ti-type]:hover{filter:blur(.45px);letter-spacing:.035em;transform:skewX(-2deg)}
  [data-ti-reveal]{opacity:0;transform:translateY(22px);filter:blur(5px);transition:opacity .8s ease,transform .8s ease,filter .8s ease}[data-ti-reveal].ti-revealed{opacity:1;transform:none;filter:none}
  [data-ti-image]{overflow:hidden}[data-ti-image] img{transition:filter .4s ease,transform .7s ease}[data-ti-image]:hover img{filter:blur(2px) saturate(.75);transform:scale(1.035)}
  .ti-photo-reveal{position:relative;cursor:crosshair}.ti-photo-reveal::before{content:'';position:absolute;inset:0;z-index:1;background-image:var(--ti-next-image);background-size:cover;background-position:center;clip-path:inset(0 calc(100% - var(--ti-reveal,0%)) 0 0);pointer-events:none;transition:clip-path .08s linear}.ti-photo-reveal::after{content:'DRAG TO REVEAL';position:absolute;right:.7rem;bottom:.7rem;z-index:2;padding:.35rem .5rem;border:1px solid rgb(255 255 255 / 35%);border-radius:999px;color:white;background:rgb(0 0 0 / 35%);font-size:.55rem;letter-spacing:.12em;pointer-events:none}.ti-photo-reveal.is-distorted img{filter:blur(2px) contrast(1.05)!important;transform:scale(1.025)}
  .ti-annotated{text-decoration:underline dotted;text-underline-offset:4px;cursor:help}
  .turath-marquee-track span{transition:letter-spacing .3s ease,filter .3s ease}.turath-marquee:hover .turath-marquee-track span{letter-spacing:.28em;filter:blur(.25px)}
  @keyframes ti-enter{from{opacity:0;transform:translateY(15px) scale(.985);filter:blur(6px)}to{opacity:1;transform:none;filter:none}}
  @media(max-width:600px){.ti-discover-trigger{right:.8rem;bottom:.8rem}.ti-timeline{margin:2.5rem auto 3.5rem}}
  @media(prefers-reduced-motion:reduce){[data-ti-reveal]{opacity:1;transform:none;filter:none}*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>

<script>
  function initTurathInteractions() {
    const root = document.querySelector('[data-turath-interactions]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const discover = root.querySelector('.ti-discover');
    const result = root.querySelector('.ti-result');
    const open = root.querySelector('.ti-discover-trigger');
    const close = root.querySelector('.ti-close');
    const again = root.querySelector('.ti-again');
    const timelineButton = root.querySelector('.ti-timeline-trigger');
    const timeline = root.querySelector('.ti-timeline');
    const note = root.querySelector('.ti-note');
    const noteCopy = root.querySelector('.ti-note-copy');

    function discoverSomething() {
      const links = [...root.querySelectorAll('.ti-discover-source a'), ...document.querySelectorAll('a[href*="/blog/"]')].filter((a) => a.querySelector('h2,h3,h4,strong') || a.classList.contains('article-card') || a.classList.contains('related-card') || a.closest('.ti-discover-source'));
      if (!links.length) { result.textContent = 'Explore the archive and follow a story that catches your attention.'; return; }
      const item = links[Math.floor(Math.random() * links.length)];
      const title = item.querySelector('h2,h3,h4,strong')?.textContent?.trim() || item.getAttribute('aria-label') || 'A story from Turath';
      const description = item.querySelector('p')?.textContent?.trim() || 'A perspective from the Turath archive.';
      result.innerHTML = `<p class="ti-kicker">From the archive</p><h3><a href="${item.href}">${title}</a></h3><p>${description}</p>`;
    }
    open?.addEventListener('click', () => { discoverSomething(); discover.hidden = false; discover.setAttribute('aria-hidden','false'); close?.focus(); });
    close?.addEventListener('click', () => { discover.hidden = true; discover.setAttribute('aria-hidden','true'); open?.focus(); });
    again?.addEventListener('click', discoverSomething);
    discover?.addEventListener('click', (event) => { if (event.target === discover) close.click(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !discover.hidden) close.click(); });

    timelineButton?.addEventListener('click', () => {
      const showing = timeline.hidden;
      timeline.hidden = !showing;
      timelineButton.setAttribute('aria-expanded', String(showing));
      if (showing) timeline.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    });

    const notes = {
      turath: 'Turath (تُراث) refers to heritage, tradition and the cultural legacy passed between generations.',
      heritage: 'Heritage can be living: language, memory, art, knowledge, customs and the things people carry forward.',
      culture: 'Culture is not one single story. It is shaped by people, place, memory, creativity and change.',
      expression: 'Expression gives people room to communicate identity, experience and perspective through creative work.'
    };
    const walker = document.createTreeWalker(document.querySelector('main') || document.body, NodeFilter.SHOW_TEXT);
    const nodes = [];
    while (walker.nextNode()) {
      const node = walker.currentNode;
      if (node.parentElement?.closest('a,button,script,style,h1,h2,h3,h4,.ti-note,.ti-discover')) continue;
      if (/\b(turath|heritage|culture|expression)\b/i.test(node.nodeValue || '')) nodes.push(node);
    }
    nodes.forEach((node) => {
      const fragment = document.createDocumentFragment();
      const pieces = node.nodeValue.split(/\b(turath|heritage|culture|expression)\b/gi);
      pieces.forEach((piece) => {
        const key = piece.toLowerCase();
        if (notes[key]) {
          const button = document.createElement('button'); button.type = 'button'; button.className = 'ti-annotated'; button.textContent = piece;
          button.addEventListener('click', () => { noteCopy.textContent = notes[key]; note.hidden = false; }); fragment.append(button);
        } else fragment.append(document.createTextNode(piece));
      });
      node.parentNode?.replaceChild(fragment, node);
    });
    root.querySelector('.ti-note-close')?.addEventListener('click', () => { note.hidden = true; });

    const reveal = document.querySelectorAll('main h2,main h3,main p,main figure,.featured-card,.latest-article-card,.archive,.related-card');
    reveal.forEach((el) => el.setAttribute('data-ti-reveal',''));
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('ti-revealed'); observer.unobserve(entry.target); } }), { threshold: .12 });
      reveal.forEach((el) => observer.observe(el));
    } else reveal.forEach((el) => el.classList.add('ti-revealed'));

    const pageImages = [...document.querySelectorAll('main img')].filter((img) => !img.closest('header,.ti-discover,.ti-timeline'));
    pageImages.forEach((img, index) => {
      const parent = img.parentElement;
      if (!parent) return;
      const target = img.matches('.featured-image,.latest-article-image,.cover-image') ? parent : parent;
      target.setAttribute('data-ti-image','');
      if (target.matches('.article-opening-image,.featured-card,.latest-article-card,.category-cover,.article-card-image-wrap,.related-card-image')) {
        const alternate = pageImages[(index + 1) % pageImages.length] || img;
        target.classList.add('ti-photo-reveal');
        target.style.setProperty('--ti-next-image', `url("${alternate.currentSrc || alternate.src}")`);
        let dragging = false;
        target.addEventListener('pointerdown', (event) => { dragging = true; target.setPointerCapture?.(event.pointerId); updateReveal(event); });
        target.addEventListener('pointermove', (event) => { if (dragging) updateReveal(event); });
        target.addEventListener('pointerup', () => { dragging = false; });
        target.addEventListener('pointercancel', () => { dragging = false; });
        function updateReveal(event) {
          const rect = target.getBoundingClientRect();
          const percent = Math.max(0, Math.min(100, ((event.clientX - rect.left) / rect.width) * 100));
          target.style.setProperty('--ti-reveal', `${percent}%`);
          target.classList.add('is-distorted');
        }
        target.addEventListener('pointerleave', () => { dragging = false; target.classList.remove('is-distorted'); target.style.setProperty('--ti-reveal','0%'); });
      }
    });

    const cursor = document.createElement('span'); cursor.className = 'ti-cursor-label'; cursor.setAttribute('aria-hidden','true'); document.body.append(cursor);
    document.addEventListener('pointermove', (event) => { cursor.style.transform = `translate(${event.clientX + 14}px,${event.clientY + 14}px)`; }, { passive:true });
    document.querySelectorAll('a,button,[data-ti-image]').forEach((target) => {
      target.addEventListener('pointerenter', () => { cursor.textContent = target.closest('.ti-discover-trigger') ? 'DISCOVER' : target.closest('.ti-timeline-trigger') ? 'EXPLORE' : target.closest('.article-card,.related-card,.article-opening-image') ? 'READ' : target.closest('.music-player,#music-player,[data-music-player]') ? 'LISTEN' : target.tagName === 'A' ? 'OPEN' : 'VIEW'; cursor.classList.add('is-visible'); });
      target.addEventListener('pointerleave', () => cursor.classList.remove('is-visible'));
    });
    document.querySelectorAll('main h1,main h2,main h3,.hero h1').forEach((el) => el.setAttribute('data-ti-type',''));

    function secret() { const box = root.querySelector('.ti-secret'); box.hidden = false; setTimeout(() => { box.hidden = true; }, 4000); }
    let clicks = 0, clickTimer;
    document.querySelectorAll('header .logo,header .site-logo').forEach((logo) => logo.addEventListener('click', (event) => {
      clicks++; clearTimeout(clickTimer); clickTimer = setTimeout(() => { clicks = 0; }, 1800);
      if (clicks >= 5) { event.preventDefault(); secret(); clicks = 0; }
    }));
    let typed = '';
    document.addEventListener('keydown', (event) => { if (event.key.length === 1) { typed = (typed + event.key.toLowerCase()).slice(-6); if (typed === 'turath') { secret(); typed = ''; } } });

    const marquee = document.querySelector('.turath-marquee-track');
    if (marquee && !reduceMotion) {
      let frame = 0;
      window.addEventListener('scroll', () => { if (frame) return; frame = requestAnimationFrame(() => { marquee.style.animationDuration = `${Math.min(24,Math.max(16,20 + scrollY/500))}s`; frame = 0; }); }, { passive:true });
    }
  }
  document.addEventListener('astro:page-load', initTurathInteractions);
  initTurathInteractions();
</script>
