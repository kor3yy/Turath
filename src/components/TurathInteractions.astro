
<div class="turath-interactions" data-turath-interactions>
  <span class="ti-cursor-label" aria-hidden="true"></span>
  <div class="ti-secret" hidden>Some things are carried, not archived.</div>
</div>

<style>
  .ti-secret {
    position: fixed;
    inset: auto 1rem 1rem;
    z-index: 10030;
    padding: 1rem;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--page-text);
    background: var(--surface-bg);
    text-align: center;
    letter-spacing: .08em;
    animation: ti-enter .5s ease both;
  }

  .ti-secret[hidden] {
    display: none !important;
  }

  .ti-cursor-label {
    position: fixed;
    z-index: 10001;
    left: 0;
    top: 0;
    pointer-events: none;
    opacity: 0;
    color: var(--page-text);
    font-size: .62rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    mix-blend-mode: difference;
  }

  .ti-cursor-label.is-visible {
    opacity: .9;
  }

  [data-ti-image] {
    overflow: hidden;
  }

  [data-ti-image] img {
    transition: filter .4s ease, transform .7s ease;
  }

  [data-ti-image]:hover img {
    filter: blur(2px) saturate(.75);
    transform: scale(1.035);
  }

  .ti-photo-reveal {
    position: relative;
    cursor: crosshair;
  }

  .ti-photo-reveal::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: var(--ti-next-image);
    background-size: cover;
    background-position: center;
    clip-path: inset(0 calc(100% - var(--ti-reveal, 0%)) 0 0);
    pointer-events: none;
    transition: clip-path .08s linear;
  }

  .ti-photo-reveal::after {
    content: 'DRAG TO REVEAL';
    position: absolute;
    right: .7rem;
    bottom: .7rem;
    z-index: 2;
    padding: .35rem .5rem;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 999px;
    color: white;
    background: rgb(0 0 0 / 35%);
    font-size: .55rem;
    letter-spacing: .12em;
    pointer-events: none;
  }

  .ti-photo-reveal.is-distorted img {
    filter: blur(2px) contrast(1.05) !important;
    transform: scale(1.025);
  }

  @keyframes ti-enter {
    from {
      opacity: 0;
      transform: translateY(15px) scale(.985);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .01ms !important;
      transition-duration: .01ms !important;
    }
  }
</style>

<script>
  function initTurathInteractions() {
    const root = document.querySelector('[data-turath-interactions]');
    if (!root || root.dataset.initialized === 'true') return;

    root.dataset.initialized = 'true';

    const pageImages = [
      ...document.querySelectorAll('main img')
    ].filter((img) => !img.closest('header'));

    pageImages.forEach((img, index) => {
      const target = img.parentElement;
      if (!target) return;

      target.setAttribute('data-ti-image', '');

      if (
        target.matches(
          '.article-opening-image,.featured-card,.latest-article-card,.category-cover,.article-card-image-wrap,.related-card-image'
        )
      ) {
        const alternate = pageImages[(index + 1) % pageImages.length] || img;

        target.classList.add('ti-photo-reveal');
        target.style.setProperty(
          '--ti-next-image',
          `url("${alternate.currentSrc || alternate.src}")`
        );

        let dragging = false;

        target.addEventListener('pointerdown', (event) => {
          dragging = true;
          target.setPointerCapture?.(event.pointerId);
          updateReveal(event);
        });

        target.addEventListener('pointermove', (event) => {
          if (dragging) updateReveal(event);
        });

        target.addEventListener('pointerup', () => {
          dragging = false;
        });

        target.addEventListener('pointercancel', () => {
          dragging = false;
        });

        function updateReveal(event) {
          const rect = target.getBoundingClientRect();
          const percent = Math.max(
            0,
            Math.min(100, ((event.clientX - rect.left) / rect.width) * 100)
          );

          target.style.setProperty('--ti-reveal', `${percent}%`);
          target.classList.add('is-distorted');
        }

        target.addEventListener('pointerleave', () => {
          dragging = false;
          target.classList.remove('is-distorted');
          target.style.setProperty('--ti-reveal', '0%');
        });
      }
    });

    const cursor = root.querySelector('.ti-cursor-label');

    document.addEventListener('pointermove', (event) => {
      cursor.style.transform =
        `translate(${event.clientX + 14}px,${event.clientY + 14}px)`;
    }, { passive: true });

    document.querySelectorAll('a,button,[data-ti-image]').forEach((target) => {
      target.addEventListener('pointerenter', () => {
        cursor.textContent =
          target.closest('.article-card,.related-card,.article-opening-image')
            ? 'READ'
            : target.closest('.music-player,#music-player,[data-music-player]')
              ? 'LISTEN'
              : target.tagName === 'A'
                ? 'OPEN'
                : 'VIEW';

        cursor.classList.add('is-visible');
      });

      target.addEventListener('pointerleave', () => {
        cursor.classList.remove('is-visible');
      });
    });

    function secret() {
      const box = root.querySelector('.ti-secret');
      box.hidden = false;
      setTimeout(() => {
        box.hidden = true;
      }, 4000);
    }

    let clicks = 0;
    let clickTimer;

    document.querySelectorAll('header .logo,header .site-logo').forEach((logo) => {
      logo.addEventListener('click', (event) => {
        clicks++;
        clearTimeout(clickTimer);

        clickTimer = setTimeout(() => {
          clicks = 0;
        }, 1800);

        if (clicks >= 5) {
          event.preventDefault();
          secret();
          clicks = 0;
        }
      });
    });

    let typed = '';

    document.addEventListener('keydown', (event) => {
      if (event.key.length === 1) {
        typed = (typed + event.key.toLowerCase()).slice(-6);

        if (typed === 'turath') {
          secret();
          typed = '';
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initTurathInteractions);
  initTurathInteractions();
</script>
