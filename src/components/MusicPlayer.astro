
---
---

<div
  class="turath-music-player"
  id="turath-music-player"
  transition:persist="turath-music-player"
>  <audio
    id="turath-audio"
    src="/audio/vibesvibinginvibeland.mp3/Blang%20-%20Toren.mp3"
    preload="metadata"
  ></audio>

  <button
    class="turath-play-button"
    id="turath-play-button"
    type="button"
    aria-label="Play music"
    title="Play music"
  >
    <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 5.5v13l10-6.5z" fill="currentColor" />
    </svg>
    <svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M7.5 5.5h3.5v13H7.5zM13 5.5h3.5v13H13z" fill="currentColor" />
    </svg>
  </button>

  <div class="turath-player-content">
    <div class="turath-player-label">
      <span class="turath-player-name">TURATH RADIO</span>
      <span class="turath-player-status" id="turath-player-status">READY</span>
    </div>

        <select
      class="turath-playlist-select"
      id="turath-playlist-select"
      aria-label="Choose playlist"
    >
      <option value="vibesvibinginvibeland.mp3">vibesvibinginvibeland.mp3</option>
      <option value="ambereyedangelinablackdress.mp3">ambereyedangelinablackdress.mp3</option>
    </select>

    <select
      class="turath-track-select"
      id="turath-track-select"
      aria-label="Choose song"
    ></select>

    <canvas
      class="turath-waveform"
      id="turath-waveform"
      aria-hidden="true"
    ></canvas>
  </div>

  <button
    class="turath-mute-button"
    id="turath-mute-button"
    type="button"
    aria-label="Mute music"
    title="Mute music"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M11 5 6 9H3v6h3l5 4V5Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <path
        class="volume-waves"
        d="M15 9a5 5 0 0 1 0 6m2.5-8.5a8.5 8.5 0 0 1 0 11"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      />
      <path
        class="volume-muted"
        d="m15 9 5 6m0-6-5 6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      />
    </svg>
  </button>
</div>

<style>
  .turath-music-player {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 10001;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 310px;
    min-height: 100px;
    padding: 12px 13px;
    box-sizing: border-box;
    color: inherit;
    background: color-mix(in srgb, Canvas 90%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 17%, transparent);
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.09);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    font-family: inherit;
    isolation: isolate;
  }

  .turath-play-button,
  .turath-mute-button {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
    color: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .turath-play-button {
    width: 34px;
    height: 34px;
    border: 1px solid color-mix(in srgb, currentColor 23%, transparent);
    border-radius: 50%;
    transition: background 180ms ease, transform 180ms ease;
  }

  .turath-play-button:hover {
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .turath-play-button:active {
    transform: scale(0.94);
  }

  .turath-play-button svg {
    width: 17px;
    height: 17px;
  }

  .pause-icon,
  .turath-music-player.is-playing .play-icon {
    display: none;
  }

  .turath-music-player.is-playing .pause-icon {
    display: block;
  }

  .turath-player-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
  }

  .turath-player-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .turath-player-name {
    overflow: hidden;
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.13em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .turath-player-status {
    flex: 0 0 auto;
    font-size: 8px;
    letter-spacing: 0.1em;
    opacity: 0.55;
  }

  .turath-playlist-select,
  .turath-track-select {
    display: block;
    width: 100%;
    min-width: 0;
    padding: 3px 5px;
    color: inherit;
    background: color-mix(in srgb, Canvas 85%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    border-radius: 5px;
    font-family: inherit;
    font-size: 10px;
    cursor: pointer;
  }

  .turath-playlist-select {
    font-weight: 600;
  }

  .turath-track-select {
    opacity: 0.8;
  }

  .turath-playlist-select:focus-visible,
  .turath-track-select:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .turath-waveform {
    display: block;
    width: 100%;
    height: 22px;
    overflow: hidden;
  }

  .turath-mute-button {
    width: 22px;
    height: 30px;
    opacity: 0.7;
    transition: opacity 180ms ease;
  }

  .turath-mute-button:hover {
    opacity: 1;
  }

  .turath-mute-button svg {
    width: 18px;
    height: 18px;
  }

  .volume-muted,
  .turath-music-player.is-muted .volume-waves {
    display: none;
  }

  .turath-music-player.is-muted .volume-muted {
    display: block;
  }

  .turath-play-button:focus-visible,
  .turath-mute-button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (max-width: 600px) {
    .turath-music-player {
      right: 14px;
      bottom: 14px;
      width: min(290px, calc(100vw - 28px));
      min-height: 96px;
      gap: 10px;
      padding: 10px 11px;
      border-radius: 12px;
    }

    .turath-play-button {
      width: 32px;
      height: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .turath-play-button,
    .turath-mute-button {
      transition: none;
    }
  }
</style>

<script>
  const player = document.querySelector("#turath-music-player");
  const audio = document.querySelector("#turath-audio");
  const playButton = document.querySelector("#turath-play-button");
  const muteButton = document.querySelector("#turath-mute-button");
  const statusLabel = document.querySelector("#turath-player-status");
  const canvas = document.querySelector("#turath-waveform");
  const playlistSelect = document.querySelector("#turath-playlist-select");
  const trackSelect = document.querySelector("#turath-track-select");

  if (
    player instanceof HTMLElement &&
    audio instanceof HTMLAudioElement &&
    playButton instanceof HTMLButtonElement &&
    muteButton instanceof HTMLButtonElement &&
    statusLabel instanceof HTMLElement &&
    canvas instanceof HTMLCanvasElement &&
    playlistSelect instanceof HTMLSelectElement &&
    trackSelect instanceof HTMLSelectElement
  ) {
    const playlists = {
      "vibesvibinginvibeland.mp3": [
        ["Blang - Toren", "Blang - Toren.mp3"],
        ["Bliss - Toren", "Bliss - Toren - Topic.mp3"],
        ["Check My Phone - Toren", "Check My Phone - Toren.mp3"],
        ["Different Regions - Toren", "Different Regions - Toren.mp3"],
        ["DrugDealer - Toren", "DrugDealer - Toren.mp3"],
        ["Dubbies - Toren", "Dubbies - Toren.mp3"],
        ["GT - Toren", "GT - Toren.mp3"],
        ["Jungle Odyssey - Toren", "Jungle Odyssey - Toren.mp3"],
        ["Kirk - Toren", "Kirk - Toren.mp3"],
        ["Let's Have Fun! - Toren", "Let's Have Fun ! - Toren.mp3"],
        ["Lookin Up - Toren", "Lookin Up - Toren .mp3"],
        ["Nameless - Toren", "Nameless - Toren.mp3"],
        ["New 2 This Life - Toren", "New 2 This Life - Toren.mp3"],
        ["Omgbrain - Toren", "Omgbrain - Toren.mp3"],
        ["Rockin 1of1 - Toren", "Rockin 1of1 - Toren.mp3"],
        ["Stellium - Toren", "Stellium - Toren.mp3"],
        ["Tom Holland - Toren", "Tom Holland - Toren.mp3"],
        ["Top Rank - Toren", "Top Rank - Toren.mp3"],
        ["Vibe With You - Toren", "Vibe With You - Toren.mp3"]
      ],
           "ambereyedangelinablackdress.mp3": [
        ["But I Might - Savia Ashby", "but i might - Savia Ashby.mp3"],
        ["Juiceboxx - Savia Ashby", "juiceboxx - Savia Ashby.mp3"],
        ["Tunnelvision - Savia Ashby", "tunnelvision - Savia Ashby.mp3"]
      ]
    };

       const playlistFolders = {
      "vibesvibinginvibeland.mp3": "/audio/vibesvibinginvibeland.mp3/",
      "ambereyedangelinablackdress.mp3": "/audio/ambereyedangelinablackdress.mp3/"
    };

    const context = canvas.getContext("2d");
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let audioContext;
    let analyser;
    let source;
    let samples;
    let animationFrame = 0;
    let isReady = false;

    function resizeCanvas() {
      if (!context) return;

      const rect = canvas.getBoundingClientRect();
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.max(1, Math.round(rect.width * pixelRatio));
      canvas.height = Math.max(1, Math.round(rect.height * pixelRatio));

      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      drawIdleWave();
    }

    function drawIdleWave() {
      if (!context) return;

      const width = canvas.clientWidth;
      const height = canvas.clientHeight;

      context.clearRect(0, 0, width, height);
      context.beginPath();
      context.lineWidth = 1.4;
      context.lineCap = "round";
      context.strokeStyle = getComputedStyle(player).color;
      context.globalAlpha = 0.5;

      for (let x = 0; x <= width; x += 2) {
        const y =
          height / 2 +
          Math.sin((x / Math.max(width, 1)) * Math.PI * 4) * 1.5;

        if (x === 0) context.moveTo(x, y);
        else context.lineTo(x, y);
      }

      context.stroke();
      context.globalAlpha = 1;
    }

    function setupAudio() {
      if (isReady) return true;

      const AudioContextClass =
        window.AudioContext || window.webkitAudioContext;

      if (!AudioContextClass || !context) return false;

      try {
        audioContext = new AudioContextClass();
        analyser = audioContext.createAnalyser();
        analyser.fftSize = 1024;
        analyser.smoothingTimeConstant = 0.78;

        source = audioContext.createMediaElementSource(audio);
        source.connect(analyser);
        analyser.connect(audioContext.destination);

        samples = new Uint8Array(analyser.fftSize);
        isReady = true;

        return true;
      } catch {
        statusLabel.textContent = "AUDIO ONLY";
        return false;
      }
    }

    function drawWaveform() {
      if (!context || !analyser || !samples || audio.paused) return;

      const width = canvas.clientWidth;
      const height = canvas.clientHeight;

      if (!width || !height) {
        if (!reducedMotion) {
          animationFrame = requestAnimationFrame(drawWaveform);
        }
        return;
      }

      analyser.getByteTimeDomainData(samples);

      context.clearRect(0, 0, width, height);
      context.beginPath();
      context.lineWidth = 1.5;
      context.lineCap = "round";
      context.lineJoin = "round";
      context.strokeStyle = getComputedStyle(player).color;
      context.globalAlpha = 0.9;

      const middle = height / 2;
      const amplitude = height * 0.46;
      const step = width / (samples.length - 1);

      for (let i = 0; i < samples.length; i++) {
        const x = i * step;
        const normalized = (samples[i] - 128) / 128;
        const y = middle + normalized * amplitude;

        if (i === 0) context.moveTo(x, y);
        else context.lineTo(x, y);
      }

      context.stroke();
      context.globalAlpha = 1;

      if (!reducedMotion) {
        animationFrame = requestAnimationFrame(drawWaveform);
      }
    }

    function populateTracks() {
      const playlist = playlists[playlistSelect.value];

      trackSelect.replaceChildren();

      playlist.forEach(([name], index) => {
        const option = document.createElement("option");
        option.value = String(index);
        option.textContent = name;
        trackSelect.appendChild(option);
      });
    }

    function loadTrack(index, autoplay = false) {
      const playlistKey = playlistSelect.value;
      const playlist = playlists[playlistKey];
      const track = playlist[index];

      if (!track) return;

      const wasPlaying = !audio.paused;
      audio.pause();

      audio.src =
        playlistFolders[playlistKey] + encodeURIComponent(track[1]);

      audio.load();
      trackSelect.value = String(index);
      player.classList.remove("is-playing");
      playButton.setAttribute("aria-label", "Play music");
      playButton.title = "Play music";
      statusLabel.textContent = "READY";

      cancelAnimationFrame(animationFrame);
      drawIdleWave();

      if (autoplay || wasPlaying) {
        void playAudio();
      }
    }

    async function playAudio() {
      if (setupAudio() && audioContext.state === "suspended") {
        try {
          await audioContext.resume();
        } catch {
          statusLabel.textContent = "TAP TO RETRY";
          return;
        }
      }

      try {
        await audio.play();

        player.classList.add("is-playing");
        playButton.setAttribute("aria-label", "Pause music");
        playButton.title = "Pause music";
        statusLabel.textContent = "PLAYING";

        cancelAnimationFrame(animationFrame);

        if (isReady) drawWaveform();
      } catch {
        player.classList.remove("is-playing");
        statusLabel.textContent = "TRACK UNAVAILABLE";
      }
    }

    function pauseAudio() {
      audio.pause();
      player.classList.remove("is-playing");
      playButton.setAttribute("aria-label", "Play music");
      playButton.title = "Play music";
      statusLabel.textContent = "PAUSED";

      cancelAnimationFrame(animationFrame);
      drawIdleWave();
    }

    playlistSelect.addEventListener("change", () => {
      populateTracks();
      loadTrack(0);
    });

    trackSelect.addEventListener("change", () => {
      loadTrack(Number(trackSelect.value));
    });

    playButton.addEventListener("click", () => {
      if (audio.paused) void playAudio();
      else pauseAudio();
    });

    muteButton.addEventListener("click", () => {
      audio.muted = !audio.muted;
      player.classList.toggle("is-muted", audio.muted);

      muteButton.setAttribute(
        "aria-label",
        audio.muted ? "Unmute music" : "Mute music"
      );

      muteButton.title = audio.muted ? "Unmute music" : "Mute music";
    });

    audio.addEventListener("playing", () => {
      player.classList.add("is-playing");
      playButton.setAttribute("aria-label", "Pause music");
      playButton.title = "Pause music";
      statusLabel.textContent = "PLAYING";
    });

    audio.addEventListener("pause", () => {
      if (audio.ended) return;

      player.classList.remove("is-playing");
      cancelAnimationFrame(animationFrame);
      drawIdleWave();
    });

    audio.addEventListener("ended", () => {
      const nextIndex = Number(trackSelect.value) + 1;
      const playlist = playlists[playlistSelect.value];

      // Continue to the next song, then restart the playlist.
      loadTrack(nextIndex < playlist.length ? nextIndex : 0, true);
    });

    audio.addEventListener("error", () => {
      statusLabel.textContent = "TRACK NOT FOUND";
    });

    window.addEventListener("resize", resizeCanvas);

    populateTracks();
    resizeCanvas();
  }
</script>
