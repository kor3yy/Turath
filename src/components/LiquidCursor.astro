
---
---

<div class="liquid-cursor" aria-hidden="true">
  <span class="liquid-cursor__core"></span>
</div>

<svg class="liquid-filters" aria-hidden="true">
  <filter id="liquid-warp">
    <feTurbulence
      type="fractalNoise"
      baseFrequency="0.018 0.025"
      numOctaves="2"
      seed="8"
      result="noise"
    />
    <feDisplacementMap
      in="SourceGraphic"
      in2="noise"
      scale="12"
      xChannelSelector="R"
      yChannelSelector="G"
    />
  </filter>
</svg>

<style>
  .liquid-filters {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .liquid-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 76px;
    height: 76px;
    z-index: 999999;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 42% 58% 55% 45% / 48% 43% 57% 52%;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: invert(1) contrast(1.2);
    -webkit-backdrop-filter: invert(1) contrast(1.2);
    mix-blend-mode: difference;
    transform: translate3d(-50%, -50%, 0);
    transition:
      width 0.3s ease,
      height 0.3s ease,
      border-radius 0.4s ease,
      background 0.25s ease;
    will-change: transform;
  }

  .liquid-cursor__core {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 5px;
    height: 5px;
    background: white;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .liquid-cursor.is-hovering {
    width: 105px;
    height: 105px;
    border-radius: 55% 45% 48% 52% / 43% 57% 45% 55%;
  }

  /* Only transparent over the background */
  .liquid-cursor.cursor-background-mode {
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    mix-blend-mode: normal !important;
  }

  .liquid-cursor.cursor-background-mode .liquid-cursor__core {
    opacity: 0;
  }

  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .liquid-cursor {
      display: none !important;
    }
  }
</style>

<script>
  function initLiquidCursor() {
    const cursor = document.querySelector('.liquid-cursor');

    if (!cursor || cursor.dataset.initialized === 'true') return;

    cursor.dataset.initialized = 'true';

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let currentX = mouseX;
    let currentY = mouseY;
    let animationFrame;

    const interactiveSelector = [
      'a',
      'button',
      'input',
      'textarea',
      'select',
      'article',
      'section',
      '[role="button"]',
      '[tabindex]:not([tabindex="-1"])',
      '.article-card',
      '.post-card',
      '.music-card',
      '.photo-card',
      '.clickable'
    ].join(',');

    function isBackground(target) {
      if (!(target instanceof Element)) return true;

      if (target.closest(interactiveSelector)) return false;

      if (
        target.closest(
          '.turath-photo-background, .turath-photo-reveal, .turath-ambient-glow'
        )
      ) {
        return true;
      }

      return !target.closest(
        'main, article, section, header, footer, nav, .article-content, .content'
      );
    }

    function updateMode(target) {
      const backgroundMode = isBackground(target);

      cursor.classList.toggle(
        'cursor-background-mode',
        backgroundMode
      );

      document.documentElement.classList.toggle(
        'turath-cursor-active',
        backgroundMode
      );
    }

    function animate() {
      currentX += (mouseX - currentX) * 0.18;
      currentY += (mouseY - currentY) * 0.18;

      cursor.style.transform =
        `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%)`;

      document.documentElement.style.setProperty(
        '--turath-reveal-x',
        `${currentX}px`
      );

      document.documentElement.style.setProperty(
        '--turath-reveal-y',
        `${currentY}px`
      );

      animationFrame = requestAnimationFrame(animate);
    }

    function handlePointerMove(event) {
      mouseX = event.clientX;
      mouseY = event.clientY;

      updateMode(event.target);

      const hoveredElement = event.target instanceof Element
        ? event.target.closest('a, button, input, textarea, select, [role="button"]')
        : null;

      cursor.classList.toggle('is-hovering', Boolean(hoveredElement));
    }

    function handlePointerLeave() {
      cursor.classList.remove('cursor-background-mode', 'is-hovering');
      document.documentElement.classList.remove('turath-cursor-active');
    }

    window.addEventListener('pointermove', handlePointerMove);
    document.addEventListener('pointerleave', handlePointerLeave);
    window.addEventListener('blur', handlePointerLeave);

    cancelAnimationFrame(animationFrame);
    animationFrame = requestAnimationFrame(animate);

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationFrame);
      window.removeEventListener('pointermove', handlePointerMove);
      document.removeEventListener('pointerleave', handlePointerLeave);
      window.removeEventListener('blur', handlePointerLeave);
    }, { once: true });
  }

  initLiquidCursor();

  document.addEventListener('astro:page-load', initLiquidCursor);
</script>
