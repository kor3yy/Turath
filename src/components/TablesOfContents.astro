
<nav class="turath-toc" aria-label="Table of contents" hidden>
  <details class="toc-panel" open>
    <summary class="toc-summary">
      <span class="toc-heading">
        <span class="toc-eyebrow">READING GUIDE</span>
        <span class="toc-title">On this page</span>
      </span>
      <span class="toc-chevron" aria-hidden="true">⌄</span>
    </summary>
    <ol class="toc-list"></ol>
  </details>
</nav>

<style>
  .turath-toc {
    margin: 1.75rem 0 2.25rem;
    color: inherit;
    font-family: inherit;
  }

  .turath-toc[hidden] {
    display: none;
  }

  .toc-panel {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, currentColor 2.5%, transparent);
  }

  .toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-summary:focus-visible,
  .toc-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .toc-heading {
    display: grid;
    gap: 0.25rem;
  }

  .toc-eyebrow {
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    opacity: 0.6;
  }

  .toc-title {
    font-size: 0.98rem;
    font-weight: 550;
    letter-spacing: -0.015em;
  }

  .toc-chevron {
    font-size: 1.25rem;
    opacity: 0.65;
    transition: transform 180ms ease;
  }

  .toc-panel[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0.4rem 1.1rem 1rem;
    border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    list-style: none;
  }

  .toc-item {
    margin: 0;
    padding: 0;
  }

  .toc-item.level-3 {
    padding-left: 1rem;
  }

  .toc-item.level-4 {
    padding-left: 2rem;
  }

  .toc-link {
    display: block;
    padding: 0.55rem 0 0.55rem 0.85rem;
    border-left: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    color: inherit;
    font-size: 0.86rem;
    line-height: 1.55;
    text-decoration: none;
    overflow-wrap: anywhere;
    opacity: 0.72;
    transition: opacity 180ms ease, border-color 180ms ease;
  }

  .toc-link:hover {
    opacity: 1;
  }

  .toc-link[aria-current="location"] {
    border-left: 2px solid currentColor;
    font-weight: 600;
    opacity: 1;
  }

  .article-body h2,
  .article-body h3,
  .article-body h4 {
    scroll-margin-top: 2rem;
  }

  @media (max-width: 650px) {
    .turath-toc {
      margin: 1.25rem 0 1.75rem;
    }

    .toc-summary {
      padding: 0.9rem 1rem;
    }

    .toc-list {
      padding: 0.3rem 1rem 0.8rem;
    }

    .toc-link {
      padding-top: 0.6rem;
      padding-bottom: 0.6rem;
      font-size: 0.84rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-chevron,
    .toc-link {
      transition: none;
    }
  }
</style>

<script>
  const toc = document.querySelector(".turath-toc");
  const articleBody = document.querySelector(".article-body");

  if (toc && articleBody) {
    const list = toc.querySelector(".toc-list");

    if (list) {
      const headings = Array.from(
        articleBody.querySelectorAll("h2, h3, h4")
      ).filter((heading) => heading.textContent.trim());

      if (headings.length >= 2) {
        const usedIds = new Set(
          Array.from(document.querySelectorAll("[id]"))
            .map((element) => element.id)
            .filter(Boolean)
        );

        const links = [];

        headings.forEach((heading, index) => {
          if (!heading.id) {
            const base =
              heading.textContent
                .normalize("NFKD")
                .replace(/[\u0300-\u036f]/g, "")
                .toLowerCase()
                .trim()
                .replace(/[^\p{L}\p{N}\s-]/gu, "")
                .replace(/\s+/g, "-")
                .replace(/-+/g, "-") || `section-${index + 1}`;

            let id = base;
            let suffix = 2;

            while (usedIds.has(id)) {
              id = `${base}-${suffix++}`;
            }

            heading.id = id;
            usedIds.add(id);
          }

          const item = document.createElement("li");
          item.className = `toc-item level-${heading.tagName.substring(1)}`;

          const link = document.createElement("a");
          link.className = "toc-link";
          link.href = `#${encodeURIComponent(heading.id)}`;
          link.textContent = heading.textContent.trim();

          link.addEventListener("click", (event) => {
            event.preventDefault();

            heading.scrollIntoView({
              behavior: window.matchMedia(
                "(prefers-reduced-motion: reduce)"
              ).matches
                ? "auto"
                : "smooth",
              block: "start",
            });

            history.replaceState(
              null,
              "",
              `#${encodeURIComponent(heading.id)}`
            );

            setActive(heading.id);

            if (window.innerWidth <= 650) {
              toc.querySelector("details").open = false;
            }
          });

          item.appendChild(link);
          list.appendChild(item);
          links.push(link);
        });

        function setActive(id) {
          links.forEach((link) => {
            if (link.getAttribute("href") === `#${encodeURIComponent(id)}`) {
              link.setAttribute("aria-current", "location");
            } else {
              link.removeAttribute("aria-current");
            }
          });
        }

        setActive(headings[0].id);
        toc.hidden = false;

        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              const visible = entries
                .filter((entry) => entry.isIntersecting)
                .sort(
                  (a, b) =>
                    a.boundingClientRect.top - b.boundingClientRect.top
                );

              if (visible.length) {
                setActive(visible[0].target.id);
              }
            },
            {
              rootMargin: "-12% 0px -72% 0px",
              threshold: 0,
            }
          );

          headings.forEach((heading) => observer.observe(heading));
        }
      }
    }
  }
</script>
