
---
const {
  acknowledgments,
  musicPosts = [],
  photographyPosts = [],
  latestArticle,
} = Astro.props;

function orbitPosts(posts, parent) {
  return posts.map((post, index) => ({
    id: `${parent}-${index}`,
    parent,
    title: post.data.title,
    description: post.data.description || 'Explore this story in the Turath archive.',
    kind: 'article',
    url: `/blog/${post.slug}/`,
  }));
}

const nodes = [
  {
    id: 'acknowledgments',
    title: 'ACKNOWLEDGMENTS',
    description: 'A personal dedication to the people and memories that will forever be part of Turath.',
    kind: 'feature',
    url: acknowledgments ? `/blog/${acknowledgments.slug}/` : '',
  },
  {
    id: 'music',
    title: 'MUSIC',
    description: 'Artists, sounds, perspectives, and the stories behind the music.',
    kind: 'category',
  },
  {
    id: 'photography',
    title: 'PHOTOGRAPHY',
    description: 'Stories told through images and the people behind the lens.',
    kind: 'category',
  },
  {
    id: 'about',
    title: 'ABOUT TURATH',
    description: 'The meaning, origins, and story behind Turath.',
    kind: 'about',
    url: '#about',
  },
  ...(latestArticle
    ? [{
        id: 'latest',
        title: 'LATEST ARTICLE',
        description: latestArticle.data.title,
        kind: 'feature',
        url: `/blog/${latestArticle.slug}/`,
      }]
    : []),
  ...orbitPosts(musicPosts, 'music'),
  ...orbitPosts(photographyPosts, 'photography'),
];
---

<section
  class="turath-universe"
  id="turath-universe"
  data-archive={JSON.stringify(nodes)}
>
  <div class="universe-heading">
    <div class="universe-eyebrow">
      <span class="eyebrow-line"></span>
      TURATH ARCHIVE / DEEP SPACE
    </div>

    <h1>THE UNIVERSE</h1>

    <p>
      Explore the worlds, stories, and people within Turath.
    </p>
  </div>

  <div class="universe-interface">
    <div class="interface-topline">
      <div class="system-status">
        <span class="status-indicator"></span>
        DEEP SPACE OBSERVATION
      </div>

      <div class="system-coordinates">SECTOR 001 / TURATH SYSTEM</div>
    </div>

    <div class="universe-controls">
      <label class="universe-search">
        <span aria-hidden="true">⌕</span>
        <input
          id="universe-search"
          type="search"
          placeholder="SEARCH THE ARCHIVE"
          autocomplete="off"
        />
      </label>

      <button class="universe-reset" id="universe-reset" type="button">
        <span aria-hidden="true">↺</span>
        RESET VIEW
      </button>
    </div>

    <div class="universe-stage" id="universe-stage">
      <canvas id="universe-canvas" aria-label="Interactive 3D Turath universe"></canvas>

      <div class="universe-loading" id="universe-loading">
        <div class="loading-orbit">
          <span></span>
        </div>
        <p>INITIALIZING DEEP SPACE</p>
        <small>ESTABLISHING CONNECTION TO TURATH SYSTEM</small>
      </div>

      <div class="universe-failure" id="universe-failure" hidden>
        <span>THE OBSERVATORY IS UNAVAILABLE</span>
        <p id="universe-failure-message"></p>
      </div>

      <div class="universe-labels" id="universe-labels"></div>

      <div class="stage-corner stage-corner-tl">
        <span>TRTH / 001</span>
        <span>LIVE ORBITAL SYSTEM</span>
      </div>

      <div class="stage-corner stage-corner-tr">
        <span>3D ORBITAL VIEW</span>
        <span>DRAG TO ROTATE · SCROLL TO ZOOM</span>
      </div>

      <div class="stage-bottom-left">
        <span class="coordinate-dot"></span>
        <span id="universe-coordinate">SYSTEM ONLINE</span>
      </div>

      <div class="stage-bottom-right">
        <span>SELECT A WORLD TO EXPLORE</span>
      </div>

      <div class="planet-detail" id="planet-detail" aria-live="polite">
        <button class="detail-close" id="detail-close" type="button" aria-label="Close details">×</button>
        <div class="detail-kicker" id="detail-kicker">ARCHIVE DISCOVERY</div>
        <h2 id="detail-title">TURATH</h2>
        <p id="detail-description">
          An archive of culture, art, expression, and the people behind them.
        </p>
        <a id="detail-link" href="/about" hidden>EXPLORE ARCHIVE ↗</a>
      </div>
    </div>

    <div class="universe-bottomline">
      <span>THE TURATH SYSTEM</span>
      <span>DRAG TO EXPLORE THE UNIVERSE</span>
      <span>EST. MMXXIV</span>
    </div>
  </div>
</section>

<style>
  .turath-universe {
    --space-purple: #090511;
    --space-violet: #a879ff;
    --space-lilac: #d7c1ff;
    position: relative;
    overflow: hidden;
    padding: 100px 5vw 55px;
    color: #f3edff;
    background:
      radial-gradient(ellipse at 50% 42%, rgba(75, 35, 125, .18), transparent 58%),
      linear-gradient(180deg, #080510 0%, #0b0615 55%, #080510 100%);
    isolation: isolate;
  }

  .turath-universe::before,
  .turath-universe::after {
    position: absolute;
    z-index: -1;
    content: "";
    pointer-events: none;
    border-radius: 50%;
    filter: blur(90px);
  }

  .turath-universe::before {
    width: 420px;
    height: 420px;
    top: 25%;
    left: -250px;
    background: rgba(102, 44, 173, .12);
  }

  .turath-universe::after {
    width: 380px;
    height: 380px;
    right: -220px;
    bottom: 5%;
    background: rgba(67, 42, 145, .12);
  }

  .universe-heading {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto 38px;
    text-align: center;
  }

  .universe-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #b69adf;
    font-size: 9px;
    letter-spacing: .28em;
  }

  .eyebrow-line {
    width: 27px;
    height: 1px;
    background: #a879ff;
    box-shadow: 0 0 9px #a879ff;
  }

  .universe-heading h1 {
    margin: 16px 0 8px;
    color: #f4edff;
    font-size: clamp(38px, 6vw, 72px);
    font-weight: 300;
    letter-spacing: .2em;
    line-height: 1.1;
    text-shadow: 0 0 35px rgba(170, 116, 255, .28);
  }

  .universe-heading > p {
    margin: 0;
    color: #a89ab9;
    font-size: 13px;
    letter-spacing: .035em;
  }

  .universe-interface {
    position: relative;
    max-width: 1500px;
    margin: 0 auto;
    border: 1px solid rgba(180, 143, 255, .2);
    background: rgba(12, 7, 23, .68);
    box-shadow:
      0 0 60px rgba(99, 45, 165, .09),
      inset 0 0 55px rgba(100, 60, 150, .035);
    backdrop-filter: blur(14px);
  }

  .interface-topline,
  .universe-bottomline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    min-height: 43px;
    padding: 0 20px;
    color: #8d7ca6;
    font-size: 8px;
    letter-spacing: .17em;
  }

  .interface-topline {
    border-bottom: 1px solid rgba(180, 143, 255, .13);
  }

  .system-status {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .status-indicator,
  .coordinate-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    flex: 0 0 6px;
    border-radius: 50%;
    background: #b38aff;
    box-shadow: 0 0 10px #a879ff;
    animation: signalPulse 2s infinite;
  }

  .universe-controls {
    position: absolute;
    z-index: 5;
    top: 57px;
    left: 20px;
    right: 20px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    pointer-events: none;
  }

  .universe-search,
  .universe-reset {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 37px;
    padding: 0 13px;
    color: #c9b5e8;
    border: 1px solid rgba(182, 145, 255, .22);
    background: rgba(12, 7, 23, .75);
    backdrop-filter: blur(12px);
    pointer-events: auto;
  }

  .universe-search {
    width: min(270px, 55%);
  }

  .universe-search > span {
    font-size: 21px;
    line-height: 1;
  }

  .universe-search input {
    width: 100%;
    min-width: 0;
    padding: 0;
    outline: none;
    border: 0;
    color: #eee5ff;
    background: transparent;
    font: inherit;
    font-size: 8px;
    letter-spacing: .13em;
  }

  .universe-search input::placeholder {
    color: #87769e;
  }

  .universe-reset {
    cursor: pointer;
    font-size: 8px;
    letter-spacing: .13em;
    transition: background .2s, border-color .2s;
  }

  .universe-reset:hover {
    border-color: #b38aff;
    background: rgba(94, 54, 145, .28);
  }

  .universe-reset span {
    font-size: 17px;
  }

  .universe-stage {
    position: relative;
    height: clamp(520px, 67vw, 830px);
    min-height: 520px;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 50%, rgba(47, 23, 82, .22), transparent 60%),
      #080511;
  }

  .universe-stage::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(8, 5, 17, .45), transparent 17%, transparent 83%, rgba(8, 5, 17, .45)),
      linear-gradient(180deg, rgba(8, 5, 17, .28), transparent 20%, transparent 80%, rgba(8, 5, 17, .4));
  }

  #universe-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    outline: none;
    cursor: grab;
    touch-action: none;
  }

  #universe-canvas:active {
    cursor: grabbing;
  }

  .universe-labels {
    position: absolute;
    z-index: 2;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .planet-label {
    position: absolute;
    transform: translate(-50%, -50%);
    color: #eee5ff;
    text-align: center;
    white-space: nowrap;
    text-shadow: 0 0 12px #120821, 0 0 20px #120821;
    opacity: 0;
    transition: opacity .2s;
    pointer-events: auto;
    cursor: pointer;
  }

  .planet-label.visible {
    opacity: 1;
  }

  .planet-label strong {
    display: block;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .17em;
  }

  .planet-label small {
    display: block;
    margin-top: 4px;
    color: #ad98ca;
    font-size: 7px;
    letter-spacing: .12em;
  }

  .planet-label.active strong {
    color: #d9c1ff;
    text-shadow: 0 0 14px #a879ff;
  }

  .stage-corner,
  .stage-bottom-left,
  .stage-bottom-right {
    position: absolute;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: rgba(187, 164, 218, .7);
    font-size: 7px;
    letter-spacing: .15em;
    pointer-events: none;
  }

  .stage-corner-tl {
    top: 19px;
    left: 20px;
  }

  .stage-corner-tr {
    top: 19px;
    right: 20px;
    text-align: right;
  }

  .stage-bottom-left {
    bottom: 18px;
    left: 20px;
    flex-direction: row;
    align-items: center;
  }

  .stage-bottom-right {
    right: 20px;
    bottom: 18px;
    text-align: right;
  }

  .universe-loading {
    position: absolute;
    z-index: 8;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 13px;
    background: #080511;
    transition: opacity .7s, visibility .7s;
  }

  .universe-loading.finished {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .loading-orbit {
    display: grid;
    width: 43px;
    height: 43px;
    place-items: center;
    border: 1px solid rgba(180, 143, 255, .3);
    border-top-color: #c8a7ff;
    border-radius: 50%;
    animation: orbitSpin 1.4s linear infinite;
  }

  .loading-orbit span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c8a7ff;
    box-shadow: 0 0 14px #a879ff;
  }

  .universe-loading p {
    margin: 0;
    color: #d9c7f2;
    font-size: 9px;
    letter-spacing: .23em;
  }

  .universe-loading small {
    color: #77678e;
    font-size: 7px;
    letter-spacing: .13em;
  }

  .universe-failure {
    position: absolute;
    z-index: 9;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 30px;
    text-align: center;
    background: #080511;
  }

  .universe-failure[hidden] {
    display: none;
  }

  .universe-failure span {
    color: #d8c2fa;
    font-size: 11px;
    letter-spacing: .2em;
  }

  .universe-failure p {
    max-width: 500px;
    color: #a99ab9;
    font-size: 12px;
    line-height: 1.7;
  }

  .planet-detail {
    position: absolute;
    z-index: 6;
    right: 20px;
    bottom: 48px;
    width: min(320px, calc(100% - 40px));
    padding: 23px;
    border: 1px solid rgba(190, 157, 255, .3);
    background: rgba(13, 8, 25, .88);
    box-shadow: 0 0 35px rgba(118, 69, 190, .14);
    backdrop-filter: blur(16px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(9px);
    transition: opacity .25s, transform .25s, visibility .25s;
  }

  .planet-detail.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .detail-close {
    position: absolute;
    top: 8px;
    right: 12px;
    padding: 4px;
    border: 0;
    color: #bba5d9;
    background: none;
    font-size: 22px;
    cursor: pointer;
  }

  .detail-kicker {
    color: #ae8ae6;
    font-size: 8px;
    letter-spacing: .2em;
  }

  .planet-detail h2 {
    margin: 12px 0 9px;
    color: #f2eaff;
    font-size: 19px;
    font-weight: 400;
    letter-spacing: .12em;
  }

  .planet-detail p {
    margin: 0;
    color: #b4a5c7;
    font-size: 11px;
    line-height: 1.8;
  }

  .planet-detail a {
    display: inline-block;
    margin-top: 17px;
    color: #d5baff;
    font-size: 8px;
    letter-spacing: .16em;
    text-decoration: none;
  }

  .planet-detail a:hover {
    color: white;
  }

  .universe-bottomline {
    min-height: 40px;
    border-top: 1px solid rgba(180, 143, 255, .13);
    font-size: 7px;
  }

  @keyframes orbitSpin {
    to { transform: rotate(360deg); }
  }

  @keyframes signalPulse {
    50% { opacity: .35; }
  }

  @media (max-width: 650px) {
    .turath-universe {
      padding: 70px 12px 35px;
    }

    .universe-heading {
      margin-bottom: 25px;
    }

    .universe-heading h1 {
      letter-spacing: .13em;
    }

    .universe-stage {
      height: 620px;
      min-height: 620px;
    }

    .interface-topline,
    .universe-bottomline {
      padding: 0 10px;
      font-size: 6px;
      letter-spacing: .1em;
    }

    .universe-controls {
      top: 52px;
      left: 10px;
      right: 10px;
    }

    .universe-search,
    .universe-reset {
      min-height: 34px;
      padding: 0 9px;
    }

    .universe-search input {
      font-size: 7px;
    }

    .stage-corner-tl,
    .stage-bottom-left {
      left: 10px;
    }

    .stage-corner-tr,
    .stage-bottom-right {
      right: 10px;
    }

    .stage-corner,
    .stage-bottom-left,
    .stage-bottom-right {
      font-size: 6px;
    }

    .planet-detail {
      right: 10px;
      bottom: 38px;
      width: min(290px, calc(100% - 20px));
    }

    .universe-bottomline span:nth-child(2) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-indicator,
    .coordinate-dot,
    .loading-orbit {
      animation: none;
    }
  }
</style>

<script is:inline>
(() => {
  const initialize = async () => {
    const root = document.getElementById('turath-universe');
    if (!root || root.dataset.initialized === 'true') return;

    root.dataset.initialized = 'true';

    const canvas = root.querySelector('#universe-canvas');
    const stage = root.querySelector('#universe-stage');
    const labelsElement = root.querySelector('#universe-labels');
    const loading = root.querySelector('#universe-loading');
    const failure = root.querySelector('#universe-failure');
    const failureMessage = root.querySelector('#universe-failure-message');
    const detail = root.querySelector('#planet-detail');
    const detailTitle = root.querySelector('#detail-title');
    const detailDescription = root.querySelector('#detail-description');
    const detailKicker = root.querySelector('#detail-kicker');
    const detailLink = root.querySelector('#detail-link');
    const search = root.querySelector('#universe-search');
    const resetButton = root.querySelector('#universe-reset');
    const coordinate = root.querySelector('#universe-coordinate');

    let THREE;
    let renderer;
    let animationFrame;
    let resizeObserver;
    let cleanupDone = false;
    let selected = null;
    let isDragging = false;
    let moved = false;
    let pointerStart = { x: 0, y: 0 };
    let rotation = { x: -0.12, y: 0 };
    let targetRotation = { x: -0.12, y: 0 };
    let cameraTarget = 49;
    let cameraDistance = 49;
    let previousTime = 0;

    const archive = JSON.parse(root.dataset.archive || '[]');
    const labelElements = new Map();
    const clickableMeshes = [];
    const bodies = [];
    const moons = [];
    const clock = { elapsed: 0 };

    const showFailure = (message) => {
      loading.classList.add('finished');
      failure.hidden = false;
      failureMessage.textContent = message;
      console.error('TURATH OBSERVATORY:', message);
    };

    try {
      try {
        THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js');
      } catch (firstError) {
        THREE = await import('https://unpkg.com/three@0.180.0/build/three.module.js');
      }

      if (cleanupDone || !root.isConnected) return;

      const scene = new THREE.Scene();
      scene.background = new THREE.Color('#080511');
      scene.fog = new THREE.FogExp2('#080511', 0.0042);

      const camera = new THREE.PerspectiveCamera(
        43,
        stage.clientWidth / stage.clientHeight,
        0.1,
        500
      );
      camera.position.set(0, 5, cameraDistance);
      camera.lookAt(0, 0, 0);

      renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: false,
        powerPreference: 'high-performance'
      });

      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(stage.clientWidth, stage.clientHeight);
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.25;

      const universe = new THREE.Group();
      scene.add(universe);

      const ambient = new THREE.AmbientLight('#8d78b9', 1.05);
      scene.add(ambient);

      const centralLight = new THREE.PointLight('#c4a0ff', 190, 100, 1.6);
      centralLight.position.set(0, 0, 0);
      scene.add(centralLight);

      const fillLight = new THREE.PointLight('#5c70ff', 80, 100, 2);
      fillLight.position.set(-16, 10, -18);
      scene.add(fillLight);

      const rimLight = new THREE.PointLight('#ed9dff', 75, 100, 2);
      rimLight.position.set(18, -8, 12);
      scene.add(rimLight);

      const makeSeededRandom = (seed) => {
        let value = seed;
        return () => {
          value = (value * 16807) % 2147483647;
          return (value - 1) / 2147483646;
        };
      };

      const random = makeSeededRandom(72841);

      // Procedural planet surfaces: generated locally, no image files required.
      const makePlanetTexture = (base, accent, style, seed) => {
        const rand = makeSeededRandom(seed);
        const canvasTexture = document.createElement('canvas');
        canvasTexture.width = 1024;
        canvasTexture.height = 512;

        const context = canvasTexture.getContext('2d');
        const gradient = context.createLinearGradient(0, 0, 0, 512);
        gradient.addColorStop(0, accent);
        gradient.addColorStop(.48, base);
        gradient.addColorStop(1, '#080511');
        context.fillStyle = gradient;
        context.fillRect(0, 0, 1024, 512);

        if (style === 'bands') {
          for (let i = 0; i < 30; i++) {
            const y = rand() * 512;
            const height = 2 + rand() * 24;
            context.fillStyle = i % 2
              ? 'rgba(240,220,255,.10)'
              : 'rgba(12,5,28,.18)';
            context.fillRect(0, y, 1024, height);
          }

          for (let i = 0; i < 10; i++) {
            context.beginPath();
            context.ellipse(
              rand() * 1024,
              rand() * 512,
              20 + rand() * 90,
              5 + rand() * 22,
              rand(),
              0,
              Math.PI * 2
            );
            context.fillStyle = 'rgba(255,220,255,.12)';
            context.fill();
          }
        } else {
          for (let i = 0; i < 95; i++) {
            const x = rand() * 1024;
            const y = rand() * 512;
            const rx = 8 + rand() * 90;
            const ry = 4 + rand() * 40;

            context.beginPath();
            context.ellipse(x, y, rx, ry, rand() * 2, 0, Math.PI * 2);
            context.fillStyle = i % 3 === 0
              ? 'rgba(235,210,255,.16)'
              : 'rgba(5,2,18,.17)';
            context.fill();
          }
        }

        for (let i = 0; i < 16000; i++) {
          const x = rand() * 1024;
          const y = rand() * 512;
          const alpha = rand() * .16;
          context.fillStyle = `rgba(255,255,255,${alpha})`;
          context.fillRect(x, y, 1 + rand() * 2, 1 + rand() * 2);
        }

        const texture = new THREE.CanvasTexture(canvasTexture);
        texture.colorSpace = THREE.SRGBColorSpace;
        texture.anisotropy = renderer.capabilities.getMaxAnisotropy();
        return texture;
      };

      const makeGlowTexture = () => {
        const glowCanvas = document.createElement('canvas');
        glowCanvas.width = 256;
        glowCanvas.height = 256;
        const ctx = glowCanvas.getContext('2d');
        const gradient = ctx.createRadialGradient(128, 128, 0, 128, 128, 128);
        gradient.addColorStop(0, 'rgba(220,190,255,.7)');
        gradient.addColorStop(.15, 'rgba(165,100,255,.32)');
        gradient.addColorStop(.48, 'rgba(110,60,200,.10)');
        gradient.addColorStop(1, 'rgba(80,40,160,0)');
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, 256, 256);
        return new THREE.CanvasTexture(glowCanvas);
      };

      const glowTexture = makeGlowTexture();

      const makeGlow = (color, size, opacity = .5) => {
        const sprite = new THREE.Sprite(
          new THREE.SpriteMaterial({
            map: glowTexture,
            color,
            transparent: true,
            opacity,
            depthWrite: false,
            blending: THREE.AdditiveBlending
          })
        );
        sprite.scale.set(size, size, 1);
        return sprite;
      };

      // Background nebula clouds.
      for (let i = 0; i < 18; i++) {
        const cloud = makeGlow(
          ['#6232a5', '#382477', '#9b5ac9', '#443b9c'][i % 4],
          12 + random() * 22,
          .09 + random() * .08
        );
        cloud.position.set(
          (random() - .5) * 100,
          (random() - .5) * 55,
          -18 - random() * 55
        );
        scene.add(cloud);
      }

      // Deep-space star field.
      const starPositions = [];
      const starColors = [];
      const starSizes = [];

      for (let i = 0; i < 4200; i++) {
        const radius = 38 + random() * 115;
        const theta = random() * Math.PI * 2;
        const vertical = (random() - .5) * 90;

        starPositions.push(
          Math.cos(theta) * radius,
          vertical,
          Math.sin(theta) * radius
        );

        const tint = random();
        const color = new THREE.Color(
          tint > .92 ? '#d9baff' :
          tint > .72 ? '#a6a7ff' :
          '#ffffff'
        );

        starColors.push(color.r, color.g, color.b);
        starSizes.push(.35 + random() * 1.3);
      }

      const starGeometry = new THREE.BufferGeometry();
      starGeometry.setAttribute(
        'position',
        new THREE.Float32BufferAttribute(starPositions, 3)
      );
      starGeometry.setAttribute(
        'color',
        new THREE.Float32BufferAttribute(starColors, 3)
      );

      const starMaterial = new THREE.PointsMaterial({
        size: .42,
        vertexColors: true,
        transparent: true,
        opacity: .85,
        sizeAttenuation: true,
        depthWrite: false
      });

      const stars = new THREE.Points(starGeometry, starMaterial);
      scene.add(stars);

      // Smaller foreground stars.
      const nearStarPositions = [];
      for (let i = 0; i < 550; i++) {
        nearStarPositions.push(
          (random() - .5) * 90,
          (random() - .5) * 48,
          (random() - .5) * 75
        );
      }

      const nearGeometry = new THREE.BufferGeometry();
      nearGeometry.setAttribute(
        'position',
        new THREE.Float32BufferAttribute(nearStarPositions, 3)
      );

      const nearStars = new THREE.Points(
        nearGeometry,
        new THREE.PointsMaterial({
          color: '#d8c2ff',
          size: .7,
          transparent: true,
          opacity: .7,
          sizeAttenuation: true
        })
      );
      scene.add(nearStars);

      // Central Turath star.
      const centralGroup = new THREE.Group();
      universe.add(centralGroup);

      const centralSphere = new THREE.Mesh(
        new THREE.SphereGeometry(2.5, 64, 64),
        new THREE.MeshStandardMaterial({
          color: '#d7baff',
          emissive: '#9b59ff',
          emissiveIntensity: 2.2,
          roughness: .28,
          metalness: .1
        })
      );
      centralGroup.add(centralSphere);

      const centralGlow = makeGlow('#b987ff', 15, .95);
      centralGroup.add(centralGlow);

      const centralHalo = new THREE.Mesh(
        new THREE.SphereGeometry(3.2, 48, 48),
        new THREE.MeshBasicMaterial({
          color: '#b78bff',
          transparent: true,
          opacity: .12,
          side: THREE.BackSide,
          blending: THREE.AdditiveBlending
        })
      );
      centralGroup.add(centralHalo);

      // Fine orbital rings.
      const addOrbit = (radius, color = '#8865bb', opacity = .22, tilt = 0) => {
        const points = [];
        for (let i = 0; i <= 256; i++) {
          const angle = (i / 256) * Math.PI * 2;
          points.push(
            new THREE.Vector3(
              Math.cos(angle) * radius,
              Math.sin(angle) * radius * .34,
              0
            )
          );
        }

        const geometry = new THREE.BufferGeometry().setFromPoints(points);
        const material = new THREE.LineBasicMaterial({
          color,
          transparent: true,
          opacity
        });

        const line = new THREE.Line(geometry, material);
        line.rotation.x = tilt;
        universe.add(line);
        return line;
      };

      const planetConfig = {
        acknowledgments: {
          orbit: 7.5, size: 1.05, speed: .12,
          color: '#e0a7d7', accent: '#6e315e', style: 'clouds',
          tilt: .1, ring: false
        },
        music: {
          orbit: 12, size: 1.48, speed: .085,
          color: '#9566df', accent: '#34205f', style: 'bands',
          tilt: .25, ring: true
        },
        photography: {
          orbit: 17, size: 1.3, speed: .063,
          color: '#4d9aaf', accent: '#183e64', style: 'clouds',
          tilt: -.12, ring: true
        },
        about: {
          orbit: 22, size: 1.7, speed: .046,
          color: '#d4a66d', accent: '#67422c', style: 'bands',
          tilt: .16, ring: false
        },
        latest: {
          orbit: 27, size: 1.12, speed: .035,
          color: '#a78bff', accent: '#38265f', style: 'clouds',
          tilt: -.18, ring: false
        }
      };

      const categoryOrbitRings = [7.5, 12, 17, 22, 27];
      categoryOrbitRings.forEach((radius, index) => {
        addOrbit(radius, index % 2 ? '#9d79d5' : '#73539e', .24, .035 * index);
      });

      const addPlanet = (node, config) => {
        const group = new THREE.Group();
        universe.add(group);

        const texture = makePlanetTexture(
          config.color,
          config.accent,
          config.style,
          100 + config.orbit * 10
        );

        const material = new THREE.MeshStandardMaterial({
          map: texture,
          roughness: .82,
          metalness: .08
        });

        const mesh = new THREE.Mesh(
          new THREE.SphereGeometry(config.size, 64, 64),
          material
        );

        mesh.rotation.z = config.tilt;
        group.add(mesh);

        const atmosphere = new THREE.Mesh(
          new THREE.SphereGeometry(config.size * 1.09, 48, 48),
          new THREE.MeshBasicMaterial({
            color: config.color,
            transparent: true,
            opacity: .12,
            side: THREE.BackSide,
            blending: THREE.AdditiveBlending,
            depthWrite: false
          })
        );
        group.add(atmosphere);

        const glow = makeGlow(config.color, config.size * 5, .4);
        group.add(glow);

        if (config.ring) {
          const ring = new THREE.Mesh(
            new THREE.RingGeometry(config.size * 1.45, config.size * 2.1, 128),
            new THREE.MeshBasicMaterial({
              color: config.color,
              side: THREE.DoubleSide,
              transparent: true,
              opacity: .32,
              depthWrite: false
            })
          );
          ring.rotation.x = Math.PI / 2.35;
          ring.rotation.y = .2;
          group.add(ring);

          const outerRing = new THREE.Mesh(
            new THREE.RingGeometry(config.size * 2.12, config.size * 2.2, 128),
            new THREE.MeshBasicMaterial({
              color: '#d6b8ff',
              side: THREE.DoubleSide,
              transparent: true,
              opacity: .12,
              depthWrite: false
            })
          );
          outerRing.rotation.copy(ring.rotation);
          group.add(outerRing);
        }

        const body = {
          node,
          group,
          mesh,
          config,
          angle: random() * Math.PI * 2,
          moons: []
        };

        mesh.userData.body = body;
        clickableMeshes.push(mesh);
        bodies.push(body);

        const label = document.createElement('button');
        label.type = 'button';
        label.className = 'planet-label';
        label.innerHTML = `<strong></strong><small>ARCHIVE WORLD</small>`;
        label.querySelector('strong').textContent = node.title;
        label.addEventListener('click', () => selectNode(node, body));
        labelsElement.appendChild(label);
        labelElements.set(node.id, label);

        return body;
      };

      const bodyById = new Map();

      for (const node of archive) {
        if (!planetConfig[node.id]) continue;
        const body = addPlanet(node, planetConfig[node.id]);
        bodyById.set(node.id, body);
      }

      // Smaller archive satellites orbit their category worlds.
      for (const node of archive.filter(item => item.parent)) {
        const parent = bodyById.get(node.parent);
        if (!parent) continue;

        const index = parent.moons.length;
        const orbitRadius = parent.config.size * (2.15 + index * .65);
        const size = .16 + (index % 3) * .045;

        const moonGroup = new THREE.Group();
        parent.group.add(moonGroup);

        const moonMesh = new THREE.Mesh(
          new THREE.SphereGeometry(size, 24, 24),
          new THREE.MeshStandardMaterial({
            color: index % 2 ? '#d7c1ff' : '#9e7bd6',
            emissive: '#69429c',
            emissiveIntensity: .55,
            roughness: .55,
            metalness: .15
          })
        );

        moonGroup.add(moonMesh);
        moonGroup.add(makeGlow('#ad8bff', size * 7, .4));

        const moon = {
          node,
          parent,
          group: moonGroup,
          mesh: moonMesh,
          orbitRadius,
          angle: (index / Math.max(parent.moons.length + 1, 1)) * Math.PI * 2,
          speed: .35 + index * .06
        };

        moonMesh.userData.body = moon;
        clickableMeshes.push(moonMesh);
        parent.moons.push(moon);
        moons.push(moon);

        const label = document.createElement('button');
        label.type = 'button';
        label.className = 'planet-label';
        label.innerHTML = '<strong></strong><small>ARCHIVE STORY</small>';
        label.querySelector('strong').textContent = node.title;
        label.addEventListener('click', () => selectNode(node, moon));
        labelsElement.appendChild(label);
        labelElements.set(node.id, label);
      }

      const selectNode = (node, body) => {
        selected = node;
        detailTitle.textContent = node.title;
        detailDescription.textContent = node.description || 'Explore this part of the Turath archive.';
        detailKicker.textContent = node.kind === 'article'
          ? 'ARCHIVE STORY'
          : node.kind === 'category'
            ? 'ARCHIVE WORLD'
            : 'TURATH DISCOVERY';

        if (node.url) {
          detailLink.href = node.url;
          detailLink.hidden = false;
          detailLink.textContent = node.url === '#about'
            ? 'DISCOVER TURATH ↗'
            : 'OPEN STORY ↗';
        } else {
          detailLink.hidden = true;
        }

        detail.classList.add('open');

        for (const [id, label] of labelElements) {
          label.classList.toggle('active', id === node.id);
        }

        coordinate.textContent = `SELECTED / ${node.title}`;
      };

      // Expose the selector to label callbacks created above.
      // It is assigned before any user interaction can occur.
      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();

      const resetView = () => {
        targetRotation.x = -.12;
        targetRotation.y = 0;
        cameraTarget = 49;
        selected = null;
        detail.classList.remove('open');
        coordinate.textContent = 'SYSTEM ONLINE';

        for (const label of labelElements.values()) {
          label.classList.remove('active');
        }
      };

      resetButton.addEventListener('click', resetView);
      root.querySelector('#detail-close').addEventListener('click', () => {
        detail.classList.remove('open');
        selected = null;
        for (const label of labelElements.values()) {
          label.classList.remove('active');
        }
        coordinate.textContent = 'SYSTEM ONLINE';
      });

      search.addEventListener('input', () => {
        const query = search.value.trim().toLowerCase();

        for (const node of archive) {
          const label = labelElements.get(node.id);
          if (!label) continue;

          const matches = !query ||
            node.title.toLowerCase().includes(query) ||
            (node.description || '').toLowerCase().includes(query);

          label.style.opacity = matches ? '' : '0';
          label.style.pointerEvents = matches ? 'auto' : 'none';
        }
      });

      const getBodyFromIntersection = (intersection) =>
        intersection.object.userData.body;

      const handlePointerDown = (event) => {
        isDragging = true;
        moved = false;
        pointerStart = { x: event.clientX, y: event.clientY };
      };

      const handlePointerMove = (event) => {
        if (!isDragging) return;

        const dx = event.clientX - pointerStart.x;
        const dy = event.clientY - pointerStart.y;

        if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;

        targetRotation.y += dx * .004;
        targetRotation.x += dy * .003;
        targetRotation.x = Math.max(-.8, Math.min(.8, targetRotation.x));

        pointerStart = { x: event.clientX, y: event.clientY };
      };

      const handlePointerUp = (event) => {
        if (!isDragging) return;
        isDragging = false;

        if (moved) return;

        const rect = canvas.getBoundingClientRect();
        pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

        raycaster.setFromCamera(pointer, camera);
        const intersections = raycaster.intersectObjects(clickableMeshes, false);

        if (intersections.length) {
          const body = getBodyFromIntersection(intersections[0]);
          selectNode(body.node, body);
        }
      };

      const handleWheel = (event) => {
        event.preventDefault();
        cameraTarget += event.deltaY * .025;
        cameraTarget = Math.max(12, Math.min(85, cameraTarget));
      };

      canvas.addEventListener('pointerdown', handlePointerDown);
      window.addEventListener('pointermove', handlePointerMove);
      window.addEventListener('pointerup', handlePointerUp);
      canvas.addEventListener('wheel', handleWheel, { passive: false });

      const resize = () => {
        if (!renderer || !stage.isConnected) return;
        const width = stage.clientWidth;
        const height = stage.clientHeight;
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      };

      resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(stage);

      const projected = new THREE.Vector3();

      const updateLabels = () => {
        for (const body of bodies) {
          const label = labelElements.get(body.node.id);
          if (!label) continue;

          body.group.getWorldPosition(projected);
          projected.project(camera);

          const visible =
            projected.z < 1 &&
            projected.z > -1 &&
            Math.abs(projected.x) < 1.15 &&
            Math.abs(projected.y) < 1.15;

          if (visible) {
            label.style.left = `${(projected.x * .5 + .5) * stage.clientWidth}px`;
            label.style.top = `${(-projected.y * .5 + .5) * stage.clientHeight}px`;
            label.classList.add('visible');
          } else {
            label.classList.remove('visible');
          }
        }

        for (const moon of moons) {
          const label = labelElements.get(moon.node.id);
          if (!label) continue;

          moon.group.getWorldPosition(projected);
          projected.project(camera);

          const visible =
            projected.z < 1 &&
            projected.z > -1 &&
            Math.abs(projected.x) < 1.05 &&
            Math.abs(projected.y) < 1.05 &&
            cameraDistance < 35;

          if (visible) {
            label.style.left = `${(projected.x * .5 + .5) * stage.clientWidth}px`;
            label.style.top = `${(-projected.y * .5 + .5) * stage.clientHeight}px`;
            label.classList.add('visible');
          } else {
            label.classList.remove('visible');
          }
        }
      };

      const animate = (time) => {
        if (cleanupDone) return;

        animationFrame = requestAnimationFrame(animate);

        const delta = Math.min((time - previousTime) / 1000 || 0, .05);
        previousTime = time;
        clock.elapsed += delta;

        rotation.x += (targetRotation.x - rotation.x) * .06;
        rotation.y += (targetRotation.y - rotation.y) * .06;

        universe.rotation.x = rotation.x;
        universe.rotation.y = rotation.y;

        cameraDistance += (cameraTarget - cameraDistance) * .07;
        camera.position.set(0, cameraDistance * .1, cameraDistance);
        camera.lookAt(0, 0, 0);

        centralSphere.rotation.y += delta * .12;
        centralGlow.material.opacity = .65 + Math.sin(clock.elapsed * 1.8) * .12;
        stars.rotation.y += delta * .003;
        nearStars.rotation.y -= delta * .005;

        for (const body of bodies) {
          body.angle += body.config.speed * delta;

          const radius = body.config.orbit;
          body.group.position.set(
            Math.cos(body.angle) * radius,
            Math.sin(body.angle * .7) * radius * .12,
            Math.sin(body.angle) * radius * .62
          );

          body.mesh.rotation.y += delta * .16;
          body.mesh.rotation.x += delta * .025;
        }

        for (const moon of moons) {
          moon.angle += moon.speed * delta;
          moon.group.position.set(
            Math.cos(moon.angle) * moon.orbitRadius,
            Math.sin(moon.angle * 1.4) * .45,
            Math.sin(moon.angle) * moon.orbitRadius
          );
        }

        updateLabels();
        renderer.render(scene, camera);
      };

      animationFrame = requestAnimationFrame(animate);

      loading.classList.add('finished');
      coordinate.textContent = 'SYSTEM ONLINE';

      const cleanup = () => {
        if (cleanupDone) return;
        cleanupDone = true;

        cancelAnimationFrame(animationFrame);
        resizeObserver?.disconnect();

        canvas.removeEventListener('pointerdown', handlePointerDown);
        window.removeEventListener('pointermove', handlePointerMove);
        window.removeEventListener('pointerup', handlePointerUp);
        canvas.removeEventListener('wheel', handleWheel);

        renderer?.dispose();
        scene.traverse((object) => {
          object.geometry?.dispose?.();

          if (object.material) {
            const materials = Array.isArray(object.material)
              ? object.material
              : [object.material];

            materials.forEach((material) => {
              for (const value of Object.values(material)) {
                if (value?.isTexture) value.dispose();
              }
              material.dispose?.();
            });
          }
        });
      };

      root.__turathCleanup = cleanup;

    } catch (error) {
      showFailure(error?.message || 'Unknown initialization error.');
    }
  };

  const cleanupCurrent = () => {
    const current = document.getElementById('turath-universe');
    if (current?.__turathCleanup) current.__turathCleanup();
  };

  document.addEventListener('astro:before-swap', cleanupCurrent);
  document.addEventListener('astro:page-load', initialize);

  initialize();
})();
</script>
