
---
const {
  acknowledgments,
  musicPosts = [],
  photographyPosts = [],
  latestArticle,
} = Astro.props;

const constellationData = [
  {
    id: 'turath',
    title: 'TURATH',
    description: 'An archive of culture, art, expression, and the people behind them.',
    kind: 'center',
    url: '',
    parent: '',
  },
  {
    id: 'acknowledgments',
    title: 'ACKNOWLEDGMENTS',
    description: 'A personal dedication to the people and memories that will forever be part of Turath.',
    kind: 'feature',
    url: acknowledgments ? `/blog/${acknowledgments.slug}/` : '',
    parent: '',
  },
  {
    id: 'music',
    title: 'MUSIC',
    description: 'Artists, sounds, perspectives, and the stories behind the music.',
    kind: 'category',
    url: '',
    parent: '',
  },
  {
    id: 'photography',
    title: 'PHOTOGRAPHY',
    description: 'Stories told through images and the people behind the lens.',
    kind: 'category',
    url: '',
    parent: '',
  },
  {
    id: 'about',
    title: 'ABOUT TURATH',
    description: 'The meaning, origins, and story behind Turath.',
    kind: 'about',
    url: '#about',
    parent: '',
  },
  ...(latestArticle
    ? [{
        id: 'latest',
        title: 'LATEST ARTICLE',
        description: latestArticle.data.title,
        kind: 'feature',
        url: `/blog/${latestArticle.slug}/`,
        parent: '',
      }]
    : []),
  ...musicPosts.map((post, index) => ({
    id: `music-${index}`,
    title: post.data.title,
    description: post.data.description || 'Explore this story from the Turath music archive.',
    kind: 'article',
    url: `/blog/${post.slug}/`,
    parent: 'music',
  })),
  ...photographyPosts.map((post, index) => ({
    id: `photography-${index}`,
    title: post.data.title,
    description: post.data.description || 'Explore this story from the Turath photography archive.',
    kind: 'article',
    url: `/blog/${post.slug}/`,
    parent: 'photography',
  })),
];
---

<section class="turath-universe" aria-label="Explore the Turath universe">
  <div class="universe-canvas" id="universe-canvas"></div>

  <div class="universe-heading">
    <span>AN INTERACTIVE ARCHIVE</span>
    <span>EXPLORE THE UNIVERSE OF TURATH</span>
  </div>

  <div class="universe-search">
    <span aria-hidden="true">⌕</span>
    <input
      id="universe-search-input"
      type="search"
      placeholder="Find an artist or story..."
      aria-label="Search the Turath universe"
    />
    <span id="universe-search-count"></span>
  </div>

  <div class="universe-loader" id="universe-loader">
    <div class="loader-orbit">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <p>INITIALIZING THE UNIVERSE</p>
    <span class="loader-subtitle">PREPARING THE TURATH ARCHIVE</span>
  </div>

  <div class="universe-fallback" id="universe-fallback" hidden>
    <p>THE ARCHIVE IS AVAILABLE</p>
    <div id="universe-fallback-links"></div>
  </div>

  <aside class="universe-detail" id="universe-detail" aria-live="polite">
    <button
      type="button"
      class="universe-close"
      id="universe-close"
      aria-label="Close details"
    >×</button>

    <p id="universe-detail-eyebrow">DISCOVER TURATH</p>
    <h2 id="universe-detail-title">A world of stories.</h2>
    <p id="universe-detail-description">
      Explore the people, artists, images, and stories connected through Turath.
    </p>
    <div id="universe-detail-links"></div>
    <a id="universe-detail-open" href="#" hidden>OPEN STORY ↗</a>
  </aside>

  <div class="universe-instructions">
    <span><i></i> DRAG TO ROTATE</span>
    <span><i></i> SCROLL TO ZOOM</span>
    <span><i></i> SELECT A PLANET</span>
  </div>

  <div class="universe-controls">
    <button type="button" id="universe-reset">RESET VIEW</button>
    <span>3D ARCHIVE · 001</span>
  </div>
</section>

<style is:global>
  .turath-universe {
    --universe-purple: #9b69ff;
    --universe-pink: #e4a5ff;
    --universe-blue: #8c9cff;

    position: relative;
    isolation: isolate;
    z-index: 3;
    width: 100%;
    height: min(850px, calc(100svh - 65px));
    min-height: 620px;
    overflow: hidden;
    color: white;
    background:
      radial-gradient(ellipse at 50% 48%, rgba(65, 25, 110, .24), transparent 53%),
      radial-gradient(ellipse at 15% 80%, rgba(45, 20, 100, .15), transparent 50%);
  }

  .universe-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
  }

  .universe-canvas:active {
    cursor: grabbing;
  }

  .universe-canvas canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .universe-heading {
    position: absolute;
    z-index: 3;
    top: 24px;
    left: 30px;
    right: 30px;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: .58rem;
    letter-spacing: .2em;
    opacity: .72;
    pointer-events: none;
  }

  .universe-search {
    position: absolute;
    z-index: 5;
    top: 58px;
    right: 30px;
    display: flex;
    align-items: center;
    gap: 9px;
    width: min(270px, 36vw);
    padding: 10px 14px;
    border: 1px solid rgba(190, 150, 255, .24);
    border-radius: 30px;
    background: rgba(13, 5, 29, .64);
    color: white;
    backdrop-filter: blur(18px);
  }

  .universe-search input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: white;
    font: inherit;
    font-size: .72rem;
  }

  .universe-search input::placeholder {
    color: rgba(255,255,255,.5);
  }

  #universe-search-count {
    white-space: nowrap;
    font-size: .58rem;
    color: #d2b8ff;
  }

  .universe-loader {
    position: absolute;
    z-index: 4;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 13px;
    background: rgba(12, 4, 28, .28);
    backdrop-filter: blur(5px);
    transition: opacity .6s ease, visibility .6s ease;
    pointer-events: none;
  }

  .universe-loader.is-hidden {
    opacity: 0;
    visibility: hidden;
  }

  .loader-orbit {
    position: relative;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(179, 131, 255, .22);
    border-radius: 50%;
    animation: universe-spin 3s linear infinite;
  }

  .loader-orbit::before,
  .loader-orbit::after {
    position: absolute;
    content: "";
    border: 1px solid rgba(180, 130, 255, .5);
    border-radius: 50%;
  }

  .loader-orbit::before {
    inset: 7px -8px;
    transform: rotate(55deg);
  }

  .loader-orbit::after {
    inset: -8px 7px;
    transform: rotate(-55deg);
  }

  .loader-orbit span {
    position: absolute;
    top: -3px;
    left: 20px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d4a8ff;
    box-shadow: 0 0 14px #a66cff;
  }

  .loader-orbit span:nth-child(2) {
    top: 35px;
    left: 0;
    background: #9a8cff;
  }

  .loader-orbit span:nth-child(3) {
    top: 15px;
    left: 40px;
    background: #e4a5ff;
  }

  .universe-loader p,
  .universe-fallback > p {
    margin: 8px 0 0;
    font-size: .65rem;
    letter-spacing: .22em;
  }

  .loader-subtitle {
    color: rgba(255,255,255,.5);
    font-size: .53rem;
    letter-spacing: .17em;
  }

  @keyframes universe-spin {
    to { transform: rotate(360deg); }
  }

  .universe-fallback {
    position: absolute;
    z-index: 2;
    inset: 120px 20px 90px;
    align-content: center;
    text-align: center;
  }

  .universe-fallback[hidden] {
    display: none;
  }

  #universe-fallback-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 22px;
  }

  #universe-fallback-links a {
    padding: 10px 15px;
    border: 1px solid rgba(190,150,255,.35);
    border-radius: 30px;
    color: white;
    font-size: .7rem;
    text-decoration: none;
    background: rgba(40,20,70,.5);
  }

  .universe-detail {
    position: absolute;
    z-index: 6;
    top: 50%;
    right: 30px;
    width: min(320px, calc(100% - 60px));
    max-height: 65%;
    overflow-y: auto;
    padding: 26px;
    border: 1px solid rgba(188,150,255,.28);
    border-radius: 13px;
    background: rgba(12, 5, 29, .82);
    color: white;
    backdrop-filter: blur(22px);
    box-shadow: 0 15px 70px rgba(0,0,0,.35), 0 0 35px rgba(112,63,190,.12);
    opacity: 0;
    visibility: hidden;
    transform: translate(15px, -45%);
    transition: opacity .3s ease, transform .3s ease, visibility .3s ease;
  }

  .universe-detail.is-open {
    opacity: 1;
    visibility: visible;
    transform: translate(0, -45%);
  }

  .universe-close {
    position: absolute;
    top: 9px;
    right: 13px;
    border: 0;
    background: transparent;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
  }

  #universe-detail-eyebrow {
    margin: 0 0 12px;
    color: #c6a1ff;
    font-size: .58rem;
    letter-spacing: .2em;
  }

  .universe-detail h2 {
    margin: 0 0 12px;
    font-size: 1.6rem;
    line-height: 1.15;
    letter-spacing: -.04em;
  }

  #universe-detail-description {
    margin: 0;
    color: rgba(255,255,255,.7);
    font-size: .82rem;
    line-height: 1.7;
  }

  #universe-detail-links {
    display: grid;
    gap: 8px;
    margin-top: 17px;
  }

  #universe-detail-links a {
    padding: 9px 0;
    border-bottom: 1px solid rgba(255,255,255,.13);
    color: white;
    font-size: .75rem;
    text-decoration: none;
  }

  #universe-detail-links a:hover {
    color: #d2b4ff;
  }

  #universe-detail-open {
    display: inline-block;
    margin-top: 18px;
    color: #d2b4ff;
    font-size: .67rem;
    letter-spacing: .14em;
    text-decoration: none;
  }

  #universe-detail-open[hidden] {
    display: none;
  }

  .universe-instructions {
    position: absolute;
    z-index: 3;
    bottom: 25px;
    left: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-size: .55rem;
    letter-spacing: .13em;
    opacity: .72;
    pointer-events: none;
  }

  .universe-instructions span {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .universe-instructions i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #bd8aff;
    box-shadow: 0 0 8px #9b69ff;
  }

  .universe-controls {
    position: absolute;
    z-index: 4;
    right: 30px;
    bottom: 22px;
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: .56rem;
    letter-spacing: .13em;
    opacity: .75;
  }

  .universe-controls button {
    padding: 8px 12px;
    border: 1px solid rgba(190,150,255,.28);
    border-radius: 25px;
    background: rgba(20,8,40,.55);
    color: white;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  @media (max-width: 650px) {
    .turath-universe {
      height: 690px;
      min-height: 620px;
    }

    .universe-heading {
      top: 17px;
      left: 15px;
      right: 15px;
      font-size: .46rem;
      letter-spacing: .1em;
    }

    .universe-heading span:last-child {
      text-align: right;
    }

    .universe-search {
      top: 48px;
      right: 15px;
      width: min(240px, calc(100% - 30px));
    }

    .universe-detail {
      top: auto;
      right: 12px;
      bottom: 65px;
      left: 12px;
      width: auto;
      max-height: 43%;
      transform: translateY(12px);
    }

    .universe-detail.is-open {
      transform: translateY(0);
    }

    .universe-instructions {
      bottom: 18px;
      left: 12px;
      gap: 8px;
      font-size: .43rem;
    }

    .universe-instructions span {
      gap: 4px;
    }

    .universe-controls {
      right: 12px;
      bottom: 14px;
      font-size: .45rem;
    }

    .universe-controls span {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader-orbit {
      animation: none;
    }
  }
</style>

<script is:inline type="module" define:vars={{ constellationData }}>
  let activeCleanup = null;

  async function initializeUniverse() {
    const section = document.querySelector('.turath-universe');
    if (!section || section.dataset.initialized === 'true') return;

    section.dataset.initialized = 'true';

    const canvasHost = section.querySelector('#universe-canvas');
    const loader = section.querySelector('#universe-loader');
    const fallback = section.querySelector('#universe-fallback');
    const fallbackLinks = section.querySelector('#universe-fallback-links');
    const search = section.querySelector('#universe-search-input');
    const searchCount = section.querySelector('#universe-search-count');
    const detail = section.querySelector('#universe-detail');
    const detailTitle = section.querySelector('#universe-detail-title');
    const detailDescription = section.querySelector('#universe-detail-description');
    const detailEyebrow = section.querySelector('#universe-detail-eyebrow');
    const detailLinks = section.querySelector('#universe-detail-links');
    const detailOpen = section.querySelector('#universe-detail-open');

    const hideLoader = () => loader?.classList.add('is-hidden');

    const showFallback = () => {
      hideLoader();
      if (fallback) fallback.hidden = false;

      if (fallbackLinks) {
        fallbackLinks.replaceChildren();

        constellationData.forEach((item) => {
          if (!item.url) return;
          const link = document.createElement('a');
          link.href = item.url;
          link.textContent = item.title;
          fallbackLinks.appendChild(link);
        });
      }
    };

    const timeout = new Promise((_, reject) => {
      window.setTimeout(() => reject(new Error('3D engine loading timeout')), 12000);
    });

    try {
      const THREE = await Promise.race([
        import('https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js'),
        timeout,
      ]);

      if (!section.isConnected) return;

      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x10051f, 0.009);

      const camera = new THREE.PerspectiveCamera(
        48,
        canvasHost.clientWidth / canvasHost.clientHeight,
        0.1,
        250
      );

      camera.position.set(0, 1, 39);

      const renderer = new THREE.WebGLRenderer({
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance',
      });

      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.7));
      renderer.setSize(canvasHost.clientWidth, canvasHost.clientHeight);
      renderer.setClearColor(0x000000, 0);
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.25;

      canvasHost.replaceChildren(renderer.domElement);

      const universe = new THREE.Group();
      scene.add(universe);

      const raycaster = new THREE.Raycaster();
      raycaster.params.Points.threshold = 0.25;

      const pointer = new THREE.Vector2();
      const clickable = [];
      const nodeObjects = new Map();
      const satelliteGroups = [];

      let animationFrame = 0;
      let dragging = false;
      let moved = false;
      let previousX = 0;
      let previousY = 0;
      let velocityX = 0;
      let velocityY = 0;
      let selectedId = null;
      let disposed = false;

      const random = (min, max) => Math.random() * (max - min) + min;

      const createGlowTexture = () => {
        const canvas = document.createElement('canvas');
        canvas.width = 256;
        canvas.height = 256;

        const ctx = canvas.getContext('2d');
        const gradient = ctx.createRadialGradient(128, 128, 0, 128, 128, 128);

        gradient.addColorStop(0, 'rgba(255,255,255,1)');
        gradient.addColorStop(.12, 'rgba(205,160,255,.8)');
        gradient.addColorStop(.35, 'rgba(132,75,255,.28)');
        gradient.addColorStop(1, 'rgba(70,30,150,0)');

        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, 256, 256);

        return new THREE.CanvasTexture(canvas);
      };

      const glowTexture = createGlowTexture();

      const createGlow = (color, size, opacity = .5) => {
        const material = new THREE.SpriteMaterial({
          map: glowTexture,
          color,
          transparent: true,
          opacity,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
        });

        const sprite = new THREE.Sprite(material);
        sprite.scale.set(size, size, 1);
        return sprite;
      };

      const createLabel = (text, color = '#ffffff', size = 48) => {
        const canvas = document.createElement('canvas');
        canvas.width = 1024;
        canvas.height = 160;

        const ctx = canvas.getContext('2d');
        ctx.font = `600 ${size}px Arial, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.shadowColor = color;
        ctx.shadowBlur = 18;
        ctx.fillStyle = color;
        ctx.fillText(text.toUpperCase(), 512, 80);

        const texture = new THREE.CanvasTexture(canvas);
        texture.colorSpace = THREE.SRGBColorSpace;

        const sprite = new THREE.Sprite(
          new THREE.SpriteMaterial({
            map: texture,
            transparent: true,
            depthWrite: false,
          })
        );

        sprite.scale.set(5.5, .86, 1);
        return sprite;
      };

      const ambient = new THREE.AmbientLight(0x8b6bb8, 1.3);
      scene.add(ambient);

      const centralLight = new THREE.PointLight(0xc69aff, 170, 75, 1.7);
      centralLight.position.set(0, 0, 0);
      scene.add(centralLight);

      const blueLight = new THREE.PointLight(0x617cff, 75, 55, 2);
      blueLight.position.set(-15, 9, -8);
      scene.add(blueLight);

      const pinkLight = new THREE.PointLight(0xe19aff, 65, 50, 2);
      pinkLight.position.set(15, -9, 7);
      scene.add(pinkLight);

      // Nebula clouds.
      const nebulaColors = [0x5923a8, 0x8a39cb, 0x312f9c, 0x9b4cae, 0x4a277e];

      for (let i = 0; i < 13; i++) {
        const nebula = createGlow(
          nebulaColors[i % nebulaColors.length],
          random(10, 23),
          random(.09, .2)
        );

        nebula.position.set(
          random(-23, 23),
          random(-15, 15),
          random(-20, -5)
        );

        universe.add(nebula);
      }

      // Distant starfield.
      const starPositions = [];
      const starColors = [];
      const starCount = 2600;

      const palette = [
        new THREE.Color(0xffffff),
        new THREE.Color(0xc8a5ff),
        new THREE.Color(0x8caaff),
        new THREE.Color(0xf2c8ff),
      ];

      for (let i = 0; i < starCount; i++) {
        const radius = random(24, 95);
        const theta = random(0, Math.PI * 2);
        const phi = Math.acos(random(-1, 1));

        starPositions.push(
          radius * Math.sin(phi) * Math.cos(theta),
          radius * Math.sin(phi) * Math.sin(theta),
          radius * Math.cos(phi)
        );

        const color = palette[Math.floor(Math.random() * palette.length)];
        starColors.push(color.r, color.g, color.b);
      }

      const starGeometry = new THREE.BufferGeometry();
      starGeometry.setAttribute(
        'position',
        new THREE.Float32BufferAttribute(starPositions, 3)
      );
      starGeometry.setAttribute(
        'color',
        new THREE.Float32BufferAttribute(starColors, 3)
      );

      const starMaterial = new THREE.PointsMaterial({
        size: .12,
        vertexColors: true,
        transparent: true,
        opacity: .92,
        sizeAttenuation: true,
        depthWrite: false,
      });

      const stars = new THREE.Points(starGeometry, starMaterial);
      universe.add(stars);

      // Smaller foreground particles.
      const dustPositions = [];

      for (let i = 0; i < 650; i++) {
        dustPositions.push(
          random(-25, 25),
          random(-17, 17),
          random(-12, 12)
        );
      }

      const dustGeometry = new THREE.BufferGeometry();
      dustGeometry.setAttribute(
        'position',
        new THREE.Float32BufferAttribute(dustPositions, 3)
      );

      const dust = new THREE.Points(
        dustGeometry,
        new THREE.PointsMaterial({
          color: 0xc5a0ff,
          size: .045,
          transparent: true,
          opacity: .65,
          depthWrite: false,
        })
      );

      universe.add(dust);

      // Main orbital system.
      const center = new THREE.Group();
      universe.add(center);

      // Central Turath star.
      const sun = new THREE.Mesh(
        new THREE.SphereGeometry(1.75, 64, 64),
        new THREE.MeshStandardMaterial({
          color: 0xe8d5ff,
          emissive: 0x9b55ff,
          emissiveIntensity: 2.4,
          roughness: .24,
          metalness: .12,
        })
      );

      center.add(sun);
      sun.add(createGlow(0x9e54ff, 9, .85));
      sun.add(createGlow(0xd7aaff, 5, .75));

      const sunLabel = createLabel('TURATH', '#e7d6ff', 66);
      sunLabel.position.set(0, -3.2, 0);
      center.add(sunLabel);

      const createOrbit = (radius, color = 0x8e65d6, opacity = .25, parent = universe) => {
        const points = [];

        for (let i = 0; i <= 180; i++) {
          const angle = (i / 180) * Math.PI * 2;
          points.push(
            new THREE.Vector3(
              Math.cos(angle) * radius,
              Math.sin(angle) * radius,
              0
            )
          );
        }

        const geometry = new THREE.BufferGeometry().setFromPoints(points);
        const line = new THREE.LineLoop(
          geometry,
          new THREE.LineBasicMaterial({
            color,
            transparent: true,
            opacity,
            depthWrite: false,
          })
        );

        parent.add(line);
        return line;
      };

      createOrbit(8.5, 0x9d70db, .19);
      createOrbit(13, 0x9d70db, .16);
      createOrbit(18, 0x9d70db, .12);
      createOrbit(23, 0x9d70db, .09);

      const planetConfigs = {
        acknowledgments: {
          position: [0, 10, -1],
          radius: 1.05,
          color: 0xe0aaff,
          emissive: 0x8e36bd,
          glow: 0xc57cff,
        },
        music: {
          position: [12, 2, 0],
          radius: 1.5,
          color: 0x9671ff,
          emissive: 0x392078,
          glow: 0x9b69ff,
          ring: true,
        },
        photography: {
          position: [-12, 2, -1],
          radius: 1.35,
          color: 0x83aaff,
          emissive: 0x203b91,
          glow: 0x779dff,
          ring: true,
        },
        about: {
          position: [0, -11, 1],
          radius: 1.05,
          color: 0xc4a0e8,
          emissive: 0x643e91,
          glow: 0xc59aff,
        },
        latest: {
          position: [0, 0, -16],
          radius: .9,
          color: 0xffc5ed,
          emissive: 0x8b387e,
          glow: 0xff9ce6,
        },
      };

      const makePlanet = (config, node) => {
        const group = new THREE.Group();

        group.position.set(...config.position);
        universe.add(group);

        const geometry = new THREE.SphereGeometry(config.radius, 48, 48);

        const material = new THREE.MeshStandardMaterial({
          color: config.color,
          emissive: config.emissive,
          emissiveIntensity: .65,
          roughness: .65,
          metalness: .18,
        });

        const planet = new THREE.Mesh(geometry, material);
        group.add(planet);

        const atmosphere = new THREE.Mesh(
          new THREE.SphereGeometry(config.radius * 1.12, 48, 48),
          new THREE.MeshBasicMaterial({
            color: config.glow,
            transparent: true,
            opacity: .11,
            side: THREE.BackSide,
          })
        );

        group.add(atmosphere);
        group.add(createGlow(config.glow, config.radius * 5.5, .45));

        if (config.ring) {
          const ring = new THREE.Mesh(
            new THREE.RingGeometry(config.radius * 1.45, config.radius * 2.05, 96),
            new THREE.MeshBasicMaterial({
              color: config.glow,
              side: THREE.DoubleSide,
              transparent: true,
              opacity: .42,
            })
          );

          ring.rotation.x = Math.PI * .34;
          ring.rotation.y = .22;
          group.add(ring);
        }

        const label = createLabel(node.title, '#eee0ff', 43);
        label.position.y = -config.radius - .95;
        group.add(label);

        planet.userData.node = node;
        clickable.push(planet);
        nodeObjects.set(node.id, { group, planet, label });

        return group;
      };

      const nodesById = new Map(constellationData.map((node) => [node.id, node]));

      Object.entries(planetConfigs).forEach(([id, config]) => {
        const node = nodesById.get(id);
        if (node) makePlanet(config, node);
      });

      // Article satellites orbit their category planets.
      const addSatellites = (parentId, color) => {
        const parent = nodeObjects.get(parentId);
        if (!parent) return;

        const articles = constellationData.filter((node) => node.parent === parentId);
        if (!articles.length) return;

        const orbitGroup = new THREE.Group();
        parent.group.add(orbitGroup);

        const orbitRadius = 3.1;

        const orbitPoints = [];

        for (let i = 0; i <= 120; i++) {
          const angle = (i / 120) * Math.PI * 2;
          orbitPoints.push(
            new THREE.Vector3(
              Math.cos(angle) * orbitRadius,
              Math.sin(angle) * orbitRadius * .72,
              0
            )
          );
        }

        const orbitLine = new THREE.LineLoop(
          new THREE.BufferGeometry().setFromPoints(orbitPoints),
          new THREE.LineBasicMaterial({
            color,
            transparent: true,
            opacity: .28,
          })
        );

        orbitGroup.add(orbitLine);

        articles.forEach((node, index) => {
          const angle = (index / articles.length) * Math.PI * 2;
          const moonGroup = new THREE.Group();

          moonGroup.position.set(
            Math.cos(angle) * orbitRadius,
            Math.sin(angle) * orbitRadius * .72,
            random(-.35, .35)
          );

          orbitGroup.add(moonGroup);

          const moon = new THREE.Mesh(
            new THREE.SphereGeometry(.27, 24, 24),
            new THREE.MeshStandardMaterial({
              color,
              emissive: color,
              emissiveIntensity: 1.5,
              roughness: .4,
            })
          );

          moonGroup.add(moon);
          moon.add(createGlow(color, 1.45, .7));

          const label = createLabel(node.title, '#ffffff', 29);
          label.position.y = -.68;
          label.scale.set(4.4, .58, 1);
          moonGroup.add(label);

          moon.userData.node = node;
          clickable.push(moon);
          nodeObjects.set(node.id, { group: moonGroup, planet: moon, label });

          satelliteGroups.push({
            group: orbitGroup,
            speed: parentId === 'music' ? .055 : -.045,
          });
        });
      };

      addSatellites('music', 0xb68aff);
      addSatellites('photography', 0x8daaff);

      // Extra small moons and distant orbiting objects.
      for (let i = 0; i < 24; i++) {
        const orbit = new THREE.Group();
        orbit.position.set(0, 0, random(-8, 8));

        const radius = random(8, 21);
        const angle = random(0, Math.PI * 2);

        const moon = new THREE.Mesh(
          new THREE.SphereGeometry(random(.025, .09), 8, 8),
          new THREE.MeshBasicMaterial({
            color: palette[Math.floor(Math.random() * palette.length)],
          })
        );

        moon.position.set(Math.cos(angle) * radius, Math.sin(angle) * radius, 0);
        orbit.add(moon);
        universe.add(orbit);

        satelliteGroups.push({
          group: orbit,
          speed: random(-.12, .12),
        });
      }

      // Shooting star streaks.
      const shootingStars = [];

      for (let i = 0; i < 4; i++) {
        const geometry = new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(0, 0, 0),
          new THREE.Vector3(-1.8, .35, 0),
        ]);

        const streak = new THREE.Line(
          geometry,
          new THREE.LineBasicMaterial({
            color: 0xd6b5ff,
            transparent: true,
            opacity: 0,
          })
        );

        streak.position.set(random(-20, 20), random(-12, 12), random(-8, 8));
        universe.add(streak);

        shootingStars.push({
          object: streak,
          timer: random(1, 8),
          velocity: new THREE.Vector3(random(-.16, -.08), random(-.06, -.02), 0),
        });
      }

      const openNode = (node) => {
        if (!node) return;

        if (node.kind === 'about') {
          document.querySelector('#about')?.scrollIntoView({
            behavior: 'smooth',
            block: 'start',
          });
          return;
        }

        if (node.url && node.kind !== 'category' && node.kind !== 'center') {
          window.location.href = node.url;
          return;
        }

        selectedId = node.id;

        detailTitle.textContent = node.title;
        detailDescription.textContent = node.description;
        detailEyebrow.textContent =
          node.kind === 'center' ? 'THE ARCHIVE' : 'EXPLORE THE COLLECTION';

        detailLinks.replaceChildren();
        detailOpen.hidden = true;

        if (node.kind === 'category') {
          const children = constellationData.filter((item) => item.parent === node.id);

          children.forEach((child) => {
            const link = document.createElement('a');
            link.href = child.url || '#';
            link.textContent = `${child.title} ↗`;
            detailLinks.appendChild(link);
          });

          if (!children.length) {
            const empty = document.createElement('p');
            empty.textContent = 'More stories coming soon.';
            empty.style.color = 'rgba(255,255,255,.6)';
            empty.style.fontSize = '.8rem';
            detailLinks.appendChild(empty);
          }
        }

        if (node.kind === 'center') {
          const link = document.createElement('a');
          link.href = '#about';
          link.textContent = 'Discover the story behind Turath ↗';
          link.addEventListener('click', (event) => {
            event.preventDefault();
            document.querySelector('#about')?.scrollIntoView({ behavior: 'smooth' });
          });
          detailLinks.appendChild(link);
        }

        detail.classList.add('is-open');
      };

      const closePanel = () => {
        detail.classList.remove('is-open');
        selectedId = null;
      };

      section.querySelector('#universe-close')?.addEventListener('click', closePanel);

      // Pointer and raycasting.
      const updatePointer = (event) => {
        const rect = renderer.domElement.getBoundingClientRect();

        pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
      };

      renderer.domElement.addEventListener('pointerdown', (event) => {
        dragging = true;
        moved = false;
        previousX = event.clientX;
        previousY = event.clientY;
        renderer.domElement.setPointerCapture(event.pointerId);
      });

      renderer.domElement.addEventListener('pointermove', (event) => {
        if (!dragging) return;

        const dx = event.clientX - previousX;
        const dy = event.clientY - previousY;

        if (Math.abs(dx) + Math.abs(dy) > 2) moved = true;

        velocityY = dx * .003;
        velocityX = dy * .003;

        universe.rotation.y += velocityY;
        universe.rotation.x += velocityX;

        previousX = event.clientX;
        previousY = event.clientY;
      });

      const stopDragging = () => {
        dragging = false;
      };

      renderer.domElement.addEventListener('pointerup', stopDragging);
      renderer.domElement.addEventListener('pointercancel', stopDragging);

      renderer.domElement.addEventListener('click', (event) => {
        if (moved) {
          moved = false;
          return;
        }

        updatePointer(event);
        raycaster.setFromCamera(pointer, camera);

        const hits = raycaster.intersectObjects(clickable, false);

        if (hits.length) {
          openNode(hits[0].object.userData.node);
        }
      });

      renderer.domElement.addEventListener('wheel', (event) => {
        event.preventDefault();
        camera.position.z = THREE.MathUtils.clamp(
          camera.position.z + event.deltaY * .018,
          19,
          65
        );
      }, { passive: false });

      // Search across planets and article satellites.
      search?.addEventListener('input', () => {
        const query = search.value.trim().toLowerCase();
        let matches = 0;

        constellationData.forEach((node) => {
          const match =
            node.title.toLowerCase().includes(query) ||
            node.description.toLowerCase().includes(query);

          if (!query || match) matches++;

          const object = nodeObjects.get(node.id);
          if (object) {
            object.planet.material.transparent = Boolean(query && !match);
            object.planet.material.opacity = query && !match ? .13 : 1;

            if (object.label) {
              object.label.material.opacity = query && !match ? .12 : 1;
            }
          }
        });

        if (searchCount) {
          searchCount.textContent = query ? `${matches} FOUND` : '';
        }
      });

      section.querySelector('#universe-reset')?.addEventListener('click', () => {
        universe.rotation.set(0, 0, 0);
        camera.position.set(0, 1, 39);
        if (search) {
          search.value = '';
          search.dispatchEvent(new Event('input'));
        }
        closePanel();
      });

      const resize = () => {
        if (!section.isConnected) return;

        const width = canvasHost.clientWidth;
        const height = canvasHost.clientHeight;

        if (!width || !height) return;

        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.7));
      };

      window.addEventListener('resize', resize);

      const clock = new THREE.Clock();

      const animate = () => {
        if (disposed || !section.isConnected) return;

        animationFrame = requestAnimationFrame(animate);

        const elapsed = clock.getElapsedTime();
        const delta = Math.min(clock.getDelta(), .05);

        stars.rotation.y += delta * .003;
        stars.rotation.x += delta * .001;
        dust.rotation.y -= delta * .008;

        sun.rotation.y += delta * .1;
        sun.rotation.x += delta * .025;

        centralLight.intensity = 155 + Math.sin(elapsed * 1.4) * 15;

        satelliteGroups.forEach((item) => {
          item.group.rotation.z += delta * item.speed;
        });

        universe.rotation.y += dragging ? 0 : velocityY * .12;
        universe.rotation.x += dragging ? 0 : velocityX * .12;

        if (!dragging) {
          velocityX *= .96;
          velocityY *= .96;
        }

        shootingStars.forEach((item) => {
          item.timer -= delta;

          if (item.timer <= 0) {
            item.object.position.set(random(-22, 22), random(-13, 13), random(-10, 10));
            item.timer = random(5, 12);
            item.object.material.opacity = .9;
          }

          if (item.object.material.opacity > 0) {
            item.object.position.addScaledVector(item.velocity, delta * 12);
            item.object.material.opacity -= delta * .4;
          }
        });

        renderer.render(scene, camera);
      };

      hideLoader();
      animate();

      activeCleanup = () => {
        disposed = true;
        cancelAnimationFrame(animationFrame);
        window.removeEventListener('resize', resize);

        renderer.dispose();
        starGeometry.dispose();
        starMaterial.dispose();
        dustGeometry.dispose();
        glowTexture.dispose();

        scene.traverse((object) => {
          if (object.geometry) object.geometry.dispose();

          if (object.material) {
            const materials = Array.isArray(object.material)
              ? object.material
              : [object.material];

            materials.forEach((material) => {
              if (material.map && material.map !== glowTexture) {
                material.map.dispose();
              }
              material.dispose();
            });
          }
        });

        renderer.domElement.remove();
      };

    } catch (error) {
      console.error('Turath universe could not initialize:', error);
      showFallback();
    }
  }

  document.addEventListener('astro:page-load', initializeUniverse);
  document.addEventListener('astro:before-swap', () => {
    if (activeCleanup) {
      activeCleanup();
      activeCleanup = null;
    }
  });

  initializeUniverse();
</script>
