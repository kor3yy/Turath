
---
const {
  acknowledgments,
  musicPosts = [],
  photographyPosts = [],
  latestArticle,
} = Astro.props;

const constellationData = {
  categories: [
    {
      id: 'acknowledgments',
      title: 'ACKNOWLEDGMENTS',
      description: 'A personal dedication to the people and memories that will forever be part of Turath.',
      url: acknowledgments ? `/blog/${acknowledgments.slug}/` : '',
      color: '#e7b96e',
      size: 1.75,
      orbit: 11,
      angle: 90,
      kind: 'feature',
    },
    {
      id: 'music',
      title: 'MUSIC',
      description: 'Artists, sounds, perspectives, and the stories behind the music.',
      color: '#8b65ff',
      size: 2.15,
      orbit: 16,
      angle: 25,
      kind: 'category',
    },
    {
      id: 'photography',
      title: 'PHOTOGRAPHY',
      description: 'Stories told through images and the people behind the lens.',
      color: '#54c9cf',
      size: 1.95,
      orbit: 16,
      angle: 155,
      kind: 'category',
    },
    {
      id: 'about',
      title: 'ABOUT TURATH',
      description: 'The meaning, origins, and story behind Turath.',
      color: '#bd83ff',
      size: 1.7,
      orbit: 13,
      angle: 270,
      kind: 'about',
      url: '#about',
    },
    ...(latestArticle
      ? [{
          id: 'latest',
          title: 'LATEST ARTICLE',
          description: latestArticle.data.title,
          url: `/blog/${latestArticle.slug}/`,
          color: '#d78aff',
          size: 1.55,
          orbit: 12,
          angle: 320,
          kind: 'feature',
        }]
      : []),
  ],
  articles: [
    ...musicPosts.map((post, index) => ({
      id: `music-${index}`,
      title: post.data.title,
      description: post.data.description || '',
      url: `/blog/${post.slug}/`,
      parent: 'music',
    })),
    ...photographyPosts.map((post, index) => ({
      id: `photography-${index}`,
      title: post.data.title,
      description: post.data.description || '',
      url: `/blog/${post.slug}/`,
      parent: 'photography',
    })),
  ],
};
---

<section class="turath-universe" aria-label="Explore the Turath universe">
  <canvas
    id="turath-universe-canvas"
    aria-label="Interactive three-dimensional universe. Drag to rotate, scroll to zoom, and select planets to explore."
  ></canvas>

  <div class="universe-vignette"></div>

  <header class="universe-heading">
    <div>
      <span class="universe-overline">TURATH / ARCHIVE 001</span>
      <p>AN UNIVERSE OF CULTURE, ART & EXPRESSION</p>
    </div>
    <span class="universe-coordinate">INTERACTIVE COSMOS</span>
  </header>

  <div class="universe-search">
    <span aria-hidden="true">⌕</span>
    <input
      type="search"
      id="universe-search-input"
      placeholder="Search artists, stories..."
      aria-label="Search the Turath universe"
    />
    <span id="universe-search-count"></span>
  </div>

  <div class="universe-loading" id="universe-loading">
    <span class="loading-orbit"></span>
    <p>INITIALIZING THE UNIVERSE</p>
  </div>

  <div class="universe-detail" id="universe-detail" aria-live="polite">
    <button
      type="button"
      class="universe-close"
      id="universe-close"
      aria-label="Close details"
    >×</button>
    <span class="detail-kicker" id="universe-detail-kicker">DISCOVER TURATH</span>
    <h2 id="universe-detail-title">A universe of stories.</h2>
    <p id="universe-detail-description">
      Explore the artists, people, images, and stories connected through Turath.
    </p>
    <div class="universe-detail-links" id="universe-detail-links"></div>
    <a href="#" id="universe-detail-open" hidden>EXPLORE STORY ↗</a>
  </div>

  <div class="universe-footer">
    <div class="universe-legend">
      <span><i class="legend-purple"></i> PLANETARY SYSTEMS</span>
      <span><i class="legend-white"></i> CELESTIAL OBJECTS</span>
    </div>
    <div class="universe-controls">
      <span>DRAG TO ROTATE</span>
      <span>SCROLL TO ZOOM</span>
      <button type="button" id="universe-reset">RESET VIEW ↺</button>
    </div>
  </div>
</section>

<style is:global>
  .turath-universe {
    position: relative;
    z-index: 3;
    width: 100%;
    height: min(900px, calc(100svh - 50px));
    min-height: 650px;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 50% 48%, rgb(65 25 115 / 20%), transparent 58%),
      radial-gradient(ellipse at 50% 50%, rgb(0 0 0 / 4%), transparent 80%);
    color: #fff;
  }

  #turath-universe-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    outline: none;
    touch-action: none;
    cursor: grab;
  }

  #turath-universe-canvas.is-dragging {
    cursor: grabbing;
  }

  .universe-vignette {
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at center, transparent 40%, rgb(7 2 17 / 28%) 100%),
      linear-gradient(180deg, rgb(5 2 15 / 35%), transparent 22%, transparent 75%, rgb(5 2 15 / 38%));
  }

  .universe-heading {
    position: absolute;
    z-index: 4;
    top: 25px;
    left: 32px;
    right: 32px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    pointer-events: none;
  }

  .universe-overline,
  .universe-coordinate {
    color: rgb(222 203 255 / 75%);
    font-size: 0.58rem;
    letter-spacing: 0.22em;
  }

  .universe-heading p {
    margin: 8px 0 0;
    color: rgb(255 255 255 / 78%);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
  }

  .universe-search {
    position: absolute;
    z-index: 5;
    top: 83px;
    right: 32px;
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(280px, 38vw);
    padding: 11px 15px;
    border: 1px solid rgb(191 158 255 / 30%);
    border-radius: 30px;
    background: rgb(16 7 32 / 65%);
    color: white;
    backdrop-filter: blur(18px);
    box-shadow: 0 0 25px rgb(119 57 211 / 9%);
  }

  .universe-search input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: white;
    font: inherit;
    font-size: 0.73rem;
  }

  .universe-search input::placeholder {
    color: rgb(226 211 255 / 55%);
  }

  #universe-search-count {
    flex-shrink: 0;
    color: #c4a1ff;
    font-size: 0.58rem;
  }

  .universe-loading {
    position: absolute;
    z-index: 6;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    background: rgb(8 3 20 / 70%);
    color: #d9c2ff;
    transition: opacity 500ms ease, visibility 500ms ease;
  }

  .universe-loading.is-ready {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .universe-loading p {
    font-size: 0.58rem;
    letter-spacing: 0.25em;
  }

  .loading-orbit {
    width: 35px;
    height: 35px;
    border: 1px solid rgb(190 145 255 / 20%);
    border-top-color: #c59aff;
    border-radius: 50%;
    animation: universe-loading-spin 1s linear infinite;
    box-shadow: 0 0 20px rgb(154 94 255 / 35%);
  }

  @keyframes universe-loading-spin {
    to { transform: rotate(360deg); }
  }

  .universe-detail {
    position: absolute;
    z-index: 7;
    top: 50%;
    right: 32px;
    width: min(340px, calc(100% - 40px));
    max-height: 60%;
    overflow-y: auto;
    padding: 27px;
    border: 1px solid rgb(193 159 255 / 28%);
    border-radius: 15px;
    background: rgb(12 5 27 / 85%);
    color: white;
    backdrop-filter: blur(25px);
    box-shadow:
      0 15px 70px rgb(0 0 0 / 40%),
      0 0 35px rgb(111 54 201 / 12%);
    opacity: 0;
    visibility: hidden;
    transform: translate(18px, -45%);
    transition:
      opacity 300ms ease,
      transform 300ms ease,
      visibility 300ms ease;
  }

  .universe-detail.is-open {
    opacity: 1;
    visibility: visible;
    transform: translate(0, -45%);
  }

  .universe-close {
    position: absolute;
    top: 9px;
    right: 13px;
    border: 0;
    background: none;
    color: #d8c2ff;
    font-size: 1.6rem;
    cursor: pointer;
  }

  .detail-kicker {
    color: #bd94ff;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
  }

  .universe-detail h2 {
    margin: 13px 0 10px;
    font-size: 1.8rem;
    line-height: 1.1;
    letter-spacing: -0.045em;
  }

  .universe-detail > p {
    margin: 0;
    color: rgb(236 225 255 / 72%);
    font-size: 0.83rem;
    line-height: 1.7;
  }

  .universe-detail-links {
    display: grid;
    gap: 8px;
    margin-top: 18px;
  }

  .universe-detail-links a {
    padding: 10px 0;
    border-bottom: 1px solid rgb(255 255 255 / 12%);
    color: #e7d8ff;
    font-size: 0.77rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 200ms ease, padding 200ms ease;
  }

  .universe-detail-links a:hover {
    padding-left: 5px;
    color: #c99cff;
  }

  #universe-detail-open {
    display: inline-block;
    margin-top: 20px;
    color: #c99cff;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-decoration: none;
  }

  #universe-detail-open[hidden] {
    display: none;
  }

  .universe-footer {
    position: absolute;
    z-index: 4;
    right: 32px;
    bottom: 25px;
    left: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    pointer-events: none;
  }

  .universe-legend,
  .universe-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    color: rgb(233 219 255 / 70%);
    font-size: 0.53rem;
    letter-spacing: 0.13em;
  }

  .universe-legend span {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .universe-legend i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .legend-purple {
    background: #a77aff;
    box-shadow: 0 0 9px #a77aff;
  }

  .legend-white {
    background: #fff;
    box-shadow: 0 0 9px #fff;
  }

  .universe-controls {
    pointer-events: auto;
  }

  .universe-controls button {
    padding: 8px 12px;
    border: 1px solid rgb(190 155 255 / 30%);
    border-radius: 20px;
    background: rgb(20 8 39 / 65%);
    color: #e8d9ff;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
    transition: background 200ms ease, border-color 200ms ease;
  }

  .universe-controls button:hover {
    border-color: #b78bff;
    background: rgb(96 48 153 / 35%);
  }

  @media (max-width: 650px) {
    .turath-universe {
      height: 720px;
      min-height: 650px;
    }

    .universe-heading {
      top: 18px;
      left: 16px;
      right: 16px;
    }

    .universe-heading p {
      max-width: 220px;
      font-size: 0.55rem;
      line-height: 1.5;
    }

    .universe-coordinate {
      max-width: 90px;
      text-align: right;
      font-size: 0.48rem;
    }

    .universe-search {
      top: 85px;
      right: 16px;
      width: min(250px, calc(100% - 32px));
    }

    .universe-detail {
      top: auto;
      right: 12px;
      bottom: 72px;
      left: 12px;
      width: auto;
      max-height: 42%;
      padding: 22px;
      transform: translateY(15px);
    }

    .universe-detail.is-open {
      transform: translateY(0);
    }

    .universe-footer {
      right: 15px;
      bottom: 17px;
      left: 15px;
      align-items: flex-end;
    }

    .universe-legend {
      display: none;
    }

    .universe-controls {
      width: 100%;
      justify-content: space-between;
      gap: 7px;
      font-size: 0.46rem;
    }

    .universe-controls button {
      padding: 8px 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-orbit {
      animation: none;
    }
  }
</style>

<script is:inline type="module" define:vars={{ constellationData }}>
  const section = document.querySelector('.turath-universe');

  if (section && section.dataset.initialized !== 'true') {
    section.dataset.initialized = 'true';

    const canvas = section.querySelector('#turath-universe-canvas');
    const loading = section.querySelector('#universe-loading');
    const detail = section.querySelector('#universe-detail');
    const detailTitle = section.querySelector('#universe-detail-title');
    const detailDescription = section.querySelector('#universe-detail-description');
    const detailKicker = section.querySelector('#universe-detail-kicker');
    const detailLinks = section.querySelector('#universe-detail-links');
    const detailOpen = section.querySelector('#universe-detail-open');
    const search = section.querySelector('#universe-search-input');
    const searchCount = section.querySelector('#universe-search-count');

    let THREE;

    try {
      THREE = await import(
        'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js'
      );
    } catch (error) {
      console.error('Turath universe could not load Three.js:', error);
      loading.querySelector('p').textContent =
        'THE 3D UNIVERSE COULD NOT LOAD — PLEASE REFRESH';
      return;
    }

    if (!canvas || !THREE.WebGLRenderer) return;

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x090316, 0.0022);

    const camera = new THREE.PerspectiveCamera(
      48,
      canvas.clientWidth / canvas.clientHeight,
      0.1,
      500
    );

    camera.position.set(0, 1.5, 43);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });

    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.8));
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.35;

    const universe = new THREE.Group();
    scene.add(universe);

    const clock = new THREE.Clock();
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();

    const ambient = new THREE.AmbientLight(0x9a75ce, 1.1);
    scene.add(ambient);

    const centralLight = new THREE.PointLight(0xc18aff, 160, 90, 1.5);
    centralLight.position.set(0, 0, 0);
    scene.add(centralLight);

    const blueLight = new THREE.PointLight(0x455dff, 65, 65, 2);
    blueLight.position.set(-16, 9, -12);
    scene.add(blueLight);

    const pinkLight = new THREE.PointLight(0xff6acb, 55, 65, 2);
    pinkLight.position.set(13, -8, 9);
    scene.add(pinkLight);

    const selectable = [];
    const objects = new Map();
    const animatedGroups = [];
    const searchable = [];

    function seededRandom(seed) {
      let value = seed >>> 0;
      return () => {
        value = (value * 1664525 + 1013904223) >>> 0;
        return value / 4294967296;
      };
    }

    function makePlanetTexture(color, seed = 1) {
      const random = seededRandom(seed);
      const textureCanvas = document.createElement('canvas');
      textureCanvas.width = 512;
      textureCanvas.height = 256;

      const ctx = textureCanvas.getContext('2d');
      const gradient = ctx.createLinearGradient(0, 0, 512, 256);
      gradient.addColorStop(0, color);
      gradient.addColorStop(0.5, '#17102d');
      gradient.addColorStop(1, '#080611');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, 512, 256);

      for (let i = 0; i < 260; i++) {
        const x = random() * 512;
        const y = random() * 256;
        const radius = random() * 22 + 2;
        const alpha = random() * 0.15;

        ctx.beginPath();
        ctx.ellipse(x, y, radius * 2.5, radius * 0.45, random(), 0, Math.PI * 2);
        ctx.fillStyle = `rgba(210,180,255,${alpha})`;
        ctx.fill();
      }

      for (let i = 0; i < 70; i++) {
        const y = random() * 256;
        ctx.fillStyle = `rgba(255,255,255,${random() * 0.055})`;
        ctx.fillRect(0, y, 512, random() * 2 + 0.5);
      }

      const texture = new THREE.CanvasTexture(textureCanvas);
      texture.colorSpace = THREE.SRGBColorSpace;
      return texture;
    }

    function makeGlowTexture() {
      const glowCanvas = document.createElement('canvas');
      glowCanvas.width = 256;
      glowCanvas.height = 256;

      const ctx = glowCanvas.getContext('2d');
      const gradient = ctx.createRadialGradient(128, 128, 3, 128, 128, 128);

      gradient.addColorStop(0, 'rgba(255,255,255,1)');
      gradient.addColorStop(0.12, 'rgba(211,174,255,.8)');
      gradient.addColorStop(0.35, 'rgba(146,82,255,.28)');
      gradient.addColorStop(1, 'rgba(90,40,180,0)');

      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, 256, 256);

      return new THREE.CanvasTexture(glowCanvas);
    }

    const glowTexture = makeGlowTexture();

    function makeLabel(text, color = '#ffffff', size = 46) {
      const labelCanvas = document.createElement('canvas');
      labelCanvas.width = 1024;
      labelCanvas.height = 160;

      const ctx = labelCanvas.getContext('2d');
      ctx.font = `500 ${size}px Arial, sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.shadowColor = color;
      ctx.shadowBlur = 15;
      ctx.fillStyle = color;
      ctx.fillText(text.toUpperCase(), 512, 80);

      const texture = new THREE.CanvasTexture(labelCanvas);
      texture.colorSpace = THREE.SRGBColorSpace;

      const material = new THREE.SpriteMaterial({
        map: texture,
        transparent: true,
        depthWrite: false,
      });

      const sprite = new THREE.Sprite(material);
      sprite.scale.set(7, 1.1, 1);
      return sprite;
    }

    function addNebula(position, color, scale, opacity = 0.3) {
      const material = new THREE.SpriteMaterial({
        map: glowTexture,
        color,
        transparent: true,
        opacity,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      });

      const cloud = new THREE.Sprite(material);
      cloud.position.copy(position);
      cloud.scale.set(scale, scale * 0.7, 1);
      universe.add(cloud);
      return cloud;
    }

    // Layered nebula clouds create the purple cosmic atmosphere.
    addNebula(new THREE.Vector3(-12, 7, -18), 0x7134c4, 27, 0.28);
    addNebula(new THREE.Vector3(14, -5, -24), 0x9c3fba, 31, 0.22);
    addNebula(new THREE.Vector3(0, 13, -30), 0x4a39b6, 35, 0.19);
    addNebula(new THREE.Vector3(-20, -10, -15), 0x3c2a9b, 24, 0.2);
    addNebula(new THREE.Vector3(18, 12, -35), 0x9a4cdd, 22, 0.16);

    // Three different star layers create depth and distance.
    function createStarLayer(amount, radius, size, opacity, seed) {
      const random = seededRandom(seed);
      const positions = new Float32Array(amount * 3);
      const colors = new Float32Array(amount * 3);

      for (let i = 0; i < amount; i++) {
        const theta = random() * Math.PI * 2;
        const phi = Math.acos(2 * random() - 1);
        const distance = radius * (0.45 + random() * 0.55);

        positions[i * 3] = distance * Math.sin(phi) * Math.cos(theta);
        positions[i * 3 + 1] = distance * Math.sin(phi) * Math.sin(theta);
        positions[i * 3 + 2] = distance * Math.cos(phi);

        const shade = random();
        const color = new THREE.Color(
          shade > 0.91 ? '#d7aaff' :
          shade > 0.78 ? '#9daaff' :
          shade > 0.64 ? '#ffc9e9' : '#ffffff'
        );

        colors[i * 3] = color.r;
        colors[i * 3 + 1] = color.g;
        colors[i * 3 + 2] = color.b;
      }

      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

      const material = new THREE.PointsMaterial({
        size,
        transparent: true,
        opacity,
        vertexColors: true,
        sizeAttenuation: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
      });

      const stars = new THREE.Points(geometry, material);
      universe.add(stars);
      return stars;
    }

    const starLayers = [
      createStarLayer(2400, 100, 0.12, 0.85, 10),
      createStarLayer(1000, 75, 0.22, 0.9, 22),
      createStarLayer(300, 60, 0.38, 0.95, 35),
    ];

    // A few individual bright stars.
    const brightStars = [];

    for (let i = 0; i < 34; i++) {
      const random = seededRandom(i + 400);
      const star = new THREE.Mesh(
        new THREE.SphereGeometry(random() * 0.09 + 0.035, 8, 8),
        new THREE.MeshBasicMaterial({
          color: i % 4 === 0 ? 0xd8b7ff : 0xffffff,
        })
      );

      star.position.set(
        (random() - 0.5) * 55,
        (random() - 0.5) * 35,
        (random() - 0.5) * 30 - 8
      );

      universe.add(star);
      brightStars.push(star);
    }

    function makeOrbit(radius, color = 0x9872d4, opacity = 0.28) {
      const points = [];
      const segments = 180;

      for (let i = 0; i <= segments; i++) {
        const angle = (i / segments) * Math.PI * 2;
        points.push(
          new THREE.Vector3(
            Math.cos(angle) * radius,
            Math.sin(angle) * radius,
            0
          )
        );
      }

      const geometry = new THREE.BufferGeometry().setFromPoints(points);
      const material = new THREE.LineBasicMaterial({
        color,
        transparent: true,
        opacity,
      });

      const orbit = new THREE.LineLoop(geometry, material);
      return orbit;
    }

    function createPlanet({
      id,
      title,
      description,
      url = '',
      color = '#8b65ff',
      size = 1.5,
      position,
      kind = 'article',
      parent = '',
      seed = 1,
      ring = false,
    }) {
      const group = new THREE.Group();
      group.position.copy(position);

      const geometry = new THREE.SphereGeometry(size, 64, 64);
      const material = new THREE.MeshStandardMaterial({
        map: makePlanetTexture(color, seed),
        roughness: 0.75,
        metalness: 0.18,
      });

      const planet = new THREE.Mesh(geometry, material);
      planet.rotation.z = 0.18;
      group.add(planet);

      // Glowing atmospheric shell.
      const atmosphere = new THREE.Mesh(
        new THREE.SphereGeometry(size * 1.075, 48, 48),
        new THREE.MeshBasicMaterial({
          color,
          transparent: true,
          opacity: 0.14,
          side: THREE.BackSide,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        })
      );
      group.add(atmosphere);

      // Outer luminous halo.
      const halo = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: glowTexture,
          color,
          transparent: true,
          opacity: 0.5,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        })
      );
      halo.scale.set(size * 4.7, size * 4.7, 1);
      group.add(halo);

      if (ring) {
        const ringGeometry = new THREE.TorusGeometry(size * 1.55, size * 0.035, 4, 140);
        const ringMaterial = new THREE.MeshBasicMaterial({
          color: 0xd4b4ff,
          transparent: true,
          opacity: 0.65,
          side: THREE.DoubleSide,
        });
        const planetaryRing = new THREE.Mesh(ringGeometry, ringMaterial);
        planetaryRing.rotation.x = Math.PI * 0.38;
        planetaryRing.rotation.y = Math.PI * 0.12;
        group.add(planetaryRing);

        const secondRing = new THREE.Mesh(
          new THREE.TorusGeometry(size * 1.85, size * 0.012, 3, 140),
          new THREE.MeshBasicMaterial({
            color: 0x9d70f4,
            transparent: true,
            opacity: 0.35,
          })
        );
        secondRing.rotation.copy(planetaryRing.rotation);
        group.add(secondRing);
      }

      const label = makeLabel(title, '#eee3ff', kind === 'center' ? 58 : 39);
      label.position.set(0, -size - 0.9, 0);
      group.add(label);

      const hitArea = new THREE.Mesh(
        new THREE.SphereGeometry(size * 1.55, 20, 20),
        new THREE.MeshBasicMaterial({
          transparent: true,
          opacity: 0,
          depthWrite: false,
        })
      );
      hitArea.userData = { id };
      group.add(hitArea);

      const object = {
        id,
        title,
        description,
        url,
        kind,
        parent,
        group,
        planet,
        atmosphere,
        halo,
        hitArea,
        label,
      };

      objects.set(id, object);
      selectable.push(hitArea);
      searchable.push(object);

      return object;
    }

    // Central Turath star: a luminous, layered celestial body.
    const sunGroup = new THREE.Group();
    universe.add(sunGroup);

    const sun = new THREE.Mesh(
      new THREE.SphereGeometry(3.1, 96, 96),
      new THREE.MeshBasicMaterial({
        color: 0x8b4ce0,
      })
    );
    sunGroup.add(sun);

    const sunShell = new THREE.Mesh(
      new THREE.SphereGeometry(3.35, 64, 64),
      new THREE.MeshBasicMaterial({
        color: 0xc19aff,
        transparent: true,
        opacity: 0.22,
        side: THREE.BackSide,
        blending: THREE.AdditiveBlending,
      })
    );
    sunGroup.add(sunShell);

    const sunGlow = new THREE.Sprite(
      new THREE.SpriteMaterial({
        map: glowTexture,
        color: 0x9e57ff,
        transparent: true,
        opacity: 1,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      })
    );
    sunGlow.scale.set(18, 18, 1);
    sunGroup.add(sunGlow);

    const sunCore = new THREE.Mesh(
      new THREE.SphereGeometry(2.55, 64, 64),
      new THREE.MeshBasicMaterial({
        color: 0x2a124d,
        transparent: true,
        opacity: 0.28,
      })
    );
    sunGroup.add(sunCore);

    const sunLabel = makeLabel('TURATH', '#e5d4ff', 65);
    sunLabel.position.y = -5;
    sunLabel.scale.set(8, 1.3, 1);
    sunGroup.add(sunLabel);

    const sunObject = {
      id: 'turath',
      title: 'TURATH',
      description: 'An archive of culture, art, expression, and the people behind them.',
      kind: 'center',
      group: sunGroup,
      planet: sun,
    };

    objects.set('turath', sunObject);
    searchable.push(sunObject);

    // A wide, faint orbit surrounding the central star.
    universe.add(makeOrbit(8.5, 0x8d62c9, 0.17));
    universe.add(makeOrbit(20, 0x7546ae, 0.12));
    universe.add(makeOrbit(25, 0x6544a3, 0.08));

    // Build the main planetary systems.
    const categoryObjects = new Map();

    constellationData.categories.forEach((item, index) => {
      const angle = THREE.MathUtils.degToRad(item.angle);
      const x = Math.cos(angle) * item.orbit;
      const y = Math.sin(angle) * item.orbit * 0.64;
      const z = Math.sin(angle * 1.7) * 3.2;

      const object = createPlanet({
        ...item,
        position: new THREE.Vector3(x, y, z),
        seed: index + 12,
        ring: index === 1 || index === 2,
      });

      categoryObjects.set(item.id, object);

      // Orbital trail around the central star.
      const orbit = makeOrbit(item.orbit, new THREE.Color(item.color), 0.23);
      orbit.scale.y = 0.64;
      orbit.rotation.z = 0;
      orbit.position.z = z * 0.12;
      universe.add(orbit);
    });

    // Smaller article planets orbit around their parent systems.
    const articleGroups = [];

    constellationData.articles.forEach((article, index) => {
      const parent = categoryObjects.get(article.parent);
      if (!parent) return;

      const angle = (index / Math.max(
        constellationData.articles.filter((item) => item.parent === article.parent).length,
        1
      )) * Math.PI * 2;

      const orbitRadius = article.parent === 'music' ? 4.3 : 3.7;
      const satelliteGroup = new THREE.Group();
      parent.group.add(satelliteGroup);

      const satellite = createPlanet({
        ...article,
        color: article.parent === 'music' ? '#7862c9' : '#438e9b',
        size: 0.46,
        position: new THREE.Vector3(
          Math.cos(angle) * orbitRadius,
          Math.sin(angle) * orbitRadius * 0.7,
          Math.sin(angle * 2) * 0.9
        ),
        seed: index + 100,
        kind: 'article',
      });

      // Move the satellite into its own orbiting group.
      parent.group.remove(satellite.group);
      satellite.group.position.set(
        Math.cos(angle) * orbitRadius,
        Math.sin(angle) * orbitRadius * 0.7,
        Math.sin(angle * 2) * 0.9
      );
      satelliteGroup.add(satellite.group);

      const satelliteOrbit = makeOrbit(orbitRadius, 0xb59aff, 0.24);
      satelliteOrbit.scale.y = 0.7;
      satelliteGroup.add(satelliteOrbit);

      satellite.group.position.set(orbitRadius, 0, 0);
      satelliteGroupsSafe();

      function satelliteGroupsSafe() {
        articleGroups.push({
          group: satelliteGroup,
          satellite,
          speed: (article.parent === 'music' ? 1 : -1) * (0.055 + index * 0.006),
        });
      }
    });

    // Fine dust particles around the main systems.
    const dustPositions = new Float32Array(2200 * 3);
    const dustRandom = seededRandom(888);

    for (let i = 0; i < 2200; i++) {
      const radius = 7 + dustRandom() * 21;
      const angle = dustRandom() * Math.PI * 2;

      dustPositions[i * 3] = Math.cos(angle) * radius;
      dustPositions[i * 3 + 1] = Math.sin(angle) * radius * 0.6;
      dustPositions[i * 3 + 2] = (dustRandom() - 0.5) * 12;
    }

    const dustGeometry = new THREE.BufferGeometry();
    dustGeometry.setAttribute(
      'position',
      new THREE.BufferAttribute(dustPositions, 3)
    );

    const dust = new THREE.Points(
      dustGeometry,
      new THREE.PointsMaterial({
        color: 0xb18bff,
        size: 0.045,
        transparent: true,
        opacity: 0.5,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      })
    );

    universe.add(dust);

    // Occasional shooting stars.
    const shootingStars = [];

    function spawnShootingStar() {
      const start = new THREE.Vector3(
        (Math.random() - 0.5) * 55,
        12 + Math.random() * 12,
        -15 - Math.random() * 20
      );

      const end = start.clone().add(
        new THREE.Vector3(4 + Math.random() * 7, -3 - Math.random() * 5, 0)
      );

      const geometry = new THREE.BufferGeometry().setFromPoints([start, end]);
      const material = new THREE.LineBasicMaterial({
        color: 0xdcc6ff,
        transparent: true,
        opacity: 0.9,
      });

      const streak = new THREE.Line(geometry, material);
      universe.add(streak);

      shootingStars.push({
        object: streak,
        life: 0,
        duration: 1.1 + Math.random() * 0.7,
      });
    }

    let shootingStarTimer = 0;

    // Camera interaction.
    let rotationX = -0.12;
    let rotationY = 0.1;
    let targetRotationX = rotationX;
    let targetRotationY = rotationY;
    let cameraDistance = 43;
    let targetCameraDistance = 43;
    let pointerDown = false;
    let pointerMoved = false;
    let lastPointerX = 0;
    let lastPointerY = 0;
    let downX = 0;
    let downY = 0;

    function updateCamera() {
      camera.position.z += (targetCameraDistance - camera.position.z) * 0.08;
      universe.rotation.x += (targetRotationX - universe.rotation.x) * 0.08;
      universe.rotation.y += (targetRotationY - universe.rotation.y) * 0.08;
    }

    canvas.addEventListener('pointerdown', (event) => {
      pointerDown = true;
      pointerMoved = false;
      lastPointerX = event.clientX;
      lastPointerY = event.clientY;
      downX = event.clientX;
      downY = event.clientY;
      canvas.setPointerCapture(event.pointerId);
      canvas.classList.add('is-dragging');
    });

    canvas.addEventListener('pointermove', (event) => {
      if (!pointerDown) return;

      const deltaX = event.clientX - lastPointerX;
      const deltaY = event.clientY - lastPointerY;

      if (
        Math.abs(event.clientX - downX) +
        Math.abs(event.clientY - downY) > 5
      ) {
        pointerMoved = true;
      }

      targetRotationY += deltaX * 0.004;
      targetRotationX += deltaY * 0.003;
      targetRotationX = THREE.MathUtils.clamp(targetRotationX, -0.9, 0.9);

      lastPointerX = event.clientX;
      lastPointerY = event.clientY;
    });

    function releasePointer() {
      pointerDown = false;
      canvas.classList.remove('is-dragging');
    }

    canvas.addEventListener('pointerup', (event) => {
      releasePointer();

      if (pointerMoved) return;

      const bounds = canvas.getBoundingClientRect();
      pointer.x = ((event.clientX - bounds.left) / bounds.width) * 2 - 1;
      pointer.y = -((event.clientY - bounds.top) / bounds.height) * 2 + 1;

      raycaster.setFromCamera(pointer, camera);
      const hits = raycaster.intersectObjects(selectable, false);

      if (hits.length) {
        const id = hits[0].object.userData.id;
        const object = objects.get(id);
        if (object) showObject(object);
      }
    });

    canvas.addEventListener('pointercancel', releasePointer);

    canvas.addEventListener('wheel', (event) => {
      event.preventDefault();
      targetCameraDistance = THREE.MathUtils.clamp(
        targetCameraDistance + event.deltaY * 0.025,
        20,
        75
      );
    }, { passive: false });

    function showObject(object) {
      if (object.kind === 'about') {
        document.querySelector('#about')?.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
        closeDetail();
        return;
      }

      if (object.url && object.kind !== 'category' && object.kind !== 'center') {
        window.location.href = object.url;
        return;
      }

      detailTitle.textContent = object.title;
      detailDescription.textContent = object.description;
      detailKicker.textContent =
        object.kind === 'center' ? 'THE ARCHIVE' : 'EXPLORE THE SYSTEM';

      detailLinks.replaceChildren();
      detailOpen.hidden = true;

      if (object.kind === 'category') {
        const children = constellationData.articles.filter(
          (article) => article.parent === object.id
        );

        children.forEach((article) => {
          const link = document.createElement('a');
          link.href = article.url;
          link.textContent = `${article.title} ↗`;
          detailLinks.appendChild(link);
        });

        if (!children.length) {
          const empty = document.createElement('p');
          empty.textContent = 'More stories coming soon.';
          empty.style.color = 'rgba(255,255,255,.6)';
          empty.style.fontSize = '.8rem';
          detailLinks.appendChild(empty);
        }
      }

      if (object.kind === 'center') {
        const link = document.createElement('a');
        link.href = '#about';
        link.textContent = 'Discover the story behind Turath ↗';
        link.addEventListener('click', (event) => {
          event.preventDefault();
          document.querySelector('#about')?.scrollIntoView({
            behavior: 'smooth',
          });
          closeDetail();
        });
        detailLinks.appendChild(link);
      }

      detail.classList.add('is-open');
    }

    function closeDetail() {
      detail.classList.remove('is-open');
    }

    section.querySelector('#universe-close')?.addEventListener(
      'click',
      closeDetail
    );

    search.addEventListener('input', () => {
      const query = search.value.trim().toLowerCase();
      let matches = 0;

      searchable.forEach((object) => {
        const match =
          object.title.toLowerCase().includes(query) ||
          object.description.toLowerCase().includes(query);

        const visible = !query || match;
        object.group.visible = visible;

        if (visible) matches++;
      });

      searchCount.textContent = query ? `${matches} FOUND` : '';
    });

    section.querySelector('#universe-reset')?.addEventListener('click', () => {
      targetRotationX = -0.12;
      targetRotationY = 0.1;
      targetCameraDistance = 43;
      search.value = '';
      search.dispatchEvent(new Event('input'));
      closeDetail();
    });

    function resize() {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;

      if (!width || !height) return;

      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.8));
    }

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(section);

    // Main animation loop.
    let frameId;

    function animate() {
      frameId = requestAnimationFrame(animate);

      const elapsed = clock.getElapsedTime();
      const delta = Math.min(clock.getDelta(), 0.05);

      updateCamera();

      sun.rotation.y += delta * 0.12;
      sun.rotation.x += delta * 0.025;
      sunGlow.material.opacity = 0.88 + Math.sin(elapsed * 1.4) * 0.12;
      sunGlow.scale.setScalar(18 + Math.sin(elapsed * 1.1) * 0.65);

      starLayers[0].rotation.y += delta * 0.002;
      starLayers[1].rotation.y -= delta * 0.004;
      starLayers[2].rotation.x += delta * 0.003;
      dust.rotation.z += delta * 0.012;

      brightStars.forEach((star, index) => {
        const pulse = 0.65 + Math.sin(elapsed * (0.8 + index * 0.03)) * 0.3;
        star.scale.setScalar(pulse);
      });

      categoryObjects.forEach((object, index) => {
        object.planet.rotation.y += delta * (0.08 + index * 0.025);
        object.planet.rotation.x += delta * 0.012;
        object.halo.material.opacity =
          0.38 + Math.sin(elapsed * 1.2 + index) * 0.12;
      });

      articleGroups.forEach((item) => {
        item.group.rotation.z += delta * item.speed;
        item.satellite.planet.rotation.y += delta * 0.25;
      });

      shootingStarTimer += delta;

      if (shootingStarTimer > 3.2 + Math.random() * 3.5) {
        shootingStarTimer = 0;
        spawnShootingStar();
      }

      shootingStars.forEach((star, index) => {
        star.life += delta;
        star.object.material.opacity = Math.max(
          0,
          1 - star.life / star.duration
        );
        if (star.life > star.duration) {
          universe.remove(star.object);
          star.object.geometry.dispose();
          star.object.material.dispose();
          shootingStars.splice(index, 1);
        }
      });

      renderer.render(scene, camera);
    }

    resize();
    animate();

    loading.classList.add('is-ready');

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(frameId);
      } else {
        cancelAnimationFrame(frameId);
        animate();
      }
    });
  }
</script>
