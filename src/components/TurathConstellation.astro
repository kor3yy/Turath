
---
const {
  acknowledgments,
  musicPosts = [],
  photographyPosts = [],
  latestArticle,
} = Astro.props;

function orbitPosts(posts, parent) {
  return posts.map((post, index) => ({
    id: `${parent}-${index}`,
    parent,
    title: post.data.title,
    description: post.data.description || '',
    url: `/blog/${post.slug}/`,
    kind: 'article',
  }));
}

const nodes = [
  {
    id: 'turath',
    title: 'TURATH',
    description: 'An archive of culture, art, expression, and the people behind them.',
    kind: 'center',
  },
  {
    id: 'acknowledgments',
    title: 'ACKNOWLEDGMENTS',
    description: 'A personal dedication to the people and memories that will forever be part of Turath.',
    kind: 'feature',
    url: acknowledgments ? `/blog/${acknowledgments.slug}/` : '',
  },
  {
    id: 'music',
    title: 'MUSIC',
    description: 'Artists, sounds, perspectives, and the stories behind the music.',
    kind: 'category',
  },
  {
    id: 'photography',
    title: 'PHOTOGRAPHY',
    description: 'Stories told through images and the people behind the lens.',
    kind: 'category',
  },
  {
    id: 'about',
    title: 'ABOUT TURATH',
    description: 'The meaning, origins, and story behind Turath.',
    kind: 'about',
    url: '#about',
  },
  ...(latestArticle
    ? [{
        id: 'latest',
        title: 'LATEST ARTICLE',
        description: latestArticle.data.title,
        kind: 'feature',
        url: `/blog/${latestArticle.slug}/`,
      }]
    : []),
  ...orbitPosts(musicPosts, 'music'),
  ...orbitPosts(photographyPosts, 'photography'),
];
---

<section
  class="turath-universe"
  id="turath-universe"
  data-archive={JSON.stringify(nodes)}
>
  <div class="universe-topline">
    <div>
      <span class="universe-eyebrow">TURATH ARCHIVE / DEEP SPACE</span>
      <h2>THE UNIVERSE</h2>
      <p>Explore the worlds, stories, and people within Turath.</p>
    </div>
    <div class="universe-status">
      <span class="status-light"></span>
      DEEP SPACE OBSERVATION
    </div>
  </div>

  <div class="universe-controls">
    <div class="universe-search">
      <span>⌕</span>
      <input
        type="search"
        id="universe-search"
        placeholder="Search planets, artists, stories..."
        autocomplete="off"
        aria-label="Search the Turath universe"
      />
    </div>
    <button type="button" id="universe-reset">RESET VIEW</button>
  </div>

  <div class="universe-stage" id="universe-stage">
    <canvas id="universe-canvas" aria-label="Interactive 3D planetary universe"></canvas>

    <div class="universe-loading" id="universe-loading">
      <div class="loading-orbit"><span></span></div>
      <p>INITIALIZING DEEP SPACE</p>
    </div>

    <div class="universe-labels" id="universe-labels"></div>

    <div class="universe-corner universe-corner-left">
      <span>SECTOR 001</span>
      <span>THE TURATH SYSTEM</span>
    </div>
    <div class="universe-corner universe-corner-right">
      <span>3D ORBITAL VIEW</span>
      <span>DRAG TO ROTATE · SCROLL TO ZOOM</span>
    </div>

    <div class="universe-detail" id="universe-detail" aria-live="polite">
      <button type="button" class="detail-close" id="detail-close" aria-label="Close details">×</button>
      <span class="detail-eyebrow">CELESTIAL OBJECT</span>
      <h3 id="detail-title">TURATH</h3>
      <p id="detail-description">An archive of culture, art, expression, and the people behind them.</p>
      <div id="detail-links"></div>
      <a id="detail-open" href="#about">EXPLORE <span>↗</span></a>
    </div>

    <div class="universe-fallback" id="universe-fallback" hidden>
      <p>THE OBSERVATORY IS UNAVAILABLE</p>
      <span>Your browser could not initialize the 3D environment. Try enabling hardware acceleration or using a WebGL-compatible browser.</span>
    </div>
  </div>

  <div class="universe-bottomline">
    <span><i></i> LIVE ORBITAL SYSTEM</span>
    <span>SELECT A PLANET TO EXPLORE ITS STORIES</span>
  </div>
</section>

<style>
  .turath-universe {
    --space-purple: #160a2b;
    --space-violet: #a78bfa;
    position: relative;
    width: 100%;
    padding: 100px 5vw 55px;
    overflow: hidden;
    color: #f1eaff;
    background:
      radial-gradient(ellipse at 50% 48%, rgba(68, 29, 117, .17), transparent 58%),
      linear-gradient(180deg, #080510 0%, #0d0719 48%, #080510 100%);
    font-family: inherit;
  }

  .universe-topline {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 25px;
    max-width: 1500px;
    margin: 0 auto 30px;
  }

  .universe-eyebrow,
  .detail-eyebrow {
    color: #a98bd8;
    font-size: 9px;
    letter-spacing: .28em;
  }

  .universe-topline h2 {
    margin: 12px 0 8px;
    color: #f5edff;
    font-size: clamp(32px, 5vw, 58px);
    font-weight: 400;
    letter-spacing: .16em;
  }

  .universe-topline p {
    margin: 0;
    color: #a69ab8;
    font-size: 12px;
    letter-spacing: .05em;
  }

  .universe-status {
    display: flex;
    align-items: center;
    gap: 9px;
    padding-bottom: 8px;
    color: #b7a8cd;
    font-size: 9px;
    letter-spacing: .16em;
  }

  .status-light,
  .universe-bottomline i {
    width: 6px;
    height: 6px;
    display: inline-block;
    border-radius: 50%;
    background: #bd8bff;
    box-shadow: 0 0 12px #a855f7;
    animation: statusPulse 2s infinite;
  }

  .universe-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    max-width: 1500px;
    margin: 0 auto 12px;
  }

  .universe-search {
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(330px, 70%);
    padding: 10px 13px;
    border: 1px solid rgba(183, 145, 239, .2);
    background: rgba(23, 13, 39, .75);
    color: #cbb4f5;
  }

  .universe-search span {
    font-size: 19px;
  }

  .universe-search input {
    width: 100%;
    border: 0;
    outline: 0;
    color: #f3eaff;
    background: transparent;
    font: inherit;
    font-size: 11px;
  }

  .universe-search input::placeholder {
    color: #776987;
  }

  #universe-reset {
    border: 1px solid rgba(183, 145, 239, .2);
    padding: 11px 15px;
    color: #cbb4f5;
    background: rgba(23, 13, 39, .75);
    font: inherit;
    font-size: 9px;
    letter-spacing: .15em;
    cursor: pointer;
    transition: .25s;
  }

  #universe-reset:hover {
    border-color: #b68aff;
    background: rgba(116, 66, 173, .2);
  }

  .universe-stage {
    position: relative;
    width: 100%;
    height: clamp(500px, 68vw, 790px);
    min-height: 500px;
    overflow: hidden;
    border: 1px solid rgba(168, 119, 224, .16);
    background:
      radial-gradient(ellipse at 50% 50%, rgba(74, 32, 119, .16), transparent 65%),
      #080510;
    isolation: isolate;
  }

  #universe-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: pan-y;
  }

  #universe-canvas:active {
    cursor: grabbing;
  }

  .universe-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .planet-label {
    position: absolute;
    transform: translate(-50%, -50%);
    border: 0;
    padding: 5px 8px;
    color: #e9dcff;
    background: rgba(12, 6, 23, .65);
    text-shadow: 0 0 12px #b58aff;
    font: inherit;
    font-size: 9px;
    letter-spacing: .17em;
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity .3s, color .3s, background .3s;
  }

  .planet-label:hover,
  .planet-label.active {
    color: white;
    background: rgba(113, 65, 170, .48);
  }

  .planet-label.dimmed {
    opacity: .12;
  }

  .universe-loading {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    background: #080510;
    transition: opacity .8s;
    pointer-events: none;
  }

  .universe-loading p {
    color: #bba0df;
    font-size: 9px;
    letter-spacing: .28em;
  }

  .loading-orbit {
    width: 45px;
    height: 45px;
    border: 1px solid rgba(180, 130, 255, .3);
    border-top-color: #d9baff;
    border-radius: 50%;
    animation: orbitSpin 1.5s linear infinite;
    display: grid;
    place-items: center;
  }

  .loading-orbit span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c49aff;
    box-shadow: 0 0 15px #bd8bff;
  }

  .universe-loading.finished {
    opacity: 0;
  }

  .universe-corner {
    position: absolute;
    bottom: 17px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    color: rgba(194, 169, 224, .65);
    font-size: 8px;
    letter-spacing: .16em;
    pointer-events: none;
  }

  .universe-corner-left {
    left: 18px;
  }

  .universe-corner-right {
    right: 18px;
    text-align: right;
  }

  .universe-detail {
    position: absolute;
    z-index: 5;
    top: 18px;
    right: 18px;
    width: min(280px, calc(100% - 36px));
    padding: 23px;
    border: 1px solid rgba(187, 143, 245, .35);
    background: rgba(12, 7, 24, .91);
    backdrop-filter: blur(18px);
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: .35s;
  }

  .universe-detail.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .detail-close {
    position: absolute;
    top: 8px;
    right: 12px;
    border: 0;
    color: #cdb5ed;
    background: transparent;
    font-size: 23px;
    cursor: pointer;
  }

  .universe-detail h3 {
    margin: 12px 0;
    color: #f4eaff;
    font-size: 19px;
    font-weight: 400;
    letter-spacing: .12em;
  }

  .universe-detail p {
    color: #b8a9ca;
    font-size: 11px;
    line-height: 1.8;
  }

  #detail-links {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 15px 0;
  }

  #detail-links a {
    color: #c6a3f5;
    font-size: 10px;
    line-height: 1.5;
    text-decoration: none;
  }

  #detail-links a:hover {
    color: white;
  }

  #detail-open {
    display: inline-block;
    margin-top: 8px;
    color: #e2caff;
    font-size: 9px;
    letter-spacing: .18em;
    text-decoration: none;
  }

  #detail-open span {
    margin-left: 8px;
  }

  .universe-fallback {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 30px;
    text-align: center;
    background: #0b0614;
  }

  .universe-fallback p {
    color: #d8baff;
    letter-spacing: .2em;
    font-size: 12px;
  }

  .universe-fallback span {
    max-width: 400px;
    color: #a99ab9;
    font-size: 11px;
    line-height: 1.8;
  }

  .universe-bottomline {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    max-width: 1500px;
    margin: 13px auto 0;
    color: #8e7b9f;
    font-size: 8px;
    letter-spacing: .16em;
  }

  .universe-bottomline span:first-child {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @keyframes orbitSpin {
    to { transform: rotate(360deg); }
  }

  @keyframes statusPulse {
    50% { opacity: .35; }
  }

  @media (max-width: 650px) {
    .turath-universe {
      padding: 65px 4vw 35px;
    }

    .universe-topline {
      align-items: flex-start;
      flex-direction: column;
    }

    .universe-status {
      padding: 0;
    }

    .universe-stage {
      height: 580px;
    }

    .universe-corner {
      font-size: 7px;
    }

    .universe-bottomline {
      font-size: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .turath-universe *,
    .turath-universe *::before,
    .turath-universe *::after {
      animation-duration: .01ms !important;
      transition-duration: .01ms !important;
    }
  }
</style>

<script is:inline>
(async () => {
  let THREE;

  try {
    THREE = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js');
  } catch (error) {
    console.error('TURATH THREE.JS LOAD ERROR:', error);

    const loading = document.querySelector('#universe-loading');
    const fallback = document.querySelector('#universe-fallback');

    if (loading) loading.classList.add('finished');

    if (fallback) {
      fallback.hidden = false;
      fallback.querySelector('span').textContent =
        'THREE.JS LOAD ERROR: ' + error.message;
    }

    return;
  }

  const initialize = async () => {
    const section = document.querySelector('#turath-universe');

    if (!section || section.dataset.initialized === 'true') return;

    section.dataset.initialized = 'true';

    const stage = section.querySelector('#universe-stage');
    const canvas = section.querySelector('#universe-canvas');
    const labelsContainer = section.querySelector('#universe-labels');
    const loading = section.querySelector('#universe-loading');
    const fallback = section.querySelector('#universe-fallback');
    const detail = section.querySelector('#universe-detail');
    const search = section.querySelector('#universe-search');
    const reset = section.querySelector('#universe-reset');

    const data = JSON.parse(section.dataset.archive || '[]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!section.isConnected) return;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#080510');
    scene.fog = new THREE.FogExp2('#080510', 0.006);

    const camera = new THREE.PerspectiveCamera(43, 1, 0.1, 250);
    camera.position.set(0, 0, 43);

    let renderer;

    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: false,
        antialias: true,
        powerPreference: 'high-performance',
      });
    } catch (error) {
      console.error('TURATH WEBGL ERROR:', error);
      loading.classList.add('finished');
      fallback.hidden = false;
      fallback.querySelector('span').textContent =
        'WEBGL ERROR: ' + error.message;
      return;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.25;

    const universe = new THREE.Group();
    scene.add(universe);

    scene.add(new THREE.AmbientLight('#8870b5', 0.8));

    const keyLight = new THREE.PointLight('#d8baff', 240, 120, 1.5);
    keyLight.position.set(-8, 12, 20);
    scene.add(keyLight);

    const violetLight = new THREE.PointLight('#823cff', 130, 100, 2);
    violetLight.position.set(14, -8, -12);
    scene.add(violetLight);

    const blueLight = new THREE.PointLight('#526dff', 90, 90, 2);
    blueLight.position.set(-20, -12, -10);
    scene.add(blueLight);

    const textureCanvas = (width, height) => {
      const c = document.createElement('canvas');
      c.width = width;
      c.height = height;
      return [c, c.getContext('2d')];
    };

    function makeSurface(seed, palette, style = 'rocky') {
      const [c, ctx] = textureCanvas(512, 256);

      let seedValue = seed * 92821 + 31;

      const random = () => {
        seedValue = (seedValue * 16807) % 2147483647;
        return seedValue / 2147483647;
      };

      const gradient = ctx.createLinearGradient(0, 0, 512, 256);

      palette.forEach((color, index) => {
        gradient.addColorStop(index / (palette.length - 1), color);
      });

      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, 512, 256);

      for (let i = 0; i < 950; i++) {
        const x = random() * 512;
        const y = random() * 256;
        const r = 2 + random() * (style === 'gas' ? 20 : 11);
        const alpha = .025 + random() * .16;

        ctx.beginPath();
        ctx.ellipse(
          x,
          y,
          r * (1 + random()),
          r * .55,
          random() * 3,
          0,
          Math.PI * 2
        );

        ctx.fillStyle = random() > .5
          ? `rgba(230,210,255,${alpha})`
          : `rgba(10,4,25,${alpha})`;

        ctx.fill();
      }

      if (style === 'gas') {
        for (let i = 0; i < 38; i++) {
          const y = random() * 256;
          ctx.fillStyle = `rgba(230,205,255,${.025 + random() * .1})`;
          ctx.fillRect(0, y, 512, 2 + random() * 10);
        }
      }

      if (style === 'rocky' || style === 'moon') {
        for (let i = 0; i < 180; i++) {
          const x = random() * 512;
          const y = random() * 256;
          const r = 1 + random() * 7;

          const g = ctx.createRadialGradient(
            x - r * .25,
            y - r * .25,
            0,
            x,
            y,
            r
          );

          g.addColorStop(0, 'rgba(245,225,255,.22)');
          g.addColorStop(.65, 'rgba(20,10,40,.12)');
          g.addColorStop(1, 'rgba(5,2,15,.25)');

          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(x, y, r, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      const texture = new THREE.CanvasTexture(c);
      texture.colorSpace = THREE.SRGBColorSpace;
      texture.anisotropy = renderer.capabilities.getMaxAnisotropy();

      return texture;
    }

    function makeGlowTexture() {
      const [c, ctx] = textureCanvas(128, 128);

      const g = ctx.createRadialGradient(64, 64, 2, 64, 64, 64);

      g.addColorStop(0, 'rgba(255,255,255,.85)');
      g.addColorStop(.12, 'rgba(213,160,255,.42)');
      g.addColorStop(.38, 'rgba(145,73,255,.17)');
      g.addColorStop(1, 'rgba(80,25,150,0)');

      ctx.fillStyle = g;
      ctx.fillRect(0, 0, 128, 128);

      return new THREE.CanvasTexture(c);
    }

    const glowTexture = makeGlowTexture();

    function makeNebula(x, y, z, size, color, opacity) {
      const material = new THREE.SpriteMaterial({
        map: glowTexture,
        color,
        transparent: true,
        opacity,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
      });

      const sprite = new THREE.Sprite(material);
      sprite.position.set(x, y, z);
      sprite.scale.set(size, size * .65, 1);

      universe.add(sprite);
    }

    makeNebula(-17, 9, -24, 24, '#7433bd', .26);
    makeNebula(18, -8, -27, 29, '#4126a5', .22);
    makeNebula(0, 17, -35, 22, '#a34dce', .12);
    makeNebula(-4, -18, -30, 26, '#5522a0', .15);
    makeNebula(22, 12, -40, 18, '#bd73ff', .11);

    // Distant stars
    const starCount = 2400;
    const starPositions = new Float32Array(starCount * 3);
    const starColors = new Float32Array(starCount * 3);
    const starSizes = new Float32Array(starCount);

    for (let i = 0; i < starCount; i++) {
      const i3 = i * 3;

      starPositions[i3] = (Math.random() - .5) * 150;
      starPositions[i3 + 1] = (Math.random() - .5) * 100;
      starPositions[i3 + 2] = -Math.random() * 95 - 15;

      const tint = Math.random();

      const color = new THREE.Color(
        tint > .84 ? '#d6b2ff' : tint > .55 ? '#9f9bff' : '#ffffff'
      );

      starColors[i3] = color.r;
      starColors[i3 + 1] = color.g;
      starColors[i3 + 2] = color.b;

      starSizes[i] = .5 + Math.random() * 1.7;
    }

    const starGeometry = new THREE.BufferGeometry();

    starGeometry.setAttribute(
      'position',
      new THREE.BufferAttribute(starPositions, 3)
    );

    starGeometry.setAttribute(
      'color',
      new THREE.BufferAttribute(starColors, 3)
    );

    starGeometry.setAttribute(
      'size',
      new THREE.BufferAttribute(starSizes, 1)
    );

    const starMaterial = new THREE.PointsMaterial({
      size: .11,
      vertexColors: true,
      transparent: true,
      opacity: .9,
      sizeAttenuation: true,
      depthWrite: false,
    });

    const stars = new THREE.Points(starGeometry, starMaterial);
    universe.add(stars);

    // A second, closer star layer adds depth.
    const nearStarPositions = new Float32Array(400 * 3);

    for (let i = 0; i < 400; i++) {
      nearStarPositions[i * 3] = (Math.random() - .5) * 75;
      nearStarPositions[i * 3 + 1] = (Math.random() - .5) * 50;
      nearStarPositions[i * 3 + 2] = (Math.random() - .5) * 30 - 8;
    }

    const nearStarGeometry = new THREE.BufferGeometry();

    nearStarGeometry.setAttribute(
      'position',
      new THREE.BufferAttribute(nearStarPositions, 3)
    );

    const nearStars = new THREE.Points(
      nearStarGeometry,
      new THREE.PointsMaterial({
        color: '#d9c4ff',
        size: .09,
        transparent: true,
        opacity: .75,
        depthWrite: false,
      })
    );

    universe.add(nearStars);

    // Main celestial object positions.
    const positions = {
      turath: [0, 0, 0],
      acknowledgments: [0, 12, -3],
      music: [13, 3, -3],
      photography: [-13, 2, -3],
      about: [0, -12, -3],
      latest: [17, -9, -5],
    };

    const palettes = {
      turath: ['#10051f', '#53217f', '#a85de5', '#e3b9ff'],
      acknowledgments: ['#1a0b2b', '#553074', '#a978c8', '#e9d9ff'],
      music: ['#09071d', '#35206f', '#7e56c5', '#d6a8ff'],
      photography: ['#0c102c', '#263b77', '#716ed0', '#d4c5ff'],
      about: ['#1a0b2d', '#61348e', '#a66fce', '#edcaff'],
      latest: ['#0b0d25', '#2c3675', '#7269c6', '#c8baff'],
    };

    const bodyMeshes = [];
    const bodyById = new Map();
    const labelElements = new Map();
    const articleBodies = [];

    function addOrbit(parent, radiusX, radiusY, color = '#a77adf') {
      const points = [];

      for (let i = 0; i <= 160; i++) {
        const a = (i / 160) * Math.PI * 2;

        points.push(new THREE.Vector3(
          Math.cos(a) * radiusX,
          Math.sin(a) * radiusY,
          0
        ));
      }

      const geometry = new THREE.BufferGeometry().setFromPoints(points);

      const line = new THREE.LineLoop(
        geometry,
        new THREE.LineBasicMaterial({
          color,
          transparent: true,
          opacity: .22,
          depthWrite: false,
        })
      );

      line.position.copy(parent.position);
      universe.add(line);

      return line;
    }

    function createPlanet(node, position, radius, palette, style = 'rocky', seed = 1) {
      const group = new THREE.Group();
      group.position.set(...position);
      universe.add(group);

      const texture = makeSurface(seed, palette, style);
      const geometry = new THREE.SphereGeometry(radius, 64, 48);

      const material = new THREE.MeshStandardMaterial({
        map: texture,
        roughness: style === 'gas' ? .75 : .88,
        metalness: .08,
      });

      const planet = new THREE.Mesh(geometry, material);
      planet.rotation.z = .18;
      group.add(planet);

      const atmosphere = new THREE.Mesh(
        new THREE.SphereGeometry(radius * 1.055, 48, 32),
        new THREE.MeshBasicMaterial({
          color: palette[palette.length - 1],
          transparent: true,
          opacity: .08,
          side: THREE.BackSide,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        })
      );

      group.add(atmosphere);

      const glow = new THREE.Sprite(new THREE.SpriteMaterial({
        map: glowTexture,
        color: palette[palette.length - 1],
        transparent: true,
        opacity: node.id === 'turath' ? .9 : .38,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
      }));

      glow.scale.set(
        radius * (node.id === 'turath' ? 5.5 : 4),
        radius * 4,
        1
      );

      group.add(glow);

      // A soft atmospheric rim, layered outside the sphere.
      const rim = new THREE.Mesh(
        new THREE.SphereGeometry(radius * 1.025, 48, 32),
        new THREE.MeshBasicMaterial({
          color: palette[palette.length - 1],
          transparent: true,
          opacity: .08,
          side: THREE.BackSide,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        })
      );

      group.add(rim);

      const body = {
        node,
        group,
        planet,
        radius,
        glow,
        basePosition: new THREE.Vector3(...position),
      };

      bodyMeshes.push(planet);
      bodyById.set(node.id, body);

      if (node.id === 'music' || node.id === 'photography') {
        const ring = new THREE.Mesh(
          new THREE.RingGeometry(radius * 1.45, radius * 2.05, 120),
          new THREE.MeshBasicMaterial({
            color: node.id === 'music' ? '#bd91ff' : '#8b9aff',
            side: THREE.DoubleSide,
            transparent: true,
            opacity: .42,
            depthWrite: false,
          })
        );

        ring.rotation.x = Math.PI * .34;
        ring.rotation.y = .15;
        group.add(ring);

        const secondRing = new THREE.Mesh(
          new THREE.RingGeometry(radius * 2.15, radius * 2.22, 120),
          new THREE.MeshBasicMaterial({
            color: '#e3caff',
            side: THREE.DoubleSide,
            transparent: true,
            opacity: .2,
            depthWrite: false,
          })
        );

        secondRing.rotation.x = Math.PI * .34;
        secondRing.rotation.y = .15;
        group.add(secondRing);
      }

      return body;
    }

    // Central Turath star.
    const centerNode = data.find(n => n.id === 'turath');

    createPlanet(
      centerNode,
      positions.turath,
      3.15,
      palettes.turath,
      'gas',
      17
    );

    // Main orbit paths.
    const center = new THREE.Vector3(0, 0, 0);

    addOrbit(center, 13, 8, '#9b64d4');
    addOrbit(center, 18, 12, '#6b4c9b');

    const mainPlanets = data.filter(n => n.id !== 'turath' && !n.parent);

    mainPlanets.forEach((node, index) => {
      const position = positions[node.id] || [0, 0, 0];

      const radius = node.id === 'acknowledgments' ? 1.65
        : node.id === 'music' ? 2.35
        : node.id === 'photography' ? 2.1
        : node.id === 'about' ? 1.55
        : 1.3;

      const style = node.id === 'music' ? 'gas'
        : node.id === 'photography' ? 'rocky'
        : 'rocky';

      createPlanet(
        node,
        position,
        radius,
        palettes[node.id] || palettes.latest,
        style,
        index + 30
      );

      if (node.id !== 'acknowledgments') {
        addOrbit(
          new THREE.Vector3(position[0], position[1], position[2]),
          node.id === 'music' || node.id === 'photography' ? 4.2 : 2.8,
          node.id === 'music' || node.id === 'photography' ? 2.8 : 1.9,
          '#a78bfa'
        );
      }
    });

    // Article worlds orbit their parent category planets.
    data.filter(n => n.parent).forEach((node, index) => {
      const parent = bodyById.get(node.parent);

      if (!parent) return;

      const count = data.filter(n => n.parent === node.parent).length;
      const radius = node.parent === 'music' ? 0.55 : 0.48;
      const orbitRadius = node.parent === 'music' ? 4.2 : 3.5;

      const angle =
        (index % Math.max(count, 1)) / Math.max(count, 1) * Math.PI * 2;

      const group = new THREE.Group();
      universe.add(group);

      const moon = new THREE.Mesh(
        new THREE.SphereGeometry(radius, 32, 24),
        new THREE.MeshStandardMaterial({
          map: makeSurface(
            index + 70,
            ['#171027', '#60428c', '#c8a8ec'],
            'moon'
          ),
          roughness: .95,
          metalness: .05,
        })
      );

      group.add(moon);

      const moonGlow = new THREE.Sprite(new THREE.SpriteMaterial({
        map: glowTexture,
        color: '#bd8bff',
        transparent: true,
        opacity: .24,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
      }));

      moonGlow.scale.set(2.5, 2.5, 1);
      group.add(moonGlow);

      const articleBody = {
        node,
        group,
        planet: moon,
        radius,
        parent,
        angle,
        orbitRadius,
        orbitSpeed: .12 + (index % 4) * .035,
      };

      articleBodies.push(articleBody);
      bodyMeshes.push(moon);
      bodyById.set(node.id, articleBody);
    });

    // Comet particles with glowing heads and trailing paths.
    const comets = [];

    for (let i = 0; i < 3; i++) {
      const cometGroup = new THREE.Group();
      universe.add(cometGroup);

      const head = new THREE.Mesh(
        new THREE.SphereGeometry(.12, 12, 8),
        new THREE.MeshBasicMaterial({ color: '#f1dcff' })
      );

      cometGroup.add(head);

      const tailMaterial = new THREE.MeshBasicMaterial({
        color: i === 1 ? '#9e75ff' : '#d2b2ff',
        transparent: true,
        opacity: .32,
        side: THREE.DoubleSide,
        depthWrite: false,
      });

      const tail = new THREE.Mesh(
        new THREE.ConeGeometry(.18, 4.5, 12, 1, true),
        tailMaterial
      );

      tail.rotation.z = Math.PI / 2;
      tail.position.x = -2.2;
      cometGroup.add(tail);

      comets.push({
        group: cometGroup,
        phase: i * 2.1,
        speed: .12 + i * .035,
      });
    }

    // A few distant sparkling points.
    const sparkles = [];

    for (let i = 0; i < 28; i++) {
      const star = new THREE.Sprite(new THREE.SpriteMaterial({
        map: glowTexture,
        color: i % 3 === 0 ? '#e9d5ff' : '#9e75ff',
        transparent: true,
        opacity: .25 + Math.random() * .35,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
      }));

      const size = .3 + Math.random() * .8;

      star.scale.set(size, size, 1);

      star.position.set(
        (Math.random() - .5) * 50,
        (Math.random() - .5) * 35,
        -Math.random() * 30
      );

      universe.add(star);
      sparkles.push(star);
    }

    // Build accessible HTML labels.
    data.forEach(node => {
      const button = document.createElement('button');

      button.type = 'button';
      button.className = 'planet-label';
      button.textContent = node.title;
      button.dataset.id = node.id;

      button.addEventListener('click', () => selectNode(node));

      labelsContainer.appendChild(button);
      labelElements.set(node.id, button);
    });

    const detailTitle = section.querySelector('#detail-title');
    const detailDescription = section.querySelector('#detail-description');
    const detailLinks = section.querySelector('#detail-links');
    const detailOpen = section.querySelector('#detail-open');

    function selectNode(node) {
      if (!node) return;

      detailTitle.textContent = node.title;

      detailDescription.textContent =
        node.description || 'Explore this part of the Turath universe.';

      detailLinks.replaceChildren();

      const children = data.filter(item => item.parent === node.id);

      if (children.length) {
        children.forEach(child => {
          const link = document.createElement('a');

          link.href = child.url || '#';
          link.textContent = '↗  ' + child.title;

          detailLinks.appendChild(link);
        });
      }

      if (node.kind === 'article' && node.url) {
        detailOpen.href = node.url;
        detailOpen.textContent = 'READ STORY  ↗';
        detailOpen.style.display = 'inline-block';
      } else if (node.url) {
        detailOpen.href = node.url;

        detailOpen.textContent =
          node.id === 'about' ? 'DISCOVER TURATH  ↗' : 'EXPLORE  ↗';

        detailOpen.style.display = 'inline-block';
      } else {
        detailOpen.style.display = 'none';
      }

      detail.classList.add('visible');

      labelElements.forEach((label, id) => {
        label.classList.toggle('active', id === node.id);
      });
    }

    section.querySelector('#detail-close').addEventListener('click', () => {
      detail.classList.remove('visible');

      labelElements.forEach(label => {
        label.classList.remove('active');
      });
    });

    search.addEventListener('input', () => {
      const query = search.value.toLowerCase().trim();

      data.forEach(node => {
        const label = labelElements.get(node.id);

        const matches = !query ||
          node.title.toLowerCase().includes(query) ||
          (node.description || '').toLowerCase().includes(query);

        label.classList.toggle('dimmed', !matches);
      });
    });

    // Drag rotation and zoom.
    let dragging = false;
    let lastX = 0;
    let lastY = 0;

    let rotationX = 0;
    let rotationY = 0;

    let targetRotationX = 0;
    let targetRotationY = 0;

    let zoom = 43;

    canvas.addEventListener('pointerdown', event => {
      dragging = true;

      lastX = event.clientX;
      lastY = event.clientY;

      canvas.setPointerCapture(event.pointerId);
    });

    canvas.addEventListener('pointermove', event => {
      if (!dragging) return;

      const dx = event.clientX - lastX;
      const dy = event.clientY - lastY;

      targetRotationY += dx * .004;
      targetRotationX += dy * .003;

      targetRotationX = Math.max(-.7, Math.min(.7, targetRotationX));

      lastX = event.clientX;
      lastY = event.clientY;
    });

    const stopDragging = () => {
      dragging = false;
    };

    canvas.addEventListener('pointerup', stopDragging);
    canvas.addEventListener('pointercancel', stopDragging);
    canvas.addEventListener('lostpointercapture', stopDragging);

    canvas.addEventListener('wheel', event => {
      event.preventDefault();

      zoom = Math.max(27, Math.min(65, zoom + event.deltaY * .025));
    }, { passive: false });

    reset.addEventListener('click', () => {
      targetRotationX = 0;
      targetRotationY = 0;
      zoom = 43;

      search.value = '';
      search.dispatchEvent(new Event('input'));

      detail.classList.remove('visible');
    });

    // Resize handling.
    function resize() {
      const width = stage.clientWidth;
      const height = stage.clientHeight;

      if (!width || !height) return;

      camera.aspect = width / height;
      camera.updateProjectionMatrix();

      renderer.setSize(width, height, false);
    }

    const resizeObserver = new ResizeObserver(resize);

    resizeObserver.observe(stage);
    resize();

    const clock = new THREE.Clock();
    const projected = new THREE.Vector3();

    let animationFrame;
    let lastRender = 0;

    function animate(now = 0) {
      if (!section.isConnected) {
        cancelAnimationFrame(animationFrame);
        resizeObserver.disconnect();
        renderer.dispose();
        return;
      }

      animationFrame = requestAnimationFrame(animate);

      // Limit rendering on reduced-motion settings.
      if (reducedMotion && now - lastRender < 100) return;

      lastRender = now;

      const elapsed = clock.getElapsedTime();

      rotationX += (targetRotationX - rotationX) * .055;
      rotationY += (targetRotationY - rotationY) * .055;

      universe.rotation.x = rotationX;
      universe.rotation.y = rotationY;

      if (!reducedMotion) {
        stars.rotation.y = elapsed * .003;
        nearStars.rotation.y = -elapsed * .006;

        bodyById.forEach(body => {
          if (body.planet) body.planet.rotation.y += .0015;

          if (body.glow) {
            body.glow.material.opacity =
              .32 + Math.sin(elapsed * .7) * .035;
          }
        });

        articleBodies.forEach(body => {
          const angle = body.angle + elapsed * body.orbitSpeed;

          body.group.position.set(
            body.parent.basePosition.x + Math.cos(angle) * body.orbitRadius,
            body.parent.basePosition.y + Math.sin(angle) * body.orbitRadius * .62,
            body.parent.basePosition.z + Math.sin(angle * 1.7) * 1.2
          );
        });

        comets.forEach(comet => {
          const t = (elapsed * comet.speed + comet.phase) % (Math.PI * 2);

          comet.group.position.set(
            Math.cos(t) * 25,
            Math.sin(t * 1.3) * 13,
            -10 - Math.sin(t) * 10
          );

          comet.group.rotation.z = Math.atan2(
            Math.cos(t * 1.3) * 13,
            -Math.sin(t) * 25
          );
        });

        sparkles.forEach((star, index) => {
          star.material.opacity =
            .15 + (Math.sin(elapsed * (1 + index % 4) + index) + 1) * .2;
        });
      }

      camera.position.z += (zoom - camera.position.z) * .06;

      // Project each planet into the HTML label layer.
      data.forEach(node => {
        const body = bodyById.get(node.id);
        const label = labelElements.get(node.id);

        if (!body || !label) return;

        projected.set(0, 0, 0);
        body.group.localToWorld(projected);
        projected.project(camera);

        const x = (projected.x * .5 + .5) * stage.clientWidth;
        const y = (-projected.y * .5 + .5) * stage.clientHeight;

        const visible =
          projected.z < 1 &&
          x > -100 &&
          x < stage.clientWidth + 100 &&
          y > -50 &&
          y < stage.clientHeight + 50;

        label.style.left = `${x}px`;
        label.style.top = `${y - (body.radius || .5) * 15 - 12}px`;
        label.style.opacity = visible ? '1' : '0';
        label.style.pointerEvents = visible ? 'auto' : 'none';
      });

      renderer.render(scene, camera);
    }

    animate();

    // Fade the loading screen away after the first render.
    requestAnimationFrame(() => {
      loading.classList.add('finished');

      setTimeout(() => {
        loading.remove();
      }, 900);
    });

    // Click directly on a 3D planet.
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();

    canvas.addEventListener('click', event => {
      if (dragging) return;

      const rect = canvas.getBoundingClientRect();

      pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(pointer, camera);

      const hits = raycaster.intersectObjects(bodyMeshes, false);

      if (hits.length) {
        const selected = [...bodyById.values()].find(
          body => body.planet === hits[0].object
        );

        if (selected) selectNode(selected.node);
      }
    });

    // Keep the scene working after Astro client-side navigation.
    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(animationFrame);
      resizeObserver.disconnect();
      renderer.dispose();
    }, { once: true });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    initialize();
  }

  document.addEventListener('astro:page-load', initialize);
})();
</script>
