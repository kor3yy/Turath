
---
const {
  acknowledgments,
  musicPosts = [],
  photographyPosts = [],
  latestArticle,
} = Astro.props;

function orbitPosts(posts, parent, cx, cy, rx, ry, startAngle = -90) {
  return posts.map((post, index) => {
    const angle =
      (startAngle + (360 / Math.max(posts.length, 1)) * index) *
      (Math.PI / 180);

    return {
      id: `${parent}-${index}`,
      parent,
      title: post.data.title,
      description: post.data.description || '',
      url: `/blog/${post.slug}/`,
      x: cx + Math.cos(angle) * rx,
      y: cy + Math.sin(angle) * ry,
      kind: 'article',
    };
  });
}

const nodes = [
  {
    id: 'turath',
    title: 'TURATH',
    description: 'An archive of culture, art, expression, and the people behind them.',
    x: 500,
    y: 350,
    kind: 'center',
  },
  {
    id: 'acknowledgments',
    title: 'ACKNOWLEDGMENTS',
    description: 'A personal dedication to the people and memories that will forever be part of Turath.',
    x: 500,
    y: 125,
    kind: 'feature',
    url: acknowledgments
      ? `/blog/${acknowledgments.slug}/`
      : '',
  },
  {
    id: 'music',
    title: 'MUSIC',
    description: 'Artists, sounds, perspectives, and the stories behind the music.',
    x: 770,
    y: 245,
    kind: 'category',
  },
  {
    id: 'photography',
    title: 'PHOTOGRAPHY',
    description: 'Stories told through images and the people behind the lens.',
    x: 230,
    y: 245,
    kind: 'category',
  },
  {
    id: 'about',
    title: 'ABOUT TURATH',
    description: 'The meaning, origins, and story behind Turath.',
    x: 500,
    y: 590,
    kind: 'about',
    url: '#about',
  },
  ...(latestArticle
    ? [{
        id: 'latest',
        title: 'LATEST ARTICLE',
        description: latestArticle.data.title,
        x: 790,
        y: 495,
        kind: 'feature',
        url: `/blog/${latestArticle.slug}/`,
      }]
    : []),
  ...orbitPosts(musicPosts, 'music', 770, 245, 165, 125),
  ...orbitPosts(photographyPosts, 'photography', 230, 245, 145, 105),
];

const edges = nodes
  .filter((node) => node.parent)
  .map((node) => ({
    from: nodes.find((item) => item.id === node.parent),
    to: node,
  }))
  .filter((edge) => edge.from && edge.to);

const mainEdges = [
  ['turath', 'acknowledgments'],
  ['turath', 'music'],
  ['turath', 'photography'],
  ['turath', 'about'],
  ...(latestArticle ? [['turath', 'latest']] : []),
].map(([from, to]) => ({
  from: nodes.find((node) => node.id === from),
  to: nodes.find((node) => node.id === to),
}));
---

<section class="turath-constellation" aria-label="Explore the Turath archive">
  <div class="constellation-heading">
    <span>AN INTERACTIVE ARCHIVE</span>
    <span>EXPLORE THE UNIVERSE OF TURATH</span>
  </div>

  <div class="constellation-search">
    <span aria-hidden="true">⌕</span>
    <input
      type="search"
      id="constellation-search-input"
      placeholder="Find an artist or story..."
      aria-label="Search the Turath constellation"
    />
    <span class="search-count" id="constellation-search-count"></span>
  </div>

  <svg
    class="constellation-map"
    id="constellation-map"
    viewBox="0 0 1000 700"
    role="group"
    aria-label="Interactive constellation map. Select a point to explore."
  >
    <g id="constellation-world">
      <g class="constellation-connections">
        {mainEdges.map(({ from, to }) => (
          <line
            x1={from.x}
            y1={from.y}
            x2={to.x}
            y2={to.y}
            class="constellation-line constellation-main-line"
          />
        ))}

        {edges.map(({ from, to }) => (
          <line
            x1={from.x}
            y1={from.y}
            x2={to.x}
            y2={to.y}
            class="constellation-line"
          />
        ))}
      </g>

      <g class="constellation-nodes">
        {nodes.map((node) => (
          <g
            class={`constellation-node constellation-node--${node.kind}`}
            transform={`translate(${node.x} ${node.y})`}
            tabindex="0"
            role="button"
            aria-label={`Explore ${node.title}`}
            data-id={node.id}
            data-title={node.title}
            data-description={node.description}
            data-url={node.url || ''}
            data-kind={node.kind}
            data-parent={node.parent || ''}
          >
            <circle class="node-halo" r={node.kind === 'center' ? 37 : 23} />
            <circle
              class="node-core"
              r={
                node.kind === 'center'
                  ? 13
                  : node.kind === 'category'
                    ? 9
                    : node.kind === 'feature'
                      ? 8
                      : 5
              }
            />
            <circle class="node-pulse" r={node.kind === 'center' ? 25 : 15} />
            <text
              class="node-label"
              text-anchor="middle"
              y={node.kind === 'center' ? 52 : 34}
            >
              {node.title}
            </text>
          </g>
        ))}
      </g>
    </g>
  </svg>

  <div class="constellation-instructions">
    <span><i></i> DRAG TO EXPLORE</span>
    <span><i></i> SCROLL TO ZOOM</span>
    <span><i></i> SELECT A POINT</span>
  </div>

  <aside class="constellation-detail" id="constellation-detail" aria-live="polite">
    <button
      class="constellation-close"
      id="constellation-close"
      type="button"
      aria-label="Close details"
    >×</button>

    <p class="detail-eyebrow" id="detail-eyebrow">DISCOVER TURATH</p>
    <h2 id="detail-title">A world of stories.</h2>
    <p id="detail-description">
      Explore the people, artists, images, and stories connected through Turath.
    </p>
    <div class="detail-links" id="detail-links"></div>
    <a class="detail-open-link" id="detail-open-link" href="#" hidden>
      OPEN STORY ↗
    </a>
  </aside>

  <div class="constellation-controls">
    <button type="button" id="constellation-reset" aria-label="Reset constellation">RESET VIEW</button>
    <span>01 — ∞</span>
  </div>
</section>

<style is:global>
  .turath-constellation {
    position: relative;
    z-index: 3;
    width: 100%;
    height: min(780px, calc(100svh - 80px));
    min-height: 570px;
    overflow: hidden;
    isolation: isolate;
    color: var(--page-text);
    background:
      radial-gradient(ellipse at center, rgb(0 0 0 / 10%), transparent 70%);
  }

  .constellation-heading {
    position: absolute;
    z-index: 4;
    top: 24px;
    left: 30px;
    right: 30px;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--page-text);
    font-size: 0.59rem;
    letter-spacing: 0.2em;
    opacity: 0.7;
    pointer-events: none;
  }

  .constellation-search {
    position: absolute;
    z-index: 5;
    top: 55px;
    right: 30px;
    display: flex;
    align-items: center;
    gap: 9px;
    width: min(270px, 36vw);
    padding: 10px 13px;
    border: 1px solid var(--border-color);
    border-radius: 30px;
    background: rgb(0 0 0 / 32%);
    color: white;
    backdrop-filter: blur(14px);
  }

  .constellation-search input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: white;
    font: inherit;
    font-size: 0.72rem;
  }

  .constellation-search input::placeholder {
    color: rgb(255 255 255 / 55%);
  }

  .search-count {
    font-size: 0.6rem;
    color: rgb(255 255 255 / 65%);
  }

  .constellation-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    touch-action: none;
    cursor: grab;
  }

  .constellation-map.is-dragging {
    cursor: grabbing;
  }

  #constellation-world {
    transform-origin: 500px 350px;
  }

  .constellation-line {
    stroke: rgb(255 255 255 / 30%);
    stroke-width: 1;
    stroke-dasharray: 3 8;
    vector-effect: non-scaling-stroke;
    transition: stroke 300ms ease, opacity 300ms ease;
  }

  .constellation-main-line {
    stroke: rgb(255 255 255 / 48%);
    stroke-width: 1.25;
    stroke-dasharray: 2 6;
  }

  .constellation-node {
    cursor: pointer;
    outline: none;
    transition: opacity 250ms ease;
  }

  .constellation-node .node-halo {
    fill: rgb(255 255 255 / 5%);
    stroke: rgb(255 255 255 / 12%);
    stroke-width: 1;
    transition: fill 300ms ease, stroke 300ms ease, r 300ms ease;
  }

  .constellation-node .node-core {
    fill: #fff;
    filter: drop-shadow(0 0 5px rgb(255 255 255 / 85%));
    transition: r 300ms ease, filter 300ms ease;
  }

  .constellation-node .node-pulse {
    fill: none;
    stroke: rgb(255 255 255 / 40%);
    stroke-width: 1;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .constellation-node--center .node-core {
    filter: drop-shadow(0 0 12px white);
  }

  .constellation-node--center .node-halo {
    fill: rgb(255 255 255 / 9%);
    stroke: rgb(255 255 255 / 35%);
  }

  .constellation-node--category .node-core {
    fill: #e5d1ae;
    filter: drop-shadow(0 0 8px rgb(229 209 174 / 85%));
  }

  .constellation-node:hover .node-halo,
  .constellation-node:focus-visible .node-halo,
  .constellation-node.is-selected .node-halo {
    fill: rgb(255 255 255 / 18%);
    stroke: rgb(255 255 255 / 85%);
  }

  .constellation-node:hover .node-core,
  .constellation-node:focus-visible .node-core,
  .constellation-node.is-selected .node-core {
    r: 12;
    filter: drop-shadow(0 0 14px white);
  }

  .constellation-node:hover .node-pulse,
  .constellation-node.is-selected .node-pulse {
    animation: constellation-pulse 2s ease-out infinite;
  }

  @keyframes constellation-pulse {
    0% { opacity: 0.7; transform: scale(0.7); }
    100% { opacity: 0; transform: scale(2.2); }
  }

  .node-label {
    fill: white;
    font-family: inherit;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.7px;
    paint-order: stroke;
    stroke: rgb(0 0 0 / 50%);
    stroke-width: 3px;
    stroke-linejoin: round;
    pointer-events: none;
    opacity: 0.85;
    transition: opacity 250ms ease;
  }

  .constellation-node--center .node-label {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 4px;
  }

  .constellation-node--article .node-label {
    font-size: 8px;
    letter-spacing: 0.8px;
  }

  .constellation-node.is-dimmed {
    opacity: 0.12;
  }

  .constellation-node.is-match .node-halo {
    stroke: #e5d1ae;
    fill: rgb(229 209 174 / 22%);
  }

  .constellation-connections line.is-highlighted {
    stroke: #e5d1ae;
    stroke-width: 1.8;
    stroke-dasharray: none;
  }

  .constellation-instructions {
    position: absolute;
    bottom: 25px;
    left: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    color: var(--page-text);
    font-size: 0.56rem;
    letter-spacing: 0.13em;
    opacity: 0.7;
    pointer-events: none;
  }

  .constellation-instructions span {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .constellation-instructions i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e5d1ae;
  }

  .constellation-detail {
    position: absolute;
    z-index: 6;
    top: 50%;
    right: 30px;
    width: min(310px, calc(100% - 60px));
    padding: 25px;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 12px;
    background: rgb(5 5 5 / 72%);
    color: white;
    backdrop-filter: blur(20px);
    box-shadow: 0 15px 60px rgb(0 0 0 / 25%);
    opacity: 0;
    visibility: hidden;
    transform: translate(15px, -45%);
    transition: opacity 300ms ease, transform 300ms ease, visibility 300ms ease;
  }

  .constellation-detail.is-open {
    opacity: 1;
    visibility: visible;
    transform: translate(0, -45%);
  }

  .constellation-close {
    position: absolute;
    top: 10px;
    right: 13px;
    border: 0;
    background: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
  }

  .detail-eyebrow {
    margin: 0 0 12px;
    color: #d8c4a3;
    font-size: 0.59rem;
    letter-spacing: 0.2em;
  }

  .constellation-detail h2 {
    margin: 0 0 12px;
    font-size: 1.65rem;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .constellation-detail > p:not(.detail-eyebrow) {
    margin: 0;
    color: rgb(255 255 255 / 70%);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .detail-links {
    display: grid;
    gap: 8px;
    margin-top: 17px;
  }

  .detail-links a {
    padding: 9px 0;
    border-bottom: 1px solid rgb(255 255 255 / 15%);
    color: white;
    font-size: 0.76rem;
    text-decoration: none;
    transition: color 200ms ease, padding 200ms ease;
  }

  .detail-links a:hover {
    padding-left: 5px;
    color: #e5d1ae;
  }

  .detail-open-link {
    display: inline-block;
    margin-top: 18px;
    color: #e5d1ae;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-decoration: none;
  }

  .detail-open-link[hidden] {
    display: none;
  }

  .constellation-controls {
    position: absolute;
    right: 30px;
    bottom: 25px;
    display: flex;
    align-items: center;
    gap: 20px;
    color: var(--page-text);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
    opacity: 0.7;
  }

  .constellation-controls button {
    padding: 7px 11px;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    background: rgb(0 0 0 / 25%);
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  @media (max-width: 650px) {
    .turath-constellation {
      height: 690px;
      min-height: 620px;
    }

    .constellation-heading {
      top: 18px;
      left: 15px;
      right: 15px;
      font-size: 0.48rem;
      letter-spacing: 0.1em;
    }

    .constellation-heading span:last-child {
      text-align: right;
    }

    .constellation-search {
      top: 50px;
      right: 15px;
      width: min(240px, calc(100% - 30px));
    }

    .constellation-map {
      top: 65px;
      height: calc(100% - 130px);
    }

    .constellation-detail {
      top: auto;
      right: 12px;
      bottom: 65px;
      left: 12px;
      width: auto;
      max-height: 42%;
      overflow-y: auto;
      transform: translateY(12px);
    }

    .constellation-detail.is-open {
      transform: translateY(0);
    }

    .constellation-instructions {
      bottom: 20px;
      left: 15px;
      gap: 9px;
      font-size: 0.45rem;
    }

    .constellation-instructions span {
      gap: 4px;
    }

    .constellation-controls {
      right: 15px;
      bottom: 16px;
      gap: 8px;
      font-size: 0.48rem;
    }

    .constellation-controls > span {
      display: none;
    }

    .node-label {
      font-size: 12px;
    }

    .constellation-node--article .node-label {
      font-size: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .constellation-node .node-pulse {
      animation: none !important;
    }
  }
</style>

<script>
  function initializeConstellation() {
    const section = document.querySelector('.turath-constellation');
    if (!(section instanceof HTMLElement)) return;
    if (section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    const svg = section.querySelector('#constellation-map');
    const world = section.querySelector('#constellation-world');
    const nodes = Array.from(section.querySelectorAll('.constellation-node'));
    const detail = section.querySelector('#constellation-detail');
    const title = section.querySelector('#detail-title');
    const description = section.querySelector('#detail-description');
    const eyebrow = section.querySelector('#detail-eyebrow');
    const links = section.querySelector('#detail-links');
    const openLink = section.querySelector('#detail-open-link');
    const search = section.querySelector('#constellation-search-input');
    const count = section.querySelector('#constellation-search-count');

    if (
      !(svg instanceof SVGSVGElement) ||
      !(world instanceof SVGGElement) ||
      !(detail instanceof HTMLElement) ||
      !(title instanceof HTMLElement) ||
      !(description instanceof HTMLElement) ||
      !(eyebrow instanceof HTMLElement) ||
      !(links instanceof HTMLElement) ||
      !(openLink instanceof HTMLAnchorElement) ||
      !(search instanceof HTMLInputElement) ||
      !(count instanceof HTMLElement)
    ) return;

    let selectedNode = null;
    let scale = 1;
    let panX = 0;
    let panY = 0;
    let dragging = false;
    let startX = 0;
    let startY = 0;
    let moved = false;

    const closePanel = () => {
      detail.classList.remove('is-open');
      nodes.forEach((node) => node.classList.remove('is-selected'));
      selectedNode = null;
    };

    const showNode = (node) => {
      if (!(node instanceof SVGGElement)) return;

      const kind = node.dataset.kind || '';
      const id = node.dataset.id || '';
      const nodeTitle = node.dataset.title || '';
      const nodeDescription = node.dataset.description || '';
      const url = node.dataset.url || '';

      if (kind === 'about') {
        document.querySelector('#about')?.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
        closePanel();
        return;
      }

      if (url && kind !== 'category' && kind !== 'center') {
        window.location.href = url;
        return;
      }

      nodes.forEach((item) => item.classList.remove('is-selected'));
      node.classList.add('is-selected');
      selectedNode = node;

      title.textContent = nodeTitle;
      description.textContent = nodeDescription;
      eyebrow.textContent =
        kind === 'center' ? 'THE ARCHIVE' : 'EXPLORE THE COLLECTION';

      links.replaceChildren();
      openLink.hidden = true;

      if (kind === 'category') {
        const children = nodes.filter(
          (item) => item.dataset.parent === id
        );

        children.forEach((child) => {
          const link = document.createElement('a');
          link.href = child.dataset.url || '#';
          link.textContent = `${child.dataset.title || 'Untitled'} ↗`;
          links.appendChild(link);
        });

        if (!children.length) {
          const empty = document.createElement('p');
          empty.textContent = 'More stories coming soon.';
          empty.style.color = 'rgba(255,255,255,.6)';
          empty.style.fontSize = '.8rem';
          links.appendChild(empty);
        }
      }

      if (kind === 'center') {
        const aboutLink = document.createElement('a');
        aboutLink.href = '#about';
        aboutLink.textContent = 'Discover the story behind Turath ↗';
        aboutLink.addEventListener('click', (event) => {
          event.preventDefault();
          document.querySelector('#about')?.scrollIntoView({
            behavior: 'smooth',
          });
          closePanel();
        });
        links.appendChild(aboutLink);
      }

      detail.classList.add('is-open');
    };

    nodes.forEach((node) => {
      node.addEventListener('click', () => {
        if (moved) return;
        showNode(node);
      });

      node.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          showNode(node);
        }
      });

      node.addEventListener('mouseenter', () => {
        const parent = node.dataset.id;
        section.querySelectorAll('.constellation-line').forEach((line) => {
          line.classList.remove('is-highlighted');
        });

        const related = nodes.filter(
          (item) =>
            item.dataset.parent === parent ||
            item.dataset.id === node.dataset.parent
        );

        related.forEach((item) => {
          const relatedId = item.dataset.id;
          section.querySelectorAll('.constellation-line').forEach((line) => {
            const x1 = line.getAttribute('x1');
            const y1 = line.getAttribute('y1');
            const x2 = line.getAttribute('x2');
            const y2 = line.getAttribute('y2');

            const nodeTransform = node.getAttribute('transform') || '';
            const itemTransform = item.getAttribute('transform') || '';

            if (
              (nodeTransform && itemTransform) &&
              (x1 !== null && y1 !== null && x2 !== null && y2 !== null)
            ) {
              const nodePoint = nodeTransform.match(/translate\(([^ ]+) ([^)]+)\)/);
              const itemPoint = itemTransform.match(/translate\(([^ ]+) ([^)]+)\)/);

              if (!nodePoint || !itemPoint) return;

              const match =
                (x1 === nodePoint[1] && y1 === nodePoint[2] &&
                  x2 === itemPoint[1] && y2 === itemPoint[2]) ||
                (x2 === nodePoint[1] && y2 === nodePoint[2] &&
                  x1 === itemPoint[1] && y1 === itemPoint[2]);

              if (match) line.classList.add('is-highlighted');
            }
          });
        });
      });
    });

    section.querySelector('#constellation-close')?.addEventListener('click', closePanel);

    search.addEventListener('input', () => {
      const query = search.value.trim().toLowerCase();
      let matches = 0;

      nodes.forEach((node) => {
        const match = (node.dataset.title || '').toLowerCase().includes(query);
        node.classList.toggle('is-dimmed', Boolean(query) && !match);
        node.classList.toggle('is-match', Boolean(query) && match);
        if (match) matches++;
      });

      count.textContent = query ? `${matches} FOUND` : '';
    });

    const applyTransform = () => {
      world.setAttribute(
        'transform',
        `translate(${panX} ${panY}) translate(500 350) scale(${scale}) translate(-500 -350)`
      );
    };

    svg.addEventListener('pointerdown', (event) => {
      if ((event.target instanceof Element) && event.target.closest('.constellation-node')) {
        return;
      }

      dragging = true;
      moved = false;
      startX = event.clientX - panX;
      startY = event.clientY - panY;
      svg.classList.add('is-dragging');
      svg.setPointerCapture(event.pointerId);
    });

    svg.addEventListener('pointermove', (event) => {
      if (!dragging) return;

      const nextX = event.clientX - startX;
      const nextY = event.clientY - startY;

      if (Math.abs(nextX - panX) + Math.abs(nextY - panY) > 3) {
        moved = true;
      }

      panX = nextX;
      panY = nextY;
      applyTransform();
    });

    const stopDragging = () => {
      dragging = false;
      svg.classList.remove('is-dragging');
      window.setTimeout(() => {
        moved = false;
      }, 0);
    };

    svg.addEventListener('pointerup', stopDragging);
    svg.addEventListener('pointercancel', stopDragging);

    svg.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault();
        scale = Math.min(2.3, Math.max(0.65, scale - event.deltaY * 0.001));
        applyTransform();
      },
      { passive: false }
    );

    section.querySelector('#constellation-reset')?.addEventListener('click', () => {
      scale = 1;
      panX = 0;
      panY = 0;
      applyTransform();
      search.value = '';
      search.dispatchEvent(new Event('input'));
      closePanel();
    });
  }

  document.addEventListener('astro:page-load', initializeConstellation);
  initializeConstellation();
</script>
