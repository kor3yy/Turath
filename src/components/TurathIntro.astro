<script is:inline>
  try {
    if (sessionStorage.getItem('turath-intro-seen') === 'yes') {
      document.documentElement.classList.add('turath-intro-seen');
    }
  } catch (e) {}
</script>

<div class="turath-intro" aria-hidden="true">
  <div class="turath-intro__word" lang="en" dir="ltr">turath</div>
</div>

<style is:global>
  .turath-intro {
    position: fixed;
    inset: 0;
    z-index: 1000000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: rgba(128, 128, 128, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.3s ease;
  }

  .turath-intro__word {
    font-family: serif;
    font-size: clamp(4rem, 13vw, 11rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--page-text, #fff);
  }

  .turath-intro.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  html.turath-intro-seen .turath-intro {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .turath-intro {
      display: none !important;
    }
  }
</style>

<script>
  const intro = document.querySelector('.turath-intro');
  const word = intro?.querySelector('.turath-intro__word');

  if (intro && word) {
    let alreadySeen = false;

    try {
      alreadySeen =
        sessionStorage.getItem('turath-intro-seen') === 'yes';
    } catch (e) {}

    if (alreadySeen) {
      intro.remove();
    } else {
      try {
        sessionStorage.setItem('turath-intro-seen', 'yes');
      } catch (e) {}

      const sequence = [
        ['turath', '#000', 'en'],
        ['تراث', '#fff', 'ar'],
        ['turath', '#fff', 'en'],
        ['تراث', '#000', 'ar'],
        ['turath', '#000', 'en'],
        ['تراث', '#fff', 'ar'],
        ['turath', '#fff', 'en'],
        ['تراث', '#000', 'ar'],
        ['turath', '#000', 'en'],
        ['تراث', '#fff', 'ar'],
        ['turath', '#fff', 'en'],
        ['تراث', '#000', 'ar'],
        ['turath', '#000', 'en'],
        ['تراث', '#fff', 'ar'],
        ['turath', '#fff', 'en'],
        ['تراث', '#000', 'ar'],
        ['turath', '#000', 'en'],
        ['تراث', '#fff', 'ar']
      ];

      let step = 0;

      const interval = window.setInterval(() => {
        if (!intro.isConnected) {
          window.clearInterval(interval);
          return;
        }

        const [text, color, language] = sequence[step];

        word.textContent = text;
        word.style.color = color;
        word.setAttribute('lang', language);
        word.setAttribute('dir', language === 'ar' ? 'rtl' : 'ltr');

        step++;

        if (step >= sequence.length) {
          window.clearInterval(interval);
          intro.classList.add('is-leaving');

          window.setTimeout(() => {
            intro.remove();
            document.documentElement.classList.add('turath-intro-seen');
          }, 300);
        }
      }, 50);
    }
  }
</script>
