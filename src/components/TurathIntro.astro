<script is:inline>
  try {
    if (sessionStorage.getItem('turath-intro-seen') === 'yes') {
      document.documentElement.classList.add('turath-intro-seen');
    }
  } catch (e) {}
</script>

<div class="turath-intro" aria-hidden="true">
  <div class="turath-intro__word" lang="ar" dir="rtl">تراث</div>
</div>

<style>
  .turath-intro {
    position: fixed;
    inset: 0;
    z-index: 1000000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    color: #fff;
    opacity: 1;
    visibility: visible;
    overflow: hidden;
    pointer-events: all;
    animation: turath-flashes 1s steps(1, end) both;
  }

  .turath-intro__word {
    font-family: serif;
    font-size: clamp(4rem, 13vw, 11rem);
    font-weight: 400;
    line-height: 1.3;
    color: #fff;
    opacity: 0;
    animation: turath-word 2.2s ease both;
    animation-delay: 0.8s;
  }

  .turath-intro::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    pointer-events: none;
    animation: turath-reveal 1.3s ease-in-out both;
    animation-delay: 1.7s;
  }

  .turath-intro-seen .turath-intro {
    display: none;
  }

  @keyframes turath-flashes {
    0%, 20%, 40%, 60%, 80% {
      background: #000;
    }
    10%, 30%, 50%, 70%, 90% {
      background: #fff;
    }
    100% {
      background: #000;
    }
  }

  @keyframes turath-word {
    0% {
      opacity: 0;
      filter: blur(18px);
      transform: scale(1.08);
    }
    25%, 65% {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
    100% {
      opacity: 0;
      filter: blur(30px);
      transform: scale(1.12);
    }
  }

  @keyframes turath-reveal {
    0% {
      opacity: 1;
      backdrop-filter: blur(0);
    }
    100% {
      opacity: 0;
      backdrop-filter: blur(18px);
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .turath-intro {
      animation: none;
      opacity: 0;
      visibility: hidden;
    }

    .turath-intro__word,
    .turath-intro::after {
      animation: none;
    }
  }
</style>

<script>
  const intro = document.querySelector('.turath-intro');

  if (intro && !document.documentElement.classList.contains('turath-intro-seen')) {
    try {
      sessionStorage.setItem('turath-intro-seen', 'yes');
    } catch (e) {}

    window.setTimeout(() => {
      intro.remove();
    }, 3200);
  }
</script>
