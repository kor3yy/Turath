---
---

<script is:inline>
  try {
    if (sessionStorage.getItem('turath-intro-seen') === 'yes') {
      document.documentElement.classList.add('turath-intro-seen');
    } else {
      document.documentElement.classList.add('turath-intro-playing');
    }
  } catch (e) {
    document.documentElement.classList.add('turath-intro-playing');
  }
</script>

<div class="turath-intro" aria-hidden="true">
  <div class="turath-intro__word" lang="en" dir="ltr">turath</div>
</div>

<style is:global>
  .turath-intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000000;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: rgba(128, 128, 128, 0.08);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  html.turath-intro-playing .turath-intro {
    display: flex;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    animation: turath-intro-failsafe 4s forwards;
  }

  .turath-intro__word {
    font-family: serif;
    font-size: clamp(4rem, 13vw, 11rem);
    font-weight: 400;
    line-height: 1.3;
    color: #fff;
  }

  html[data-theme="light"] .turath-intro__word,
  html[data-theme="light"] .turath-intro__word[style] {
    color: #000 !important;
  }

  @keyframes turath-intro-failsafe {
    0%, 75% {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    100% {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  html.turath-intro-seen .turath-intro {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .turath-intro {
      display: none !important;
    }
  }
</style>

<script>
  const intro = document.querySelector('.turath-intro');
  const word = intro?.querySelector('.turath-intro__word');

  if (intro && word) {
    const root = document.documentElement;
    const alreadySeen = root.classList.contains('turath-intro-seen');

    if (alreadySeen || !root.classList.contains('turath-intro-playing')) {
      intro.remove();
    } else {
      try {
        sessionStorage.setItem('turath-intro-seen', 'yes');
      } catch (e) {}

      const sequence = [
        ['turath', 'en'],
        ['تراث', 'ar'],
        ['turath', 'en'],
        ['تراث', 'ar'],
        ['turath', 'en'],
        ['تراث', 'ar'],
        ['turath', 'en'],
        ['تراث', 'ar'],
        ['turath', 'en'],
        ['تراث', 'ar'],
        ['turath', 'en'],
        ['تراث', 'ar'],
        ['turath', 'en'],
        ['تراث', 'ar'],
        ['turath', 'en'],
        ['تراث', 'ar'],
        ['turath', 'en'],
        ['تراث', 'ar']
      ];

      const updateTextColor = () => {
        const isLight = root.getAttribute('data-theme') === 'light';
        word.style.color = isLight ? '#000' : '#fff';
      };

      let step = 0;

      updateTextColor();

      const themeObserver = new MutationObserver(updateTextColor);
      themeObserver.observe(root, {
        attributes: true,
        attributeFilter: ['data-theme']
      });

      const interval = window.setInterval(() => {
        if (!intro.isConnected) {
          window.clearInterval(interval);
          themeObserver.disconnect();
          return;
        }

        const [text, language] = sequence[step];

        word.textContent = text;
        word.setAttribute('lang', language);
        word.setAttribute('dir', language === 'ar' ? 'rtl' : 'ltr');

        updateTextColor();

        step++;

        if (step >= sequence.length) {
          window.clearInterval(interval);
          themeObserver.disconnect();
          root.classList.remove('turath-intro-playing');
          root.classList.add('turath-intro-seen');
          intro.remove();
        }
      }, 100);

      window.setTimeout(() => {
        window.clearInterval(interval);
        themeObserver.disconnect();
        root.classList.remove('turath-intro-playing');
        root.classList.add('turath-intro-seen');
        intro.remove();
      }, 4200);
    }
  }
</script>
