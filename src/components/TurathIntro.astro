---

<script is:inline>
  try {
    if (sessionStorage.getItem('turath-intro-seen') === 'yes') {
      document.documentElement.classList.add('turath-intro-seen');
    } else {
      document.documentElement.classList.add('turath-intro-playing');
    }
  } catch (e) {
    document.documentElement.classList.add('turath-intro-playing');
  }
</script>

<div class="turath-intro" aria-hidden="true">
  <div class="turath-intro__word" lang="en" dir="ltr">turath</div>
</div>

<style is:global>
 @font-face {
  font-family: 'Queen Sheila Free';
  src: url('/fonts/queen-sheila-free.ttf') format('truetype');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

  .turath-intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000000;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: rgba(128, 128, 128, 0.08);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  html.turath-intro-playing .turath-intro {
    display: flex;
    visibility: visible;
    pointer-events: auto;
    animation: turath-intro-background 3.6s ease-in-out forwards;
  }

  .turath-intro__word {
    font-family: 'Queen Sheila Free', serif;
    font-size: clamp(5rem, 17vw, 15rem);
    font-weight: 400;
    line-height: 1.2;
    color: #fff;
    opacity: 0;
    filter: blur(18px);
    transform: scale(0.97);
    animation: turath-intro-word 3.6s ease-in-out forwards;
  }

  html[data-theme="light"] .turath-intro__word {
    color: #000;
  }

  @keyframes turath-intro-background {
    0% {
      opacity: 0;
      backdrop-filter: blur(0);
      -webkit-backdrop-filter: blur(0);
    }

    15% {
      opacity: 1;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    72% {
      opacity: 1;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    100% {
      opacity: 0;
      backdrop-filter: blur(0);
      -webkit-backdrop-filter: blur(0);
      visibility: hidden;
    }
  }

  @keyframes turath-intro-word {
    0% {
      opacity: 0;
      filter: blur(18px);
      transform: scale(0.97);
    }

    20% {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }

    72% {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }

    100% {
      opacity: 0;
      filter: blur(18px);
      transform: scale(1.03);
    }
  }

  html.turath-intro-seen .turath-intro {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .turath-intro {
      display: none !important;
    }
  }
</style>

<script>
  const intro = document.querySelector('.turath-intro');

  if (intro) {
    const root = document.documentElement;
    const alreadySeen = root.classList.contains('turath-intro-seen');

    if (alreadySeen || !root.classList.contains('turath-intro-playing')) {
      intro.remove();
    } else {
      try {
        sessionStorage.setItem('turath-intro-seen', 'yes');
      } catch (e) {}

      window.setTimeout(() => {
        root.classList.remove('turath-intro-playing');
        root.classList.add('turath-intro-seen');
        intro.remove();
      }, 3600);
    }
  }
</script>
