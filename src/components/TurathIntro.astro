---

<script is:inline>
  try {
    if (sessionStorage.getItem('turath-intro-seen') === 'yes') {
      document.documentElement.classList.add('turath-intro-seen');
    }
  } catch (e) {}
</script>

<div class="turath-intro" aria-hidden="true">
  <div class="turath-intro__word" lang="en" dir="ltr">turath</div>
</div>

<style>
  .turath-intro {
    position: fixed;
    inset: 0;
    z-index: 1000000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transition:
      opacity 0.35s ease,
      backdrop-filter 0.35s ease,
      -webkit-backdrop-filter 0.35s ease;
  }

  .turath-intro__word {
    font-family: serif;
    font-size: clamp(4rem, 13vw, 11rem);
    font-weight: 400;
    line-height: 1.3;
    color: #000;
    opacity: 1;
    transition: color 0.05s linear;
  }

  .turath-intro.is-leaving {
    opacity: 0;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    pointer-events: none;
  }

  .turath-intro-seen .turath-intro {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .turath-intro {
      display: none;
    }
  }
</style>

<script>
  const intro = document.querySelector('.turath-intro');
  const word = document.querySelector('.turath-intro__word');

  if (
    intro &&
    word &&
    !document.documentElement.classList.contains('turath-intro-seen')
  ) {
    let seenBefore = false;

    try {
      seenBefore =
        sessionStorage.getItem('turath-intro-seen') === 'yes';

      if (!seenBefore) {
        sessionStorage.setItem('turath-intro-seen', 'yes');
      }
    } catch (e) {}

    if (!seenBefore) {
      const sequence = [
        ['turath', '#000', 'en'],
        ['تراث', '#fff', 'ar'],
        ['turath', '#fff', 'en'],
        ['تراث', '#000', 'ar'],
        ['turath', '#000', 'en'],
        ['تراث', '#fff', 'ar'],
        ['turath', '#fff', 'en'],
        ['تراث', '#000', 'ar'],
        ['turath', '#000', 'en'],
        ['تراث', '#fff', 'ar'],
        ['turath', '#fff', 'en'],
        ['تراث', '#000', 'ar'],
        ['turath', '#000', 'en'],
        ['تراث', '#fff', 'ar'],
        ['turath', '#fff', 'en'],
        ['تراث', '#000', 'ar'],
        ['turath', '#000', 'en'],
        ['تراث', '#fff', 'ar']
      ];

      let step = 0;

      const interval = window.setInterval(() => {
        const [text, color, language] = sequence[step];

        word.textContent = text;
        word.style.color = color;
        word.lang = language;
        word.dir = language === 'ar' ? 'rtl' : 'ltr';

        step++;

        if (step >= sequence.length) {
          window.clearInterval(interval);

          window.setTimeout(() => {
            intro.classList.add('is-leaving');

            window.setTimeout(() => {
              intro.remove();
            }, 350);
          }, 100);
        }
      }, 500);
    }
  }
</script>
