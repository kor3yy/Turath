import { readdir } from 'node:fs/promises';
import path from 'node:path';

const publicDirectory = path.resolve(process.cwd(), 'public');
const backgroundDirectory = path.join(publicDirectory, 'background');

const imageExtensions = new Set([
  '.jpg',
  '.jpeg',
  '.png',
  '.webp',
  '.avif',
  '.gif',
]);

async function findImages(directory: string): Promise<string[]> {
  const images: string[] = [];

  try {
    const entries = await readdir(directory, { withFileTypes: true });

    for (const entry of entries) {
      const fullPath = path.join(directory, entry.name);

      if (entry.isDirectory()) {
        images.push(...(await findImages(fullPath)));
      } else if (
        entry.isFile() &&
        imageExtensions.has(path.extname(entry.name).toLowerCase())
      ) {
        const relativePath = path
          .relative(publicDirectory, fullPath)
          .split(path.sep)
          .map(encodeURIComponent)
          .join('/');

        images.push(`/${relativePath}`);
      }
    }
  } catch (error) {
    console.error('Unable to scan background images:', error);
  }

  return images;
  return [...new Set(images)];
}

const imagePaths = [...new Set(await findImages(backgroundDirectory))];
const imagePaths = await findImages(backgroundDirectory);

