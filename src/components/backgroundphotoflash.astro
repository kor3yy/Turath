---
import { readdir } from 'node:fs/promises';
import path from 'node:path';

const publicDirectory = path.resolve(process.cwd(), 'public');

const imageExtensions = new Set([
  '.jpg',
  '.jpeg',
  '.png',
  '.webp',
  '.avif',
  '.gif',
]);

async function findImages(directory) {
  const images = [];

  try {
    const entries = await readdir(directory, { withFileTypes: true });

    for (const entry of entries) {
      const fullPath = path.join(directory, entry.name);

      if (entry.isDirectory()) {
        images.push(...await findImages(fullPath));
      } else if (
        entry.isFile() &&
        imageExtensions.has(path.extname(entry.name).toLowerCase())
      ) {
        const relativePath = path
          .relative(publicDirectory, fullPath)
          .split(path.sep)
          .map(encodeURIComponent)
          .join('/');

        images.push(`/${relativePath}`);
      }
    }
  } catch (error) {
    console.error('Unable to scan public images:', error);
  }

  return [...images];
}

const imagePaths = [...new Set(await findImages(publicDirectory))];
---

{imagePaths.length > 0 && (
  <div
    class="turath-photo-background"
    data-images={JSON.stringify(imagePaths)}
    aria-hidden="true"
  >
    <div class="turath-photo-layer"></div>
    <div class="turath-photo-layer"></div>
  </div>
)}

<style is:global>
  .turath-photo-background {
    position: fixed;
    inset: -24px;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    filter: blur(18px);
    transform: scale(1.04);
  }

  .turath-photo-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    transition: opacity 100ms ease;
    will-change: opacity;
  }

  /* Quick flashes during the intro */
  .turath-photo-background.is-intro .turath-photo-layer.is-flashing {
    opacity: 0.7;
  }

  /* Smooth crossfades after the intro */
  .turath-photo-background.is-fading .turath-photo-layer {
    transition: opacity 1600ms ease-in-out;
  }

  .turath-photo-background.is-fading .turath-photo-layer.is-visible {
    opacity: 0.38;
  }

  body.home > header,
  body.home > main,
  body.home > footer {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .turath-photo-background {
      display: none !important;
    }
  }
</style>

<script>
  const photoBackground = document.querySelector('.turath-photo-background');

  if (photoBackground instanceof HTMLElement) {
    const imagePaths = JSON.parse(
      photoBackground.dataset.images || '[]'
    );

    const layers = Array.from(
      photoBackground.querySelectorAll('.turath-photo-layer')
    );

    const root = document.documentElement;
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    const wait = (milliseconds) =>
      new Promise((resolve) => window.setTimeout(resolve, milliseconds));

    const shuffle = (items) => {
      const result = [...items];

      for (let i = result.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [result[i], result[j]] = [result[j], result[i]];
      }

      return result;
    };

    let mode = root.classList.contains('turath-intro-playing')
      ? 'flash'
      : 'fade';

    let runId = 0;
    let currentLayer = 0;
    let previousImage = '';

    function setMode(nextMode) {
      if (mode === nextMode) return;

      mode = nextMode;
      runId++;

      photoBackground.classList.toggle('is-intro', mode === 'flash');
      photoBackground.classList.toggle('is-fading', mode === 'fade');

      layers.forEach((layer) => {
        layer.classList.remove('is-flashing');
      });

      if (mode === 'fade') {
        layers.forEach((layer) => {
          layer.classList.remove('is-visible');
        });
      }

      runAnimation(runId);
    }

    async function loadImage(src) {
      const image = new Image();
      image.src = src;

      try {
        await image.decode();
      } catch {
        // Keep the animation running even if an image cannot load.
      }

      return src;
    }

    function nextCycle() {
      const images = shuffle(imagePaths);

      if (
        images.length > 1 &&
        images[0] === previousImage
      ) {
        [images[0], images[1]] = [images[1], images[0]];
      }

      return images;
    }

    async function runAnimation(id) {
      if (
        imagePaths.length === 0 ||
        reducedMotion.matches ||
        !photoBackground.isConnected
      ) {
        return;
      }

      if (mode === 'flash') {
        photoBackground.classList.add('is-intro');
        photoBackground.classList.remove('is-fading');

        let images = nextCycle();
        let index = 0;

        while (
          id === runId &&
          mode === 'flash' &&
          photoBackground.isConnected
        ) {
          if (index >= images.length) {
            await wait(180);

            if (id !== runId || mode !== 'flash') return;

            images = nextCycle();
            index = 0;
          }

          const src = await loadImage(images[index++]);

          if (id !== runId || mode !== 'flash') return;

          const layer = layers[0];
          layer.style.backgroundImage = `url("${src}")`;
          layer.classList.add('is-flashing');

          previousImage = src;

          await wait(130);

          if (id !== runId || mode !== 'flash') return;

          layer.classList.remove('is-flashing');

          await wait(250);
        }

        return;
      }

      photoBackground.classList.remove('is-intro');
      photoBackground.classList.add('is-fading');

      let images = nextCycle();
      let index = 0;

      // Start with one photo visible, then crossfade to the next.
      const firstSrc = await loadImage(images[index++]);

      if (id !== runId || mode !== 'fade') return;

      currentLayer = 0;
      layers[0].style.backgroundImage = `url("${firstSrc}")`;
      layers[0].classList.add('is-visible');
      previousImage = firstSrc;

      await wait(2200);

      while (
        id === runId &&
        mode === 'fade' &&
        photoBackground.isConnected
      ) {
        if (index >= images.length) {
          images = nextCycle();
          index = 0;
        }

        const src = await loadImage(images[index++]);

        if (id !== runId || mode !== 'fade') return;

        const nextLayer = 1 - currentLayer;

        layers[nextLayer].style.backgroundImage = `url("${src}")`;

        // Ensure the incoming layer starts transparent before fading in.
        layers[nextLayer].classList.remove('is-visible');
        void layers[nextLayer].offsetWidth;
        layers[nextLayer].classList.add('is-visible');

        layers[currentLayer].classList.remove('is-visible');

        currentLayer = nextLayer;
        previousImage = src;

        await wait(2200);
      }
    }

    photoBackground.classList.add(
      mode === 'flash' ? 'is-intro' : 'is-fading'
    );

    const introObserver = new MutationObserver(() => {
      if (!root.classList.contains('turath-intro-playing')) {
        setMode('fade');
        introObserver.disconnect();
      }
    });

    if (mode === 'flash') {
      introObserver.observe(root, {
        attributes: true,
        attributeFilter: ['class'],
      });
    }

    runAnimation(runId);

    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) {
        runId++;
        photoBackground.style.display = 'none';
      } else {
        photoBackground.style.display = '';
        runId++;
        runAnimation(runId);
      }
    });
  }
</script>
