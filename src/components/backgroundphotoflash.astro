---
import { readdir } from 'node:fs/promises';
import path from 'node:path';

const publicDirectory = path.resolve(process.cwd(), 'public');
const backgroundDirectory = path.join(publicDirectory, 'backgrounds');

const imageExtensions = new Set([
  '.jpg',
  '.jpeg',
  '.png',
  '.webp',
  '.avif',
  '.gif',
]);

async function findImages(directory) {
  const images = [];

  try {
    const entries = await readdir(directory, { withFileTypes: true });

    for (const entry of entries) {
      const fullPath = path.join(directory, entry.name);

      if (entry.isDirectory()) {
        images.push(...await findImages(fullPath));
      } else if (
        entry.isFile() &&
        imageExtensions.has(path.extname(entry.name).toLowerCase())
      ) {
        const relativePath = path
          .relative(publicDirectory, fullPath)
          .split(path.sep)
          .map(encodeURIComponent)
          .join('/');

        images.push(`/${relativePath}`);
      }
    }
  } catch (error) {
    console.error('Unable to scan background images:', error);
  }

  return images;
}

const imagePaths = [...new Set(await findImages(backgroundDirectory))];
---

{imagePaths.length > 0 && (
  <div
    class="turath-photo-background"
    data-images={JSON.stringify(imagePaths)}
    aria-hidden="true"
  >
    <div class="turath-photo-layer"></div>
    <div class="turath-photo-layer"></div>
  </div>
)}

<style is:global>
  .turath-photo-background {
    position: fixed;
    inset: -24px;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    filter: blur(18px);
    transform: scale(1.04);
  }

  .turath-photo-layer {
    position: absolute;
    inset: 0;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    opacity: 0;
    transition: opacity 1.4s ease;
    will-change: opacity;
  }

  .turath-photo-background.is-flashing .turath-photo-layer {
    transition: opacity 80ms linear;
  }

  .turath-photo-background.is-flashing .turath-photo-layer.is-visible {
    opacity: 0.7;
  }

  .turath-photo-background.is-fading .turath-photo-layer.is-visible {
    opacity: 0.38;
  }

  body.home > header,
  body.home > main,
  body.home > footer {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .turath-photo-background {
      display: none !important;
    }
  }
</style>

<script>
  const background = document.querySelector('.turath-photo-background');

  if (background instanceof HTMLElement) {
    const imagePaths = JSON.parse(background.dataset.images || '[]');
    const layers = Array.from(
      background.querySelectorAll('.turath-photo-layer')
    );

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    let runId = 0;
    let mode = '';
    let activeLayer = 0;

    const wait = (ms) =>
      new Promise((resolve) => window.setTimeout(resolve, ms));

    const shuffle = (items) => {
      const result = [...items];

      for (let i = result.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [result[i], result[j]] = [result[j], result[i]];
      }

      return result;
    };

    async function loadImage(src) {
      const image = new Image();
      image.src = src;

      try {
        await image.decode();
      } catch {
        // Skip waiting if an image cannot be decoded.
      }
    }

    async function runFlashes(id) {
      background.classList.add('is-flashing');
      background.classList.remove('is-fading');

      layers.forEach((layer) => {
        layer.classList.remove('is-visible');
      });

      while (
        background.isConnected &&
        id === runId &&
        mode === 'flash' &&
        !reducedMotion.matches
      ) {
        for (const src of shuffle(imagePaths)) {
          if (id !== runId || mode !== 'flash') return;

          await loadImage(src);

          if (id !== runId || mode !== 'flash') return;

          const layer = layers[0];
          layer.style.backgroundImage = `url("${src}")`;
          layer.classList.add('is-visible');

          await wait(150);

          if (id !== runId || mode !== 'flash') return;

          layer.classList.remove('is-visible');
          await wait(100);
        }
      }
    }

    async function runFades(id) {
      background.classList.remove('is-flashing');
      background.classList.add('is-fading');

      layers.forEach((layer) => {
        layer.classList.remove('is-visible');
      });

      let index = 0;

      while (
        background.isConnected &&
        id === runId &&
        mode === 'fade' &&
        !reducedMotion.matches
      ) {
        const src = imagePaths[index % imagePaths.length];
        const nextLayerIndex = activeLayer === 0 ? 1 : 0;
        const nextLayer = layers[nextLayerIndex];

        await loadImage(src);

        if (id !== runId || mode !== 'fade') return;

        nextLayer.style.backgroundImage = `url("${src}")`;
        nextLayer.classList.add('is-visible');

        await wait(1800);

        if (id !== runId || mode !== 'fade') return;

        layers[activeLayer].classList.remove('is-visible');
        activeLayer = nextLayerIndex;
        index++;

        await wait(200);
      }
    }

    function setMode(nextMode) {
      if (nextMode === mode || reducedMotion.matches) return;

      mode = nextMode;
      const id = ++runId;

      if (mode === 'flash') {
        runFlashes(id);
      } else {
        runFades(id);
      }
    }

    if (imagePaths.length > 0) {
      const root = document.documentElement;

      const updateMode = () => {
        if (reducedMotion.matches) return;

        if (root.classList.contains('turath-intro-playing')) {
          setMode('flash');
        } else {
          setMode('fade');
        }
      };

      const observer = new MutationObserver(updateMode);

      observer.observe(root, {
        attributes: true,
        attributeFilter: ['class'],
      });

      reducedMotion.addEventListener('change', () => {
        if (!reducedMotion.matches) {
          mode = '';
          updateMode();
        } else {
          runId++;
          mode = '';
          background.classList.remove('is-visible', 'is-flashing', 'is-fading');
          layers.forEach((layer) => layer.classList.remove('is-visible'));
        }
      });

      updateMode();
    }
  }
</script>
