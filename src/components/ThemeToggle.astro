
<button
  class="theme-toggle"
  type="button"
  aria-label="Switch to light mode"
  title="Switch theme"
>
  <span class="theme-icon" aria-hidden="true">☼</span>
</button>

<script>
  function initializeTheme() {
    const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
    const icon = document.querySelector<HTMLElement>('.theme-icon');

    function setTheme(theme: 'dark' | 'light') {
      document.documentElement.setAttribute('data-theme', theme);

      if (icon) {
        icon.textContent = theme === 'dark' ? '☼' : '☾';
      }

      button?.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
      );
    }

    let savedTheme: 'dark' | 'light' = 'dark';

    try {
      savedTheme =
        localStorage.getItem('turath-theme') === 'light' ? 'light' : 'dark';
    } catch {}

    setTheme(savedTheme);

    button?.addEventListener('click', () => {
      const nextTheme =
        document.documentElement.getAttribute('data-theme') === 'dark'
          ? 'light'
          : 'dark';

      setTheme(nextTheme);

      try {
        localStorage.setItem('turath-theme', nextTheme);
      } catch {}
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeTheme, { once: true });
  } else {
    initializeTheme();
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border-color, #333);
    border-radius: 50%;
    background: var(--surface-bg, #111);
    color: var(--page-text, #fff);
    cursor: pointer;
    font-size: 21px;
  }
</style>
