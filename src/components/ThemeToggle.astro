
<button
  class="theme-toggle"
  type="button"
  aria-label="Switch to light mode"
  title="Switch theme"
>
  <span class="theme-icon" aria-hidden="true">☼</span>
</button>

<script>
  const root = document.documentElement;
  const storageKey = 'turath-theme';

  function applyTheme(theme: 'dark' | 'light', save = false) {
    root.setAttribute('data-theme', theme);

    if (save) {
      try {
        localStorage.setItem(storageKey, theme);
      } catch {}
    }

    document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
      const icon = button.querySelector<HTMLElement>('.theme-icon');

      if (icon) {
        icon.textContent = theme === 'dark' ? '☼' : '☾';
      }

      button.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
      );

      button.setAttribute(
        'title',
        theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
      );
    });
  }

  function initializeTheme() {
    let theme: 'dark' | 'light' = 'dark';

    try {
      const saved = localStorage.getItem(storageKey);

      if (saved === 'light' || saved === 'dark') {
        theme = saved;
      }
    } catch {}

    applyTheme(theme);
  }

  if (!root.dataset.themeToggleListener) {
    root.dataset.themeToggleListener = 'true';

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;

      const button = event.target.closest('.theme-toggle');

      if (!button) return;

      const current = root.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';

      applyTheme(next, true);
    });
  }

  initializeTheme();

  document.addEventListener('astro:page-load', initializeTheme);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border: 1px solid var(--border-color, #333);
    border-radius: 50%;
    background: var(--surface-bg, #111);
    color: var(--page-text, #fff);
    cursor: pointer;
    font-size: 21px;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .theme-toggle:hover {
    border-color: var(--page-text, #fff);
  }
</style>
