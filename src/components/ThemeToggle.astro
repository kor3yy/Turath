
<button
  class="theme-toggle"
  type="button"
  aria-label="Switch to light mode"
  title="Switch theme"
>
  <span class="theme-icon" aria-hidden="true">☼</span>
</button>

<script>
  function initializeTheme() {
    const root = document.documentElement;

    let savedTheme: 'dark' | 'light' = 'dark';

    try {
      savedTheme =
        localStorage.getItem('turath-theme') === 'light' ? 'light' : 'dark';
    } catch {}

    function setTheme(theme: 'dark' | 'light', save = false) {
      root.setAttribute('data-theme', theme);

      if (save) {
        try {
          localStorage.setItem('turath-theme', theme);
        } catch {}
      }

      document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
        const icon = button.querySelector<HTMLElement>('.theme-icon');

        if (icon) {
          icon.textContent = theme === 'dark' ? '☼' : '☾';
        }

        button.setAttribute(
          'aria-label',
          theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
        );
      });
    }

    setTheme(savedTheme);

    // Register only once, even when Astro navigates between pages.
    if (!document.documentElement.dataset.themeToggleInitialized) {
      document.documentElement.dataset.themeToggleInitialized = 'true';

      document.addEventListener('click', (event) => {
        const target = event.target;

        if (!(target instanceof Element)) return;

        const button = target.closest<HTMLButtonElement>('.theme-toggle');

        if (!button) return;

        const nextTheme =
          root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';

        setTheme(nextTheme, true);
      });
    }
  }

  initializeTheme();

  document.addEventListener('astro:page-load', initializeTheme);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border-color, #333);
    border-radius: 50%;
    background: var(--surface-bg, #111);
    color: var(--page-text, #fff);
    cursor: pointer;
    font-size: 21px;
  }
</style>
