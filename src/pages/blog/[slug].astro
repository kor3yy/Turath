
---
import { getCollection } from 'astro:content';
import LiquidCursor from '../../components/LiquidCursor.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{post.data.title} — Turath</title>
    <meta name="description" content={post.data.description} />

    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:type" content="article" />
    <meta
      property="og:url"
      content={`https://tturatth.com/blog/${post.slug}/`}
    />

    {post.data.thumbnail && (
      <meta
        property="og:image"
        content={`https://tturatth.com${post.data.thumbnail}`}
      />
    )}

    <link rel="stylesheet" href="/styles/global.css" />

    <style>
      /* Remove the article card border */
      .post-article {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        position: relative;
        isolation: isolate;
      }

      /* Cinematic featured image opening */
      .article-opening-image {
        position: relative;
        width: 100%;
        margin: 1.5rem 0 2.5rem;
        overflow: hidden;
        border-radius: 12px;
        background: var(--surface-bg, #111);
        animation: image-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
        box-shadow: 0 0 65px rgba(255, 255, 255, 0.055);
      }

      .article-opening-image img {
        display: block;
        width: 100%;
        max-height: 580px;
        object-fit: cover;
        animation: image-zoom 1.8s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      /* Title and date reveal */
      .post-article > h1 {
        animation: text-reveal 900ms cubic-bezier(0.16, 1, 0.3, 1) 250ms both;
      }

      .post-article > .post-date {
        animation: text-reveal 800ms ease 450ms both;
      }

      .post-article > .back-link {
        display: inline-block;
        animation: text-reveal 700ms ease 150ms both;
      }

      /* Article body reveal */
      .article-body {
        animation: text-reveal 900ms cubic-bezier(0.16, 1, 0.3, 1) 550ms both;
      }

      .article-body > * {
        animation: paragraph-reveal 800ms cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: var(--reveal-delay, 650ms);
      }

      /* Cinematic image reveal */
      @keyframes image-reveal {
        from {
          opacity: 0;
          clip-path: inset(8% 0 8% 0 round 12px);
          transform: translateY(24px);
        }

        to {
          opacity: 1;
          clip-path: inset(0 0 0 0 round 12px);
          transform: translateY(0);
        }
      }

      @keyframes image-zoom {
        from {
          transform: scale(1.09);
          filter: brightness(0.65);
        }

        to {
          transform: scale(1);
          filter: brightness(1);
        }
      }

      @keyframes text-reveal {
        from {
          opacity: 0;
          transform: translateY(20px);
          filter: blur(5px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @keyframes paragraph-reveal {
        from {
          opacity: 0;
          transform: translateY(14px);
          filter: blur(3px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      /* Subtle animated film grain */
      .post-article::before {
        content: "";
        position: fixed;
        inset: -50%;
        z-index: 10;
        pointer-events: none;
        opacity: 0.045;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
        animation: film-grain 0.22s steps(2) infinite;
      }

      @keyframes film-grain {
        0% {
          transform: translate(0, 0);
        }

        25% {
          transform: translate(-1%, 1%);
        }

        50% {
          transform: translate(1%, -1%);
        }

        75% {
          transform: translate(-1%, -1%);
        }

        100% {
          transform: translate(1%, 1%);
        }
      }

      /* Soft vignette around the screen edges */
      body::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 9;
        pointer-events: none;
        background: radial-gradient(
          ellipse at center,
          transparent 48%,
          rgba(0, 0, 0, 0.07) 76%,
          rgba(0, 0, 0, 0.2) 100%
        );
      }

      /* Mobile adjustments */
      @media (max-width: 650px) {
        .article-opening-image {
          margin: 1.25rem 0 2rem;
          border-radius: 8px;
          box-shadow: 0 0 30px rgba(255, 255, 255, 0.04);
        }

        .article-opening-image img {
          max-height: 380px;
        }

        .post-article::before {
          opacity: 0.03;
        }

        body::after {
          background: radial-gradient(
            ellipse at center,
            transparent 58%,
            rgba(0, 0, 0, 0.12) 100%
          );
        }
      }

      /* Respect reduced-motion preferences */
      @media (prefers-reduced-motion: reduce) {
        .article-opening-image,
        .article-opening-image img,
        .post-article > h1,
        .post-article > .post-date,
        .post-article > .back-link,
        .article-body,
        .article-body > * {
          animation: none !important;
          clip-path: none !important;
          filter: none !important;
          transform: none !important;
          opacity: 1 !important;
        }

        .post-article::before {
          animation: none !important;
        }
      }
    </style>
  </head>

  <body>
    <LiquidCursor />

    <header>
      <nav>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main>
      <article class="post-article">
        <a href="/blog" class="back-link">&larr; Back to posts</a>

        {post.data.thumbnail && (
          <div class="article-opening-image">
            <img
              src={post.data.thumbnail}
              alt={post.data.title}
              fetchpriority="high"
            />
          </div>
        )}

        <h1>{post.data.title}</h1>

        <p class="post-date">
          {post.data.pubDate?.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </p>

        <div class="article-body">
          <Content />
        </div>
      </article>
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Turath. All rights reserved.</p>
    </footer>

    <script>
      const articleBody = document.querySelector('.article-body');

      if (
        articleBody &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        Array.from(articleBody.children).forEach((element, index) => {
          element.style.setProperty(
            '--reveal-delay',
            `${650 + Math.min(index, 8) * 100}ms`
          );
        });
      }
    </script>
  </body>
</html>
