
---
import { getCollection } from 'astro:content';
import LiquidCursor from '../../components/LiquidCursor.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const isAcknowledgments = post.data.title === 'Acknowledgments';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{post.data.title} — Turath</title>
    <meta name="description" content={post.data.description} />

    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:type" content="article" />
    <meta
      property="og:url"
      content={`https://tturatth.com/blog/${post.slug}/`}
    />
    {post.data.thumbnail && (
      <meta
        property="og:image"
        content={`https://tturatth.com${post.data.thumbnail}`}
      />
    )}

    <link rel="stylesheet" href="/styles/global.css" />
  </head>

  <body>
    <LiquidCursor />

    <header>
      <nav>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main>
      <article class:list={['post-article', isAcknowledgments && 'acknowledgments-glow']}>
        <a href="/blog" class="back-link">&larr; Back to posts</a>

        <h1>{post.data.title}</h1>

        <p class="post-date">
          {post.data.pubDate?.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </p>

        <Content />
      </article>
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Turath. All rights reserved.</p>
    </footer>
  </body>
</html>

<style is:global>
  .acknowledgments-glow {
    position: relative;
    isolation: isolate;
    border: 1px solid var(--border-color, #333);
    border-radius: 14px;
    overflow: hidden;
  }

  .acknowledgments-glow::before {
    content: "";
    position: absolute;
    inset: 0;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 285deg,
      var(--beam-color, #fff) 330deg,
      transparent 360deg
    );
    animation: acknowledgments-beam 4s linear infinite;

    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;

    pointer-events: none;
    z-index: 2;
  }

  :root {
    --beam-color: #fff;
  }

  :root[data-theme="light"] {
    --beam-color: #000;
  }

  @keyframes acknowledgments-beam {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .acknowledgments-glow::before {
      animation: none;
    }
  }
</style>
