
---
import { getCollection } from 'astro:content';
import LiquidCursor from '../../components/LiquidCursor.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const allPosts = await getCollection('blog');

const relatedPosts = allPosts
  .filter((item) => item.slug !== post.slug)
  .sort(
    (a, b) =>
      (b.data.pubDate?.valueOf() ?? 0) -
      (a.data.pubDate?.valueOf() ?? 0)
  )
  .slice(0, 3);

const wordCount = (post.body ?? '')
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;

const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{post.data.title} — Turath</title>
    <meta name="description" content={post.data.description} />

    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:type" content="article" />
    <meta
      property="og:url"
      content={`https://tturatth.com/blog/${post.slug}/`}
    />

    {post.data.thumbnail && (
      <meta
        property="og:image"
        content={`https://tturatth.com${post.data.thumbnail}`}
      />
    )}

    <link rel="stylesheet" href="/styles/global.css" />

    <style>
      /* Keep the article card borderless */
      .post-article {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        position: relative;
        isolation: isolate;
      }

      /* Reading progress */
      .reading-progress-track {
        position: fixed;
        inset: 0 0 auto;
        height: 3px;
        z-index: 1001;
        pointer-events: none;
        background: transparent;
      }

      .reading-progress-bar {
        width: 100%;
        height: 100%;
        transform: scaleX(0);
        transform-origin: left;
        background: currentColor;
        will-change: transform;
      }

      /* Reading time */
      .reading-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin: 0.5rem 0 1.75rem;
        font-size: 0.8rem;
        opacity: 0.65;
      }

      .reading-meta .meta-dot {
        opacity: 0.5;
      }

      /* Cinematic article opening */
      .article-opening-image {
        position: relative;
        width: 100%;
        margin: 1.5rem 0 2.5rem;
        overflow: hidden;
        border-radius: 12px;
        background: var(--surface-bg, #111);
        animation: image-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
        box-shadow: 0 0 65px rgba(255, 255, 255, 0.055);
      }

      .article-opening-image img {
        display: block;
        width: 100%;
        max-height: 580px;
        object-fit: cover;
        animation: image-zoom 1.8s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      .post-article > h1 {
        animation: text-reveal 900ms cubic-bezier(0.16, 1, 0.3, 1) 250ms both;
      }

      .post-article > .post-date {
        animation: text-reveal 800ms ease 450ms both;
      }

      .post-article > .back-link {
        display: inline-block;
        animation: text-reveal 700ms ease 150ms both;
      }

      .article-body {
        animation: text-reveal 900ms cubic-bezier(0.16, 1, 0.3, 1) 550ms both;
      }

      .article-body > * {
        animation: paragraph-reveal 800ms cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: var(--reveal-delay, 650ms);
      }

      /* Clickable article photographs */
      .article-body img,
      .article-opening-image img {
        cursor: zoom-in;
      }

      .article-body img {
        transition: opacity 250ms ease;
      }

      .article-body img:hover {
        opacity: 0.88;
      }

      /* Image viewer */
      .image-viewer {
        width: min(1100px, calc(100% - 32px));
        max-width: none;
        max-height: 90dvh;
        padding: 0;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        overflow: hidden;
        color: #fff;
        background: rgba(12, 12, 12, 0.97);
      }

      .image-viewer::backdrop {
        background: rgba(0, 0, 0, 0.9);
        backdrop-filter: blur(12px);
      }

      .image-viewer[open] {
        animation: viewer-enter 260ms ease both;
      }

      .viewer-layout {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        max-height: 90dvh;
      }

      .viewer-image-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 160px;
        max-height: calc(90dvh - 80px);
        padding: 48px 16px 12px;
      }

      .viewer-image {
        display: block;
        max-width: 100%;
        max-height: calc(90dvh - 150px);
        width: auto;
        height: auto;
        object-fit: contain;
      }

      .viewer-caption {
        width: 100%;
        padding: 10px 18px 16px;
        text-align: center;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.75);
      }

      .viewer-close,
      .viewer-nav {
        position: absolute;
        z-index: 2;
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 50%;
        color: white;
        background: rgba(0, 0, 0, 0.55);
        cursor: pointer;
        font-size: 1.25rem;
        transition: background 180ms ease, transform 180ms ease;
      }

      .viewer-close:hover,
      .viewer-nav:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: scale(1.05);
      }

      .viewer-close {
        top: 10px;
        right: 10px;
      }

      .viewer-nav {
        top: 50%;
        transform: translateY(-50%);
      }

      .viewer-nav:hover {
        transform: translateY(-50%) scale(1.05);
      }

      .viewer-prev {
        left: 10px;
      }

      .viewer-next {
        right: 10px;
      }

      .viewer-counter {
        position: absolute;
        top: 20px;
        left: 16px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.75rem;
      }

      /* Related stories */
      .related-stories {
        margin: 5rem 0 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border-color, rgba(128, 128, 128, 0.3));
      }

      .related-heading {
        margin: 0 0 0.5rem;
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        letter-spacing: -0.035em;
      }

      .related-intro {
        margin: 0 0 1.75rem;
        opacity: 0.65;
        font-size: 0.9rem;
      }

      .related-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .related-card {
        display: flex;
        min-width: 0;
        flex-direction: column;
        color: inherit;
        text-decoration: none;
        border-radius: 8px;
        overflow: hidden;
      }

      .related-card-image {
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: rgba(128, 128, 128, 0.1);
        border-radius: 8px;
      }

      .related-card-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1),
          opacity 300ms ease;
      }

      .related-card:hover .related-card-image img {
        transform: scale(1.045);
        opacity: 0.85;
      }

      .related-card-title {
        margin: 0.85rem 0 0.35rem;
        font-size: 1rem;
        line-height: 1.4;
        font-weight: 600;
        transition: opacity 180ms ease;
      }

      .related-card:hover .related-card-title {
        opacity: 0.7;
      }

      .related-card-date {
        margin: 0;
        font-size: 0.75rem;
        opacity: 0.6;
      }

      .related-card-no-image {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        font-size: 1.5rem;
        opacity: 0.4;
      }

      /* Cinematic atmosphere: film grain */
      .post-article::before {
        content: "";
        position: fixed;
        inset: -50%;
        z-index: 10;
        pointer-events: none;
        opacity: 0.045;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
        animation: film-grain 0.22s steps(2) infinite;
      }

      @keyframes film-grain {
        0% { transform: translate(0, 0); }
        25% { transform: translate(-1%, 1%); }
        50% { transform: translate(1%, -1%); }
        75% { transform: translate(-1%, -1%); }
        100% { transform: translate(1%, 1%); }
      }

      /* Screen-edge vignette */
      body::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 9;
        pointer-events: none;
        background: radial-gradient(
          ellipse at center,
          transparent 48%,
          rgba(0, 0, 0, 0.07) 76%,
          rgba(0, 0, 0, 0.2) 100%
        );
      }

      @keyframes viewer-enter {
        from {
          opacity: 0;
          transform: scale(0.97);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      /* Existing opening animations */
      @keyframes image-reveal {
        from {
          opacity: 0;
          clip-path: inset(8% 0 8% 0 round 12px);
          transform: translateY(24px);
        }
        to {
          opacity: 1;
          clip-path: inset(0 0 0 0 round 12px);
          transform: translateY(0);
        }
      }

      @keyframes image-zoom {
        from {
          transform: scale(1.09);
          filter: brightness(0.65);
        }
        to {
          transform: scale(1);
          filter: brightness(1);
        }
      }

      @keyframes text-reveal {
        from {
          opacity: 0;
          transform: translateY(20px);
          filter: blur(5px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @keyframes paragraph-reveal {
        from {
          opacity: 0;
          transform: translateY(14px);
          filter: blur(3px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @media (max-width: 650px) {
        .article-opening-image {
          margin: 1.25rem 0 2rem;
          border-radius: 8px;
          box-shadow: 0 0 30px rgba(255, 255, 255, 0.04);
        }

        .article-opening-image img {
          max-height: 380px;
        }

        .post-article::before {
          opacity: 0.03;
        }

        body::after {
          background: radial-gradient(
            ellipse at center,
            transparent 58%,
            rgba(0, 0, 0, 0.12) 100%
          );
        }

        .related-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 1rem;
        }

        .viewer-image-wrap {
          padding: 54px 8px 8px;
        }

        .viewer-nav {
          top: auto;
          bottom: 8px;
          transform: none;
        }

        .viewer-nav:hover {
          transform: scale(1.05);
        }

        .viewer-prev {
          left: 12px;
        }

        .viewer-next {
          right: 12px;
        }

        .viewer-caption {
          padding-bottom: 58px;
        }
      }

      @media (max-width: 380px) {
        .related-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .article-opening-image,
        .article-opening-image img,
        .post-article > h1,
        .post-article > .post-date,
        .post-article > .back-link,
        .article-body,
        .article-body > *,
        .related-card-image img,
        .image-viewer[open] {
          animation: none !important;
          clip-path: none !important;
          filter: none !important;
          transform: none !important;
          opacity: 1 !important;
        }

        .post-article::before {
          animation: none !important;
        }

        .related-card-image img,
        .article-body img {
          transition: none !important;
        }
      }
    </style>
  </head>

  <body>
    <div class="reading-progress-track" aria-hidden="true">
      <div class="reading-progress-bar"></div>
    </div>

    <LiquidCursor />

    <header>
      <nav>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main>
      <article class="post-article">
        <a href="/blog" class="back-link">&larr; Back to posts</a>

        {post.data.thumbnail && (
          <div class="article-opening-image">
            <img
              src={post.data.thumbnail}
              alt={post.data.title}
              fetchpriority="high"
            />
          </div>
        )}

        <h1>{post.data.title}</h1>

        <p class="post-date">
          {post.data.pubDate?.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </p>

        <div class="reading-meta">
          <span>{readingTime} min read</span>
          <span class="meta-dot" aria-hidden="true">·</span>
          <span>Scroll to explore</span>
        </div>

        <div class="article-body">
          <Content />
        </div>

        {relatedPosts.length > 0 && (
          <section class="related-stories" aria-labelledby="related-heading">
            <h2 class="related-heading" id="related-heading">
              Keep exploring.
            </h2>
            <p class="related-intro">
              More stories from the Turath archive.
            </p>

            <div class="related-grid">
              {relatedPosts.map((item) => (
                <a class="related-card" href={`/blog/${item.slug}/`}>
                  <div class="related-card-image">
                    {item.data.thumbnail ? (
                      <img
                        src={item.data.thumbnail}
                        alt={item.data.title}
                        loading="lazy"
                      />
                    ) : (
                      <div class="related-card-no-image" aria-hidden="true">
                        T.
                      </div>
                    )}
                  </div>

                  <h3 class="related-card-title">{item.data.title}</h3>

                  {item.data.pubDate && (
                    <p class="related-card-date">
                      {item.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </p>
                  )}
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    </main>

    <dialog class="image-viewer" aria-label="Image viewer">
      <div class="viewer-layout">
        <button class="viewer-close" type="button" aria-label="Close image viewer">
          &times;
        </button>

        <span class="viewer-counter" aria-live="polite"></span>

        <button
          class="viewer-nav viewer-prev"
          type="button"
          aria-label="Previous image"
        >
          &#8592;
        </button>

        <div class="viewer-image-wrap">
          <img class="viewer-image" src="" alt="" />
        </div>

        <button
          class="viewer-nav viewer-next"
          type="button"
          aria-label="Next image"
        >
          &#8594;
        </button>

        <p class="viewer-caption"></p>
      </div>
    </dialog>

    <footer>
      <p>&copy; {new Date().getFullYear()} Turath. All rights reserved.</p>
    </footer>

    <script>
      const articleBody = document.querySelector('.article-body');
      const progressBar = document.querySelector('.reading-progress-bar');

      // Stagger the article paragraphs.
      if (
        articleBody &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        Array.from(articleBody.children).forEach((element, index) => {
          element.style.setProperty(
            '--reveal-delay',
            `${650 + Math.min(index, 8) * 100}ms`
          );
        });
      }

      // Update reading progress.
      let progressTicking = false;

      function updateReadingProgress() {
        if (!progressBar) return;

        const scrollableHeight =
          document.documentElement.scrollHeight - window.innerHeight;

        const progress =
          scrollableHeight > 0
            ? Math.min(1, Math.max(0, window.scrollY / scrollableHeight))
            : 0;

        progressBar.style.transform = `scaleX(${progress})`;
        progressTicking = false;
      }

      window.addEventListener(
        'scroll',
        () => {
          if (!progressTicking) {
            window.requestAnimationFrame(updateReadingProgress);
            progressTicking = true;
          }
        },
        { passive: true }
      );

      window.addEventListener('resize', updateReadingProgress);
      updateReadingProgress();

      // Interactive image viewer for article photographs.
      const viewer = document.querySelector('.image-viewer');
      const viewerImage = document.querySelector('.viewer-image');
      const viewerCaption = document.querySelector('.viewer-caption');
      const viewerCounter = document.querySelector('.viewer-counter');
      const closeViewerButton = document.querySelector('.viewer-close');
      const previousButton = document.querySelector('.viewer-prev');
      const nextButton = document.querySelector('.viewer-next');

      const imageElements = Array.from(
        document.querySelectorAll(
          '.article-opening-image img, .article-body img'
        )
      );

      const gallery = imageElements
        .filter((img) => img instanceof HTMLImageElement)
        .map((img) => ({
          src: img.currentSrc || img.src,
          alt: img.alt || '',
          caption:
            img.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ||
            img.alt ||
            '',
          element: img,
        }));

      let activeImageIndex = 0;
      let previousFocusedElement = null;

      function renderViewerImage() {
        if (!viewerImage || gallery.length === 0) return;

        const image = gallery[activeImageIndex];

        viewerImage.src = image.src;
        viewerImage.alt = image.alt;

        if (viewerCaption) {
          viewerCaption.textContent = image.caption;
        }

        if (viewerCounter) {
          viewerCounter.textContent =
            `${activeImageIndex + 1} / ${gallery.length}`;
        }

        const multipleImages = gallery.length > 1;

        if (previousButton) {
          previousButton.hidden = !multipleImages;
        }

        if (nextButton) {
          nextButton.hidden = !multipleImages;
        }
      }

      function openViewer(index) {
        if (!viewer || gallery.length === 0) return;

        activeImageIndex = index;
        previousFocusedElement = document.activeElement;
        renderViewerImage();

        if (!viewer.open) {
          viewer.showModal();
        }

        closeViewerButton?.focus();
      }

      function closeViewer() {
        if (!viewer?.open) return;

        viewer.close();
      }

      function showNextImage(direction) {
        if (gallery.length < 2) return;

        activeImageIndex =
          (activeImageIndex + direction + gallery.length) % gallery.length;

        renderViewerImage();
      }

      imageElements.forEach((img) => {
        img.addEventListener('click', () => {
          const index = gallery.findIndex((item) => item.element === img);
          if (index !== -1) openViewer(index);
        });
      });

      closeViewerButton?.addEventListener('click', closeViewer);

      previousButton?.addEventListener('click', () => {
        showNextImage(-1);
      });

      nextButton?.addEventListener('click', () => {
        showNextImage(1);
      });

      viewer?.addEventListener('click', (event) => {
        if (event.target === viewer) {
          closeViewer();
        }
      });

      viewer?.addEventListener('close', () => {
        viewerImage?.removeAttribute('src');
        previousFocusedElement?.focus?.();
      });

      document.addEventListener('keydown', (event) => {
        if (!viewer?.open) return;

        if (event.key === 'ArrowRight') {
          event.preventDefault();
          showNextImage(1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showNextImage(-1);
        }
      });
    </script>
  </body>
</html>
