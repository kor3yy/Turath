
---
import { getCollection } from 'astro:content';
import LiquidCursor from '../../components/LiquidCursor.astro';
import { photoAnnotationsBySlug } from '../../data/photoAnnotations';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const allPosts = await getCollection('blog');

const relatedPosts = allPosts
  .filter((item) => item.slug !== post.slug)
  .sort(
    (a, b) =>
      (b.data.pubDate?.valueOf() ?? 0) -
      (a.data.pubDate?.valueOf() ?? 0)
  )
  .slice(0, 3);

const wordCount = (post.body ?? '')
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;

const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const photoAnnotations = photoAnnotationsBySlug[post.slug] ?? [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{post.data.title} — Turath</title>
    <meta name="description" content={post.data.description} />

    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`https://tturatth.com/blog/${post.slug}/`} />

    {post.data.thumbnail && (
      <meta
        property="og:image"
        content={`https://tturatth.com${post.data.thumbnail}`}
      />
    )}

    <link rel="stylesheet" href="/styles/global.css" />

    <style>
      :root {
        --explorer-accent: var(--text-color, currentColor);
        --explorer-panel: var(--background, #111);
      }

      .post-article {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
      }

      /* Reading progress */

      .reading-progress-track {
        position: fixed;
        inset: 0 0 auto;
        z-index: 10000;
        height: 3px;
        background: transparent;
        pointer-events: none;
      }

      .reading-progress-bar {
        width: 100%;
        height: 100%;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left center;
        will-change: transform;
      }

      .reading-meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin: 0.75rem 0 1.5rem;
        font-size: 0.8rem;
        opacity: 0.65;
      }

      .meta-dot {
        opacity: 0.5;
      }

      /* Article opening image */

      .article-opening-image {
        position: relative;
        width: 100%;
        margin: 1.5rem 0 2.5rem;
        overflow: hidden;
        border-radius: 12px;
        background: var(--surface-bg, #111);
        animation: image-reveal 1.2s cubic-bezier(.16, 1, .3, 1) both;
      }

      .article-opening-image img {
        display: block;
        width: 100%;
        max-height: 580px;
        object-fit: cover;
        animation: image-zoom 1.8s cubic-bezier(.16, 1, .3, 1) both;
      }

      .post-article > h1 {
        animation: text-reveal 900ms cubic-bezier(.16, 1, .3, 1) 250ms both;
      }

      .post-article > .post-date {
        animation: text-reveal 800ms ease 450ms both;
      }

      .post-article > .back-link {
        display: inline-block;
        animation: text-reveal 700ms ease 150ms both;
      }

      .article-body {
        animation: text-reveal 900ms cubic-bezier(.16, 1, .3, 1) 550ms both;
      }

      .article-body > * {
        animation: paragraph-reveal 800ms cubic-bezier(.16, 1, .3, 1) both;
        animation-delay: var(--reveal-delay, 650ms);
      }

      /* Interactive photograph explorer */

      .photo-explorer {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        max-width: 100%;
        border-radius: 10px;
        background: #111;
      }

      .photo-explorer > img {
        display: block;
        width: 100%;
        height: auto;
        max-width: 100%;
        margin: 0;
        cursor: zoom-in;
        transition: filter 350ms ease;
      }

      .photo-explorer.has-hotspots::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(
          180deg,
          rgba(0, 0, 0, 0.12),
          transparent 24%,
          transparent 70%,
          rgba(0, 0, 0, 0.2)
        );
        opacity: 0.65;
        transition: opacity 250ms ease;
      }

      .photo-explorer.has-hotspots:hover > img {
        filter: brightness(0.92);
      }

      .photo-explorer.has-hotspots:hover::after {
        opacity: 1;
      }

      .photo-explorer .hotspot {
        position: absolute;
        z-index: 3;
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        padding: 0;
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 50%;
        color: #fff;
        background: rgba(15, 15, 15, 0.76);
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.25);
        cursor: pointer;
        transform: translate(-50%, -50%);
        transition:
          background 200ms ease,
          color 200ms ease,
          border-color 200ms ease,
          scale 200ms ease;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
      }

      .photo-explorer .hotspot::before {
        content: "";
        position: absolute;
        inset: -6px;
        border: 1px solid rgba(255, 255, 255, 0.45);
        border-radius: 50%;
        animation: hotspot-pulse 2.5s ease-out infinite;
        pointer-events: none;
      }

      .photo-explorer .hotspot:hover,
      .photo-explorer .hotspot:focus-visible,
      .photo-explorer .hotspot[aria-expanded="true"] {
        color: #111;
        background: #fff;
        border-color: #fff;
        scale: 1.08;
      }

      .photo-explorer .hotspot:focus-visible {
        outline: 3px solid currentColor;
        outline-offset: 5px;
      }

      .hotspot-number {
        font-size: 0.78rem;
        font-weight: 650;
        font-variant-numeric: tabular-nums;
      }

      .photo-explorer-label {
        position: absolute;
        z-index: 2;
        left: 12px;
        bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        max-width: calc(100% - 24px);
        padding: 9px 12px;
        border: 1px solid rgba(255, 255, 255, 0.24);
        border-radius: 999px;
        color: #fff;
        background: rgba(15, 15, 15, 0.72);
        font-size: 0.72rem;
        letter-spacing: 0.025em;
        pointer-events: none;
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
      }

      .photo-explorer-label svg {
        flex: 0 0 auto;
      }

      .photo-explorer-caption {
        display: block;
        margin-top: 0.65rem;
        font-size: 0.8rem;
        line-height: 1.6;
        opacity: 0.7;
      }

      /* Annotation dialog */

      .annotation-dialog {
        width: min(520px, calc(100% - 28px));
        max-width: 520px;
        max-height: min(78dvh, 720px);
        margin: auto 24px 24px auto;
        padding: 0;
        overflow: auto;
        color: CanvasText;
        background: Canvas;
        border: 1px solid color-mix(in srgb, CanvasText 16%, transparent);
        border-radius: 16px;
        box-shadow: 0 24px 100px rgba(0, 0, 0, 0.28);
      }

      .annotation-dialog[open] {
        animation: annotation-enter 260ms cubic-bezier(.16, 1, .3, 1) both;
      }

      .annotation-dialog::backdrop {
        background: rgba(0, 0, 0, 0.54);
        -webkit-backdrop-filter: blur(5px);
        backdrop-filter: blur(5px);
      }

      .annotation-content {
        padding: clamp(20px, 4vw, 30px);
      }

      .annotation-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 22px;
      }

      .annotation-category {
        margin: 0;
        font-size: 0.7rem;
        font-weight: 650;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.65;
      }

      .annotation-close,
      .viewer-close,
      .viewer-control {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        padding: 0;
        border: 1px solid color-mix(in srgb, CanvasText 18%, transparent);
        border-radius: 50%;
        color: inherit;
        background: transparent;
        cursor: pointer;
        transition: background 180ms ease, color 180ms ease;
      }

      .annotation-close:hover,
      .viewer-close:hover,
      .viewer-control:hover {
        background: color-mix(in srgb, CanvasText 9%, transparent);
      }

      .annotation-number {
        display: block;
        margin-bottom: 12px;
        font-size: 0.76rem;
        opacity: 0.55;
        font-variant-numeric: tabular-nums;
      }

      .annotation-title {
        margin: 0 0 14px;
        font-size: clamp(1.45rem, 4vw, 2rem);
        line-height: 1.15;
        letter-spacing: -0.035em;
      }

      .annotation-detail {
        margin: 0;
        font-size: 0.98rem;
        line-height: 1.8;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      .annotation-navigation {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 26px;
        padding-top: 18px;
        border-top: 1px solid color-mix(in srgb, CanvasText 12%, transparent);
      }

      .annotation-navigation button {
        padding: 9px 12px;
        border: 1px solid color-mix(in srgb, CanvasText 18%, transparent);
        border-radius: 999px;
        color: inherit;
        background: transparent;
        font: inherit;
        font-size: 0.8rem;
        cursor: pointer;
      }

      .annotation-navigation button:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }

      .annotation-position {
        font-size: 0.75rem;
        opacity: 0.6;
        white-space: nowrap;
      }

      /* Full-screen image viewer */

      .image-viewer {
        position: fixed;
        inset: 0;
        width: 100%;
        max-width: none;
        height: 100%;
        max-height: none;
        margin: 0;
        padding: 24px;
        border: 0;
        color: white;
        background: rgba(8, 8, 8, 0.97);
      }

      .image-viewer[open] {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
        gap: 16px;
      }

      .image-viewer::backdrop {
        background: rgba(0, 0, 0, 0.95);
      }

      .viewer-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .viewer-counter {
        font-size: 0.8rem;
        opacity: 0.7;
        font-variant-numeric: tabular-nums;
      }

      .viewer-close,
      .viewer-control {
        border-color: rgba(255, 255, 255, 0.3);
      }

      .viewer-controls {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .viewer-stage {
        display: grid;
        place-items: center;
        min-height: 0;
      }

      .viewer-stage img {
        display: block;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
      }

      .viewer-caption {
        margin: 0;
        text-align: center;
        font-size: 0.85rem;
        line-height: 1.6;
        opacity: 0.8;
      }

      /* Related stories */

      .related-stories {
        margin-top: 5rem;
        padding-top: 2rem;
        border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
      }

      .related-stories h2 {
        margin: 0 0 1.5rem;
        font-size: clamp(1.35rem, 3vw, 2rem);
        letter-spacing: -0.03em;
      }

      .related-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .related-card {
        min-width: 0;
        color: inherit;
        text-decoration: none;
      }

      .related-card-image {
        display: block;
        aspect-ratio: 4 / 3;
        margin-bottom: 0.9rem;
        overflow: hidden;
        border-radius: 8px;
        background: color-mix(in srgb, currentColor 7%, transparent);
      }

      .related-card-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 500ms cubic-bezier(.16, 1, .3, 1);
      }

      .related-card:hover .related-card-image img {
        transform: scale(1.045);
      }

      .related-card h3 {
        margin: 0 0 0.45rem;
        font-size: 1rem;
        line-height: 1.4;
      }

      .related-card time {
        font-size: 0.78rem;
        opacity: 0.6;
      }

      /* Cinematic atmosphere */

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 999;
        pointer-events: none;
        background: radial-gradient(
          ellipse at center,
          transparent 45%,
          rgba(0, 0, 0, 0.12) 100%
        );
      }

      .post-article::before {
        content: "";
        position: fixed;
        inset: -50%;
        z-index: 998;
        pointer-events: none;
        opacity: 0.035;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E");
        animation: film-grain 0.22s steps(2) infinite;
      }

      @keyframes film-grain {
        0% { transform: translate(0, 0); }
        25% { transform: translate(1%, -1%); }
        50% { transform: translate(-1%, 1%); }
        75% { transform: translate(1%, 1%); }
        100% { transform: translate(-1%, -1%); }
      }

      @keyframes hotspot-pulse {
        0% { transform: scale(0.75); opacity: 0.8; }
        75%, 100% { transform: scale(1.4); opacity: 0; }
      }

      @keyframes annotation-enter {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes image-reveal {
        from {
          opacity: 0;
          clip-path: inset(8% 0 8% 0 round 12px);
          transform: translateY(24px);
        }
        to {
          opacity: 1;
          clip-path: inset(0 0 0 0 round 12px);
          transform: translateY(0);
        }
      }

      @keyframes image-zoom {
        from { transform: scale(1.09); filter: brightness(.65); }
        to { transform: scale(1); filter: brightness(1); }
      }

      @keyframes text-reveal {
        from { opacity: 0; transform: translateY(20px); filter: blur(5px); }
        to { opacity: 1; transform: translateY(0); filter: blur(0); }
      }

      @keyframes paragraph-reveal {
        from { opacity: 0; transform: translateY(14px); filter: blur(3px); }
        to { opacity: 1; transform: translateY(0); filter: blur(0); }
      }

      @media (max-width: 760px) {
        .related-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .annotation-dialog {
          margin: auto 10px 10px;
          width: calc(100% - 20px);
          max-height: 80dvh;
        }
      }

      @media (max-width: 650px) {
        .article-opening-image {
          margin: 1.25rem 0 2rem;
          border-radius: 8px;
        }

        .article-opening-image img {
          max-height: 380px;
        }

        .photo-explorer .hotspot {
          width: 34px;
          height: 34px;
        }

        .photo-explorer-label {
          left: 8px;
          bottom: 8px;
          padding: 8px 10px;
          font-size: 0.67rem;
        }

        .image-viewer {
          padding: 12px;
        }

        .related-grid {
          gap: 1rem;
        }
      }

      @media (max-width: 420px) {
        .related-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .article-opening-image,
        .article-opening-image img,
        .post-article > h1,
        .post-article > .post-date,
        .post-article > .back-link,
        .article-body,
        .article-body > *,
        .post-article::before,
        .annotation-dialog[open] {
          animation: none !important;
          clip-path: none !important;
          filter: none !important;
          transform: none !important;
          opacity: 1 !important;
        }

        .photo-explorer .hotspot::before {
          animation: none;
        }

        .photo-explorer > img,
        .related-card-image img {
          transition: none;
        }
      }
    </style>
  </head>

  <body>
    <div class="reading-progress-track" aria-hidden="true">
      <div class="reading-progress-bar"></div>
    </div>

    <LiquidCursor />

    <header>
      <nav>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main>
      <article
        class="post-article"
        data-photo-annotations={JSON.stringify(photoAnnotations)}
      >
        <a href="/blog" class="back-link">&larr; Back to posts</a>

        {post.data.thumbnail && (
          <div class="article-opening-image">
            <img
              src={post.data.thumbnail}
              alt={post.data.title}
              fetchpriority="high"
            />
          </div>
        )}

        <h1>{post.data.title}</h1>

        <p class="post-date">
          {post.data.pubDate?.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </p>

        <div class="reading-meta">
          <span>{readingTime} min read</span>
          <span class="meta-dot" aria-hidden="true">·</span>
          <span>Scroll to explore</span>
        </div>

        <div class="article-body">
          <Content />
        </div>
      </article>

      {relatedPosts.length > 0 && (
        <section class="related-stories" aria-labelledby="related-heading">
          <h2 id="related-heading">Continue exploring</h2>

          <div class="related-grid">
            {relatedPosts.map((item) => (
              <a class="related-card" href={`/blog/${item.slug}/`}>
                <span class="related-card-image">
                  {item.data.thumbnail && (
                    <img
                      src={item.data.thumbnail}
                      alt=""
                      loading="lazy"
                    />
                  )}
                </span>

                <h3>{item.data.title}</h3>

                {item.data.pubDate && (
                  <time datetime={item.data.pubDate.toISOString()}>
                    {item.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                )}
              </a>
            ))}
          </div>
        </section>
      )}
    </main>

    <dialog
      class="annotation-dialog"
      aria-labelledby="annotation-title"
      aria-describedby="annotation-detail"
    >
      <div class="annotation-content">
        <div class="annotation-topline">
          <p class="annotation-category"></p>

          <button
            class="annotation-close"
            type="button"
            aria-label="Close photograph detail"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            >
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        </div>

        <span class="annotation-number"></span>
        <h2 class="annotation-title" id="annotation-title"></h2>
        <p class="annotation-detail" id="annotation-detail"></p>

        <div class="annotation-navigation">
          <button type="button" class="annotation-previous">
            Previous
          </button>

          <span class="annotation-position" aria-live="polite"></span>

          <button type="button" class="annotation-next">
            Next
          </button>
        </div>
      </div>
    </dialog>

    <dialog class="image-viewer" aria-label="Photograph viewer">
      <div class="viewer-toolbar">
        <span class="viewer-counter" aria-live="polite"></span>

        <div class="viewer-controls">
          <button
            class="viewer-control viewer-previous"
            type="button"
            aria-label="Previous photograph"
          >
            &larr;
          </button>

          <button
            class="viewer-control viewer-next"
            type="button"
            aria-label="Next photograph"
          >
            &rarr;
          </button>

          <button
            class="viewer-close"
            type="button"
            aria-label="Close photograph viewer"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            >
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <div class="viewer-stage">
        <img alt="" />
      </div>

      <p class="viewer-caption"></p>
    </dialog>

    <footer>
      <p>&copy; {new Date().getFullYear()} Turath. All rights reserved.</p>
    </footer>

    <script>
      const article = document.querySelector('.post-article');
      const articleBody = document.querySelector('.article-body');
      const progressBar = document.querySelector('.reading-progress-bar');

      const annotationDialog =
        document.querySelector('.annotation-dialog');

      const annotationCategory =
        document.querySelector('.annotation-category');

      const annotationNumber =
        document.querySelector('.annotation-number');

      const annotationTitle =
        document.querySelector('.annotation-title');

      const annotationDetail =
        document.querySelector('.annotation-detail');

      const annotationPosition =
        document.querySelector('.annotation-position');

      const annotationPrevious =
        document.querySelector('.annotation-previous');

      const annotationNext =
        document.querySelector('.annotation-next');

      const imageViewer = document.querySelector('.image-viewer');
      const viewerImage = imageViewer.querySelector('.viewer-stage img');
      const viewerCaption = document.querySelector('.viewer-caption');
      const viewerCounter = document.querySelector('.viewer-counter');

      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      /* Cinematic staggered article reveal */

      if (articleBody && !reduceMotion) {
        Array.from(articleBody.children).forEach((element, index) => {
          element.style.setProperty(
            '--reveal-delay',
            `${650 + Math.min(index, 8) * 100}ms`
          );
        });
      }

      /* Reading progress */

      let progressFrame = 0;

      function updateReadingProgress() {
        if (!progressBar) return;

        cancelAnimationFrame(progressFrame);

        progressFrame = requestAnimationFrame(() => {
          const documentHeight =
            document.documentElement.scrollHeight - window.innerHeight;

          const progress =
            documentHeight > 0
              ? Math.min(1, Math.max(0, window.scrollY / documentHeight))
              : 0;

          progressBar.style.transform = `scaleX(${progress})`;
        });
      }

      window.addEventListener('scroll', updateReadingProgress, {
        passive: true,
      });

      window.addEventListener('resize', updateReadingProgress);
      updateReadingProgress();

      /* Safe annotation data */

      let photoSets = [];

      try {
        photoSets = JSON.parse(article?.dataset.photoAnnotations || '[]');
      } catch (error) {
        console.error('Turath photo annotations could not be read.', error);
      }

      function normalizedPath(source) {
        try {
          return new URL(source, window.location.origin).pathname;
        } catch {
          return source;
        }
      }

      function getPhotoSet(image) {
        const imagePath = normalizedPath(
          image.getAttribute('src') || image.src
        );

        return photoSets.find(
          (set) => normalizedPath(set.image) === imagePath
        );
      }

      /* Accessible annotation panel */

      let activeAnnotations = [];
      let activeAnnotationIndex = 0;
      let lastHotspot = null;

      function renderAnnotation(index) {
        if (!activeAnnotations.length) return;

        activeAnnotationIndex =
          (index + activeAnnotations.length) % activeAnnotations.length;

        const annotation = activeAnnotations[activeAnnotationIndex];

        annotationCategory.textContent = annotation.category || 'Photo notes';
        annotationNumber.textContent =
          `DETAIL ${String(activeAnnotationIndex + 1).padStart(2, '0')}`;

        annotationTitle.textContent = annotation.title;
        annotationDetail.textContent = annotation.detail;

        annotationPosition.textContent =
          `${activeAnnotationIndex + 1} of ${activeAnnotations.length}`;

        annotationPrevious.disabled = activeAnnotations.length < 2;
        annotationNext.disabled = activeAnnotations.length < 2;

        document.querySelectorAll('.photo-explorer .hotspot').forEach(
          (button) => {
            const isActive =
              button.dataset.annotationIndex === String(activeAnnotationIndex);

            button.setAttribute('aria-expanded', String(isActive));
          }
        );
      }

      function openAnnotation(annotations, index, button) {
        if (!annotations?.length) return;

        activeAnnotations = annotations;
        lastHotspot = button;

        renderAnnotation(index);

        if (!annotationDialog.open) {
          annotationDialog.showModal();
        }
      }

      function closeAnnotation() {
        if (annotationDialog.open) annotationDialog.close();
      }

      document
        .querySelector('.annotation-close')
        .addEventListener('click', closeAnnotation);

      annotationPrevious.addEventListener('click', () => {
        renderAnnotation(activeAnnotationIndex - 1);
      });

      annotationNext.addEventListener('click', () => {
        renderAnnotation(activeAnnotationIndex + 1);
      });

      annotationDialog.addEventListener('click', (event) => {
        if (event.target === annotationDialog) {
          closeAnnotation();
        }
      });

      annotationDialog.addEventListener('close', () => {
        document.querySelectorAll('.photo-explorer .hotspot').forEach(
          (button) => button.setAttribute('aria-expanded', 'false')
        );

        if (lastHotspot?.isConnected) {
          lastHotspot.focus();
        }

        lastHotspot = null;
      });

      /* Turn selected images into interactive photographs */

      const articleImages = Array.from(
        document.querySelectorAll(
          '.article-opening-image img, .article-body img'
        )
      );

      articleImages.forEach((image) => {
        const photoSet = getPhotoSet(image);

        if (!photoSet || !Array.isArray(photoSet.annotations)) return;

        const annotations = photoSet.annotations.filter((annotation) => {
          return (
            typeof annotation.id === 'string' &&
            typeof annotation.title === 'string' &&
            typeof annotation.detail === 'string' &&
            Number.isFinite(annotation.x) &&
            Number.isFinite(annotation.y) &&
            annotation.x >= 0 &&
            annotation.x <= 100 &&
            annotation.y >= 0 &&
            annotation.y <= 100
          );
        });

        if (!annotations.length) return;

        let explorer;

        if (image.closest('.article-opening-image')) {
          explorer = image.closest('.article-opening-image');
        } else {
          explorer = document.createElement('div');
          explorer.className = 'photo-explorer';

          image.parentNode.insertBefore(explorer, image);
          explorer.appendChild(image);

          /* Keep a figure caption outside the interactive image area. */
        }

        explorer.classList.add('photo-explorer', 'has-hotspots');

        const accessibleImageDescription =
          photoSet.alt || image.alt || 'Interactive photograph';

        if (!image.alt) image.alt = accessibleImageDescription;

        annotations.forEach((annotation, index) => {
          const button = document.createElement('button');

          button.type = 'button';
          button.className = 'hotspot';
          button.style.left = `${annotation.x}%`;
          button.style.top = `${annotation.y}%`;
          button.dataset.annotationIndex = String(index);
          button.setAttribute('aria-expanded', 'false');
          button.setAttribute(
            'aria-label',
            `Explore detail ${index + 1}: ${annotation.title}`
          );

          const number = document.createElement('span');
          number.className = 'hotspot-number';
          number.textContent = String(index + 1).padStart(2, '0');

          button.appendChild(number);

          button.addEventListener('click', (event) => {
            event.stopPropagation();
            openAnnotation(annotations, index, button);
          });

          explorer.appendChild(button);
        });

        const label = document.createElement('span');
        label.className = 'photo-explorer-label';
        label.innerHTML = `
          <svg width="15" height="15" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 11v5M12 8h.01"></path>
          </svg>
          Explore this photograph
        `;

        explorer.appendChild(label);

        /* Make the figure caption clear that the image is interactive. */
        const figure = explorer.closest('figure');
        const caption = figure?.querySelector('figcaption');

        if (caption && !caption.dataset.explorerCaption) {
          caption.dataset.explorerCaption = 'true';
        }
      });

      /* Full-screen article image viewer */

      const galleryImages = articleImages.map((image) => ({
        src: image.currentSrc || image.src,
        alt: image.alt || '',
        caption:
          image.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ||
          image.alt ||
          '',
      }));

      let galleryIndex = 0;
      let lastGalleryImage = null;

      function renderGallery(index) {
        if (!galleryImages.length) return;

        galleryIndex =
          (index + galleryImages.length) % galleryImages.length;

        const image = galleryImages[galleryIndex];

        viewerImage.src = image.src;
        viewerImage.alt = image.alt;
        viewerCaption.textContent = image.caption;
        viewerCounter.textContent =
          `${galleryIndex + 1} / ${galleryImages.length}`;

        const multiple = galleryImages.length > 1;

        document.querySelector('.viewer-previous').disabled = !multiple;
        document.querySelector('.viewer-next').disabled = !multiple;
      }

      function openGallery(index, sourceImage) {
        if (!galleryImages.length) return;

        lastGalleryImage = sourceImage;
        renderGallery(index);

        if (!imageViewer.open) imageViewer.showModal();
      }

      articleImages.forEach((image, index) => {
        image.addEventListener('click', (event) => {
          if (event.target.closest('.hotspot')) return;
          openGallery(index, image);
        });

        image.tabIndex = 0;
        image.style.cursor = 'zoom-in';

        image.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openGallery(index, image);
          }
        });

        image.setAttribute('aria-label', `Open photograph: ${image.alt || 'image'}`);
      });

      document.querySelector('.viewer-close').addEventListener('click', () => {
        imageViewer.close();
      });

      document.querySelector('.viewer-previous').addEventListener('click', () => {
        renderGallery(galleryIndex - 1);
      });

      document.querySelector('.viewer-next').addEventListener('click', () => {
        renderGallery(galleryIndex + 1);
      });

      imageViewer.addEventListener('click', (event) => {
        if (event.target === imageViewer) imageViewer.close();
      });

      imageViewer.addEventListener('close', () => {
        if (lastGalleryImage?.isConnected) lastGalleryImage.focus();
        lastGalleryImage = null;
      });

      document.addEventListener('keydown', (event) => {
        if (annotationDialog.open) {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            renderAnnotation(activeAnnotationIndex - 1);
          }

          if (event.key === 'ArrowRight') {
            event.preventDefault();
            renderAnnotation(activeAnnotationIndex + 1);
          }
        }

        if (!imageViewer.open) return;

        if (event.key === 'ArrowLeft') renderGallery(galleryIndex - 1);
        if (event.key === 'ArrowRight') renderGallery(galleryIndex + 1);
      });
    </script>
  </body>
</html>
