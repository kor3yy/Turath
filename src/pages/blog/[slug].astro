
---
import { getCollection } from 'astro:content';
import LiquidCursor from '../../components/LiquidCursor.astro';
import { ClientRouter } from 'astro:transitions';
import TableOfContents from '../../components/TablesOfContents.astro';
import BackgroundPhotoFlash from '../../components/backgroundphotoflash.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const isAcknowledgments = `${post.slug} ${post.data.title}`
  .toLowerCase()
  .includes('acknowledg');

const { Content } = await post.render();

const wordCount = (post.body ?? '')
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;

const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <ClientRouter />

    <title>{post.data.title} — Turath</title>
    <meta name="description" content={post.data.description} />

    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:type" content="article" />
    <meta
      property="og:url"
      content={`https://tturatth.com/blog/${post.slug}/`}
    />

    {post.data.thumbnail && (
      <meta
        property="og:image"
        content={`https://tturatth.com${post.data.thumbnail}`}
      />
    )}

    <link rel="stylesheet" href="/styles/global.css" />

    <style>
      .post-article {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
      }

      /* Reading progress */

      .reading-progress-track {
        position: fixed;
        inset: 0 0 auto;
        z-index: 10000;
        height: 3px;
        background: transparent;
        pointer-events: none;
      }

      .reading-progress-bar {
        width: 100%;
        height: 100%;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left center;
        will-change: transform;
      }

      .reading-meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin: 0.75rem 0 1.5rem;
        font-size: 0.8rem;
        opacity: 0.65;
      }

      .meta-dot {
        opacity: 0.5;
      }

      /* Article opening image */

      .article-opening-image {
        position: relative;
        width: 100%;
        margin: 1.5rem 0 2.5rem;
        overflow: hidden;
        border-radius: 12px;
        background: var(--surface-bg, #111);
        animation: image-reveal 1.2s cubic-bezier(.16, 1, .3, 1) both;
      }

      .article-opening-image img {
        display: block;
        width: 100%;
        max-height: 580px;
        object-fit: cover;
        animation: image-zoom 1.8s cubic-bezier(.16, 1, .3, 1) both;
      }

      .post-article > h1 {
        animation: text-reveal 900ms cubic-bezier(.16, 1, .3, 1) 250ms both;
      }

      .post-article > .post-date {
        animation: text-reveal 800ms ease 450ms both;
      }

      .post-article > .back-link {
        display: inline-block;
        animation: text-reveal 700ms ease 150ms both;
      }

      .article-body {
        animation: text-reveal 900ms cubic-bezier(.16, 1, .3, 1) 550ms both;
      }

      .article-body > * {
        animation: paragraph-reveal 800ms cubic-bezier(.16, 1, .3, 1) both;
        animation-delay: var(--reveal-delay, 650ms);
      }

      /* Cinematic atmosphere */

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 999;
        pointer-events: none;
        background: radial-gradient(
          ellipse at center,
          transparent 45%,
          color-mix(in srgb, var(--page-text) 5%, transparent) 100%
        );
      }

      .post-article::before {
        content: "";
        position: fixed;
        inset: -50%;
        z-index: 998;
        pointer-events: none;
        opacity: 0.035;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E");
        animation: film-grain 0.22s steps(2) infinite;
      }

      @keyframes film-grain {
        0% { transform: translate(0, 0); }
        25% { transform: translate(1%, -1%); }
        50% { transform: translate(-1%, 1%); }
        75% { transform: translate(1%, 1%); }
        100% { transform: translate(-1%, -1%); }
      }

      @keyframes image-reveal {
        from {
          opacity: 0;
          clip-path: inset(8% 0 8% 0 round 12px);
          transform: translateY(24px);
        }
        to {
          opacity: 1;
          clip-path: inset(0 0 0 0 round 12px);
          transform: translateY(0);
        }
      }

      @keyframes image-zoom {
        from {
          transform: scale(1.09);
          filter: brightness(.65);
        }
        to {
          transform: scale(1);
          filter: brightness(1);
        }
      }

      @keyframes text-reveal {
        from {
          opacity: 0;
          transform: translateY(20px);
          filter: blur(5px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @keyframes paragraph-reveal {
        from {
          opacity: 0;
          transform: translateY(14px);
          filter: blur(3px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @media (max-width: 650px) {
        .article-opening-image {
          margin: 1.25rem 0 2rem;
          border-radius: 8px;
        }

        .article-opening-image img {
          max-height: 380px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .article-opening-image,
        .article-opening-image img,
        .post-article > h1,
        .post-article > .post-date,
        .post-article > .back-link,
        .article-body,
        .article-body > *,
        .post-article::before {
          animation: none !important;
          clip-path: none !important;
          filter: none !important;
          transform: none !important;
          opacity: 1 !important;
        }
      }
    </style>

    <link rel="icon" type="image/png" href="/images/favicon2.png" />

    <script is:inline>
      function updateFavicon() {
        const theme = document.documentElement.getAttribute('data-theme');
        const favicon = document.querySelector('link[rel="icon"]');

        if (favicon) {
          favicon.href =
            theme === 'dark'
              ? '/images/favicon1.png'
              : '/images/favicon2.png';
        }
      }

      updateFavicon();

      const observer = new MutationObserver(updateFavicon);

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme']
      });
    </script>
  </head>

  <body>
    <BackgroundPhotoFlash />

    <div class="reading-progress-track" aria-hidden="true">
      <div class="reading-progress-bar"></div>
    </div>

    <LiquidCursor />

    <header>
      <nav>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main>
      <article class="post-article">
        <a href="/blog" class="back-link">&larr; Back to posts</a>

        {post.data.thumbnail && (
          <div class="article-opening-image">
            <img
              src={post.data.thumbnail}
              alt={post.data.title}
              fetchpriority="high"
            />
          </div>
        )}

        <h1>{post.data.title}</h1>

        <p class="post-date">
          {post.data.pubDate?.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </p>

        <div class="reading-meta">
          <span>{readingTime} min read</span>
          <span class="meta-dot" aria-hidden="true">·</span>
          <span>Scroll to explore</span>
        </div>

        <TableOfContents />

        <div class="article-body">
          <Content />
        </div>
      </article>
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Turath. All rights reserved.</p>
    </footer>

    <script>
      let cleanupArticlePage = () => {};

      function initializeArticlePage() {
        cleanupArticlePage();

        const articleBody = document.querySelector('.article-body');
        const progressBar = document.querySelector('.reading-progress-bar');

        const reduceMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;

        let progressFrame = 0;

        /* Staggered article reveal effects */

        if (articleBody && !reduceMotion) {
          Array.from(articleBody.children).forEach((element, index) => {
            element.style.setProperty(
              '--reveal-delay',
              `${650 + Math.min(index, 8) * 100}ms`
            );
          });
        }

        /* Reading progress bar */

        function updateReadingProgress() {
          if (!progressBar) return;

          cancelAnimationFrame(progressFrame);

          progressFrame = requestAnimationFrame(() => {
            const documentHeight =
              document.documentElement.scrollHeight - window.innerHeight;

            const progress =
              documentHeight > 0
                ? Math.min(
                    1,
                    Math.max(0, window.scrollY / documentHeight)
                  )
                : 0;

            progressBar.style.transform = `scaleX(${progress})`;
          });
        }

        window.addEventListener('scroll', updateReadingProgress, {
          passive: true,
        });

        window.addEventListener('resize', updateReadingProgress);

        updateReadingProgress();

        /* Clean up before navigating away */

        cleanupArticlePage = () => {
          window.removeEventListener('scroll', updateReadingProgress);
          window.removeEventListener('resize', updateReadingProgress);

          cancelAnimationFrame(progressFrame);

          cleanupArticlePage = () => {};
        };
      }

      /* Initialize on first load and every Astro navigation */

      initializeArticlePage();

      document.addEventListener('astro:page-load', initializeArticlePage);

      document.addEventListener('astro:before-swap', () => {
        cleanupArticlePage();
      });
    </script>
  </body>
</html>
