---
import TurathIntro from '../components/TurathIntro.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import LiquidCursor from '../components/LiquidCursor.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import BackgroundPhotoFlash from '../components/backgroundphotoflash.astro';

const allPosts = await getCollection('blog');

const newestFirst = (a, b) =>
  (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0);

const acknowledgments = allPosts.find((post) =>
  post.data.title.toLowerCase().includes('acknowledgment')
);

const findPost = (identity) => {
  const normalizedIdentity = identity.toLowerCase();

  return allPosts.find((post) =>
    post.data.title.toLowerCase().includes(normalizedIdentity) ||
    post.slug.toLowerCase().includes(normalizedIdentity.replaceAll(' ', '-'))
  );
};

const photographyPosts = [
  findPost('will abbass'),
  findPost('ian armata'),
].filter(Boolean);

const musicPosts = [
  findPost('savia'),
  findPost('razi'),
  findPost('jenna'),
  findPost('toren'),
].filter(Boolean);

const uniquePosts = (posts) => {
  const seen = new Set();

  return posts.filter((post) => {
    if (!post || seen.has(post.slug)) return false;
    seen.add(post.slug);
    return true;
  });
};

const uniquePhotographyPosts = uniquePosts(photographyPosts);
const uniqueMusicPosts = uniquePosts(musicPosts);

const assignedSlugs = new Set([
  acknowledgments?.slug,
  ...uniquePhotographyPosts.map((post) => post.slug),
  ...uniqueMusicPosts.map((post) => post.slug),
].filter(Boolean));

const otherPosts = allPosts
  .filter((post) => !assignedSlugs.has(post.slug))
  .sort(newestFirst);

const sections = [
  {
    id: 'photography',
    title: 'Photography',
    subtitle: 'Images, perspectives & the people behind them',
    posts: uniquePhotographyPosts,
  },
  {
    id: 'music',
    title: 'Music',
    subtitle: 'Sound, artists & creative expression',
    posts: uniqueMusicPosts,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content="Turath — culture, art, expression, history, and the people behind them." />
    <link rel="icon" type="image/png" href="/images/logo-removebg-preview.png" />

   <title>Turath</title>

    <style is:global>
      :root {
        color-scheme: dark;
        --page-bg: #000;
        --page-text: #f5f5f5;
        --surface-bg: #111;
        --border-color: #333;
        --muted: #999;
      }

      :root[data-theme="light"] {
        color-scheme: light;
        --page-bg: #fff;
        --page-text: #171717;
        --surface-bg: #f5f5f5;
        --border-color: #ddd;
        --muted: #666;
      }

      html,
      body {
        min-height: 100%;
        background: var(--page-bg);
        color: var(--page-text);
      }

      body.home {
        min-height: 100vh;
        background-image: none;
      }

      body.home header,
      body.home main,
      body.home footer {
        color: var(--page-text);
      }

      body.home .hero {
        padding: 2.5rem 1rem 1.5rem;
        text-align: center;
        background: transparent;
        border: none;
        border-radius: 0;
        box-shadow: none;
      }

      body.home .hero h1 {
        margin: 0;
        font-size: clamp(2.8rem, 7vw, 5rem);
        letter-spacing: -0.055em;
      }

      body.home .nav-links a {
        color: var(--page-text);
        transition: color 0.25s ease;
      }

      body.home header nav .logo {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }

      body.home .site-logo {
        display: block;
        width: 57.6px;
        height: auto;
        object-fit: contain;
      }

      .turath-marquee {
        width: 100%;
        overflow: hidden;
        padding: 1rem 0;
        margin: 0 0 0.5rem;
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
      }

      .turath-marquee-track {
        display: flex;
        width: max-content;
        animation: turath-scroll 20s linear infinite;
      }

      .turath-marquee-track span {
        flex-shrink: 0;
        white-space: nowrap;
        padding-right: 1rem;
        font-size: 0.75rem;
        letter-spacing: 0.2em;
        color: var(--page-text);
        opacity: 0.75;
      }

      .turath-tagline {
        margin: 0 auto 3rem;
        padding: 0.5rem 1rem;
        text-align: center;
        font-size: 0.85rem;
        font-style: italic;
        color: var(--muted);
      }

      /* Featured acknowledgments */
      .featured-wrap {
        display: flex;
        justify-content: center;
        margin: 0 auto 4rem;
      }

      .featured-card {
        display: block;
        width: min(100%, 470px);
        overflow: hidden;
        color: var(--page-text);
        background: var(--surface-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        text-decoration: none;
        transition: transform 250ms ease, border-color 250ms ease;
      }

      .featured-card:hover {
        transform: translateY(-4px);
        border-color: var(--page-text);
      }

      .featured-image {
        display: block;
        width: 100%;
        height: 240px;
        object-fit: cover;
      }

      .featured-copy {
        padding: 1.2rem 1.3rem 1.4rem;
        text-align: center;
      }

      .eyebrow {
        margin: 0 0 0.5rem;
        color: var(--muted);
        font-size: 0.68rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      .featured-copy h2 {
        margin: 0 0 0.65rem;
        color: var(--page-text);
        font-size: 1.5rem;
      }

      .featured-copy p:last-child {
        margin: 0;
        color: var(--muted);
        font-size: 0.88rem;
      }

      /* Category sections */
      .archive {
        margin: 0 auto 4rem;
      }

      .archive-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .archive-heading h2 {
        margin: 0;
        font-size: clamp(1.7rem, 4vw, 2.4rem);
        letter-spacing: -0.04em;
      }

      .archive-heading p {
        margin: 0.35rem 0 0;
        color: var(--muted);
        font-size: 0.85rem;
      }

      .open-archive {
        flex-shrink: 0;
        padding: 0.65rem 0.9rem;
        border: 1px solid var(--border-color);
        border-radius: 999px;
        color: var(--page-text);
        background: var(--surface-bg);
        cursor: pointer;
        transition: border-color 200ms ease;
      }

      .open-archive:hover,
      .open-archive[aria-expanded="true"] {
        border-color: var(--page-text);
      }

      .category-cover {
        position: relative;
        display: block;
        width: 100%;
        height: clamp(250px, 39vw, 430px);
        padding: 0;
        overflow: hidden;
        isolation: isolate;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        background: var(--surface-bg);
        color: white;
        text-align: left;
        cursor: pointer;
      }

      .cover-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: scale(1.025);
        transition: opacity 1.8s ease, transform 7s ease;
      }

      .cover-image.is-current {
        opacity: 1;
        transform: scale(1.09);
      }

      .cover-shade {
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(
          0deg,
          rgb(0 0 0 / 83%) 0%,
          rgb(0 0 0 / 25%) 50%,
          rgb(0 0 0 / 8%) 100%
        );
        pointer-events: none;
      }

      .cover-copy {
        position: absolute;
        inset: auto 1.5rem 1.5rem;
        z-index: 2;
        pointer-events: none;
      }

      .cover-copy .eyebrow {
        color: rgb(255 255 255 / 75%);
      }

      .cover-copy h3 {
        margin: 0;
        color: white;
        font-size: clamp(2rem, 5vw, 3.5rem);
        letter-spacing: -0.05em;
      }

      .cover-copy p {
        max-width: 520px;
        margin: 0.4rem 0 0;
        color: rgb(255 255 255 / 80%);
        font-size: 0.9rem;
      }

      .cover-index {
        position: absolute;
        top: 1.2rem;
        right: 1.2rem;
        z-index: 2;
        color: white;
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        pointer-events: none;
      }

      /* Open section carousel */
      .section-view {
        display: none;
        margin-top: 1.5rem;
      }

      .section-view.is-open {
        display: block;
        animation: reveal-section 400ms ease both;
      }

      @keyframes reveal-section {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .section-view-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .section-view-top p {
        margin: 0;
        color: var(--muted);
        font-size: 0.8rem;
      }

      /* Article carousel and full descriptions */
      .article-stage {
        position: relative;
        height: clamp(460px, 55vw, 560px);
        overflow: hidden;
        isolation: isolate;
        touch-action: pan-y;
        -webkit-mask-image: linear-gradient(
          to right, transparent, #000 12%, #000 88%, transparent
        );
        mask-image: linear-gradient(
          to right, transparent, #000 12%, #000 88%, transparent
        );
      }

      .article-card {
        position: absolute;
        top: 50%;
        left: 50%;
        display: flex;
        flex-direction: column;
        width: clamp(190px, 27vw, 290px);
        height: 430px;
        overflow: hidden;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        color: var(--page-text);
        background: var(--surface-bg);
        text-decoration: none;
        opacity: var(--opacity, 0);
        z-index: var(--z, 0);
        pointer-events: none;
        transform: translate(calc(-50% + var(--x, 0px)), -50%) scale(var(--scale, 1));
        transition: transform 500ms cubic-bezier(.2,.8,.2,1), opacity 400ms ease;
      }

      .article-card.is-visible {
        pointer-events: auto;
      }

      .article-card.is-active {
        border-color: var(--page-text);
        box-shadow: 0 14px 35px rgb(0 0 0 / 20%);
        animation: gentle-float 5s ease-in-out infinite;
      }

      .article-card-image-wrap {
        flex: 0 0 48%;
        min-height: 0;
        overflow: hidden;
        background: var(--surface-bg);
      }

      .article-card img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: filter 300ms ease, transform 300ms ease;
      }

      .article-card:hover img {
        filter: blur(4px);
        transform: scale(1.05);
      }

      .article-card-copy {
        flex: 1;
        min-height: 0;
        padding: 0.9rem 1rem 1rem;
        overflow-y: auto;
        overflow-wrap: anywhere;
      }

      .article-card-copy h4 {
        margin: 0 0 0.5rem;
        font-size: 1rem;
        line-height: 1.4;
      }

      .article-card-copy p {
        display: block;
        margin: 0;
        overflow: visible;
        color: var(--muted);
        font-size: 0.78rem;
        line-height: 1.55;
        overflow-wrap: anywhere;
      }

      .section-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.9rem;
        width: min(100%, 430px);
        margin: 0.5rem auto 0;
      }

      .section-arrow {
        display: grid;
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        place-items: center;
        border: 1px solid var(--border-color);
        border-radius: 50%;
        background: var(--surface-bg);
        color: var(--page-text);
        font-size: 1.1rem;
        cursor: pointer;
      }

      .section-slider-wrap {
        flex: 1;
      }

      .section-slider {
        width: 100%;
        accent-color: var(--page-text);
        cursor: pointer;
      }

      .section-count {
        color: var(--muted);
        font-size: 0.7rem;
        text-align: center;
        letter-spacing: 0.12em;
      }

      .other-articles {
        margin-top: 4rem;
      }

      .other-articles h2 {
        margin-bottom: 1rem;
      }

      .other-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .other-link {
        padding: 1rem;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        background: var(--surface-bg);
        color: var(--page-text);
      }

      .other-link p {
        margin-bottom: 0;
        color: var(--muted);
        font-size: 0.85rem;
      }

      @keyframes turath-scroll {
        to { transform: translateX(-50%); }
      }

      @keyframes gentle-float {
        0%, 100% { margin-top: 0; }
        50% { margin-top: -5px; }
      }

      @media (max-width: 650px) {
        body.home .site-logo {
          width: 50.4px;
        }

        .turath-marquee-track span {
          font-size: 0.7rem;
          letter-spacing: 0.14em;
        }

        .featured-image {
          height: 205px;
        }

        .archive-heading {
          align-items: start;
        }

        .archive-heading p {
          max-width: 230px;
        }

        .category-cover {
          height: 300px;
        }

        .cover-copy {
          inset: auto 1rem 1rem;
        }

        .article-stage {
          height: 440px;
        }

        .article-card {
          width: min(66vw, 260px);
          height: 390px;
        }

        .article-card-image-wrap {
          flex-basis: 44%;
        }

        .other-list {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .turath-marquee-track,
        .article-card.is-active {
          animation: none !important;
        }

        .cover-image,
        .article-card,
        .featured-card {
          transition: none !important;
        }
      }
    </style>
  </head>

  <body class="home">
    <BackgroundPhotoFlash />
    <TurathIntro />
    <LiquidCursor />

    <header>
      <nav>
        <a href="/" class="logo" aria-label="Turath homepage">
          <img
            src="/images/logo-removebg-preview.png"
            alt="Turath logo"
            class="site-logo"
          />
        </a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/about">About</a>
        </div>

        <ThemeToggle />
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Turath</h1>
      </section>

      <div class="turath-marquee" aria-label="Culture. Art. Expression. History.">
        <div class="turath-marquee-track" aria-hidden="true">
          {Array.from({ length: 8 }).map(() => (
            <span>CULTURE. ART. EXPRESSION. HISTORY. &nbsp; · &nbsp;</span>
          ))}
        </div>
      </div>

      <p class="turath-tagline">
        orchestrated through articles &amp; perspectives.
      </p>

      {acknowledgments && (
        <div class="featured-wrap">
          <a class="featured-card" href={`/blog/${acknowledgments.slug}/`}>
            {acknowledgments.data.thumbnail && (
              <img
                class="featured-image"
                src={acknowledgments.data.thumbnail}
                alt=""
              />
            )}

            <div class="featured-copy">
              <p class="eyebrow">A personal dedication</p>
              <h2>Acknowledgments</h2>
              <p>{acknowledgments.data.description}</p>
            </div>
          </a>
        </div>
      )}

      {sections.map((section) => (
        <section class="archive" id={`${section.id}-archive`}>
          <div class="archive-heading">
            <div>
              <h2>{section.title}</h2>
              <p>{section.subtitle}</p>
            </div>

            <button
              class="open-archive"
              type="button"
              data-open-section={section.id}
              aria-controls={`${section.id}-view`}
              aria-expanded="false"
            >
              Explore →
            </button>
          </div>

          <button
            class="category-cover"
            type="button"
            data-open-section={section.id}
            aria-label={`Explore ${section.title} articles`}
            aria-controls={`${section.id}-view`}
            aria-expanded="false"
          >
            {section.posts
              .filter((post) => post.data.thumbnail)
              .map((post, index) => (
                <img
                  class:list={['cover-image', index === 0 && 'is-current']}
                  src={post.data.thumbnail}
                  alt=""
                  data-cover-index={index}
                  loading="lazy"
                />
              ))}

            <span class="cover-shade"></span>

            <span class="cover-index">
              {String(section.posts.length).padStart(2, '0')} ARTICLES
            </span>

            <span class="cover-copy">
              <span class="eyebrow">Explore the archive</span>
              <h3>{section.title}</h3>
              <p>Open the collection to browse its stories.</p>
            </span>
          </button>

          <div class="section-view" id={`${section.id}-view`} aria-label={`${section.title} collection`}>
            <div class="section-view-top">
              <p>Move through the collection</p>
              <p>{section.posts.length} articles</p>
            </div>

            {section.posts.length > 0 ? (
              <>
                <div class="article-stage" data-stage={section.id} tabindex="0" aria-label={`${section.title} article carousel`}>
                  {section.posts.map((post, index) => (
                    <a
                      class="article-card"
                      href={`/blog/${post.slug}/`}
                      data-card-index={index}
                      aria-label={`Open ${post.data.title}`}
                    >
                      <div class="article-card-image-wrap">
                        {post.data.thumbnail && (
                          <img
                            src={post.data.thumbnail}
                            alt={post.data.title}
                            loading="lazy"
                          />
                        )}
                      </div>

                      <div class="article-card-copy">
                        <h4>{post.data.title}</h4>
                        <p>{post.data.description}</p>
                      </div>
                    </a>
                  ))}
                </div>

                <div class="section-controls">
                  <button
                    class="section-arrow"
                    type="button"
                    data-prev={section.id}
                    aria-label="Previous article"
                  >
                    ←
                  </button>

                  <div class="section-slider-wrap">
                    <input
                      class="section-slider"
                      type="range"
                      min="0"
                      max={section.posts.length - 1}
                      value="0"
                      step="1"
                      data-slider={section.id}
                      aria-label={`Choose ${section.title} article`}
                    />

                    <div class="section-count" data-count={section.id}>
                      {`01 / ${String(section.posts.length).padStart(2, '0')}`}
                    </div>
                  </div>

                  <button
                    class="section-arrow"
                    type="button"
                    data-next={section.id}
                    aria-label="Next article"
                  >
                    →
                  </button>
                </div>
              </>
            ) : (
              <p>No articles have been added to this collection yet.</p>
            )}
          </div>
        </section>
      ))}

      {otherPosts.length > 0 && (
        <section class="other-articles">
          <h2>More articles</h2>

          <div class="other-list">
            {otherPosts.map((post) => (
              <a class="other-link" href={`/blog/${post.slug}/`}>
                <strong>{post.data.title}</strong>
                <p>{post.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Turath. All rights reserved.</p>
    </footer>

    <script>
      const wrapAround = (value, length) =>
        length ? ((value % length) + length) % length : 0;

      // Keep the category buttons and Explore button synchronized.
      document.querySelectorAll('.archive').forEach((archive) => {
        const view = archive.querySelector('.section-view');
        const openButtons = Array.from(
          archive.querySelectorAll('[data-open-section]')
        );

        const syncOpenState = (isOpen) => {
          view?.classList.toggle('is-open', isOpen);

          openButtons.forEach((button) => {
            button.setAttribute('aria-expanded', String(isOpen));

            if (button.classList.contains('open-archive')) {
              button.textContent = isOpen ? 'Close ↑' : 'Explore →';
            }
          });
        };

        openButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const opening = !view?.classList.contains('is-open');
            syncOpenState(opening);

            if (opening) {
              requestAnimationFrame(() => {
                view?.scrollIntoView({
                  behavior: 'smooth',
                  block: 'nearest',
                });
              });
            }
          });
        });

        // Crossfade available poster images forever.
        const images = Array.from(
          archive.querySelectorAll('.cover-image')
        );

        if (images.length > 0) {
          let current = 0;

          images.forEach((image, index) => {
            image.classList.toggle('is-current', index === 0);
          });

          if (images.length > 1) {
            window.setInterval(() => {
              images[current].classList.remove('is-current');
              current = (current + 1) % images.length;
              images[current].classList.add('is-current');
            }, 2000);
          }
        }

        // Each collection has its own looping carousel.
        const stage = archive.querySelector('.article-stage');
        const cards = Array.from(
          archive.querySelectorAll('.article-card')
        );
        const slider = archive.querySelector('.section-slider');
        const count = archive.querySelector('.section-count');
        const previous = archive.querySelector('[data-prev]');
        const next = archive.querySelector('[data-next]');

        if (!stage || !slider || !count || cards.length === 0) {
          return;
        }

        let active = 0;
        let pointerStart = null;

        function distanceFrom(index) {
          let distance = index - active;

          if (distance > cards.length / 2) {
            distance -= cards.length;
          }

          if (distance < -cards.length / 2) {
            distance += cards.length;
          }

          return distance;
        }

        function render() {
          const stageWidth = stage.clientWidth;
          const cardWidth =
            cards[0].getBoundingClientRect().width || 230;
          const gap = Math.min(cardWidth * 0.82, stageWidth * 0.25);

          cards.forEach((card, index) => {
            const distance = distanceFrom(index);
            const absolute = Math.abs(distance);
            const visible = absolute <= 2;

            card.style.setProperty('--x', `${distance * gap}px`);

            card.style.setProperty(
              '--scale',
              String(
                absolute === 0
                  ? 1
                  : absolute === 1
                    ? 0.83
                    : 0.68
              )
            );

            card.style.setProperty(
              '--opacity',
              String(
                absolute === 0
                  ? 1
                  : absolute === 1
                    ? 0.78
                    : absolute === 2
                      ? 0.3
                      : 0
              )
            );

            card.style.setProperty('--z', String(10 - absolute));
            card.classList.toggle('is-active', distance === 0);
            card.classList.toggle('is-visible', visible);
            card.setAttribute('aria-hidden', String(!visible));
            card.setAttribute('tabindex', visible ? '0' : '-1');
          });

          slider.value = String(active);

          count.textContent =
            `${String(active + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
        }

        function goTo(index) {
          active = wrapAround(index, cards.length);
          render();
        }

        previous?.addEventListener('click', () => goTo(active - 1));
        next?.addEventListener('click', () => goTo(active + 1));

        slider.addEventListener('input', () => {
          goTo(Number(slider.value));
        });

        cards.forEach((card, index) => {
          card.addEventListener('click', (event) => {
            if (distanceFrom(index) !== 0) {
              event.preventDefault();
              goTo(index);
            }
          });
        });

        stage.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            goTo(active - 1);
          }

          if (event.key === 'ArrowRight') {
            event.preventDefault();
            goTo(active + 1);
          }
        });

        stage.addEventListener('pointerdown', (event) => {
          pointerStart = {
            x: event.clientX,
            y: event.clientY,
          };
        });

        stage.addEventListener('pointerup', (event) => {
          if (!pointerStart) return;

          const dx = event.clientX - pointerStart.x;
          const dy = event.clientY - pointerStart.y;
          pointerStart = null;

          if (
            Math.abs(dx) > 45 &&
            Math.abs(dx) > Math.abs(dy)
          ) {
            goTo(active + (dx < 0 ? 1 : -1));
          }
        });

        stage.addEventListener('pointercancel', () => {
          pointerStart = null;
        });

        render();
        window.addEventListener('resize', render);
      });
    </script>
  </body>
</html>
