
<style is:global>
  :root {
    color-scheme: dark;
    --page-bg: #000;
    --page-text: #fff;
    --card-bg: #111;
    --card-text: #fff;
    --border-color: #333;
  }

  :root[data-theme="light"] {
    color-scheme: light;
    --page-bg: #fff;
    --page-text: #111;
    --card-bg: #f5f5f5;
    --card-text: #111;
    --border-color: #ddd;
  }

  html,
  body {
    min-height: 100%;
    background: var(--page-bg) !important;
    color: var(--page-text) !important;
  }

  body.home {
    min-height: 100vh;
    background-image: none !important;
  }

  body.home header,
  body.home main,
  body.home footer,
  body.home .hero,
  body.home .posts h2 {
    color: var(--page-text) !important;
  }

  body.home .hero {
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 2rem 1rem;
  }

  body.home .nav-links a {
    color: var(--page-text) !important;
    transition: color 0.25s ease;
  }

  body.home .post-card a {
    display: block;
    background: var(--card-bg) !important;
    color: var(--card-text) !important;
    border: 1px solid var(--border-color);
  }

  body.home .post-card h3,
  body.home .post-card p,
  body.home .thumbnail-title {
    color: var(--card-text) !important;
  }

  body.home header nav .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  body.home .site-logo {
    display: block;
    width: 57.6px;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 600px) {
    body.home .site-logo {
      width: 50.4px;
    }
  }
html,
body,
body.home {
  background: #000 !important;
  color: #fff !important;
}
</style>
