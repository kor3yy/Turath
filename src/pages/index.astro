---
import TurathIntro from '../components/TurathIntro.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import LiquidCursor from '../components/LiquidCursor.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import BackgroundPhotoFlash from '../components/backgroundphotoflash.astro';

const allPosts = await getCollection('blog');

const newestFirst = (a, b) =>
  (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0);

const acknowledgments = allPosts.find((post) =>
  post.data.title.toLowerCase().includes('acknowledgment')
);

const findPost = (identity) => {
  const normalizedIdentity = identity.toLowerCase();

  return allPosts.find((post) =>
    post.data.title.toLowerCase().includes(normalizedIdentity) ||
    post.slug.toLowerCase().includes(normalizedIdentity.replaceAll(' ', '-'))
  );
};

const photographyPosts = [
  findPost('will abbass'),
  findPost('ian armata'),
].filter(Boolean);

const musicPosts = [
  findPost('savia'),
  findPost('razi'),
  findPost('jenna'),
  findPost('toren'),
].filter(Boolean);

const uniquePosts = (posts) => {
  const seen = new Set();

  return posts.filter((post) => {
    if (!post || seen.has(post.slug)) return false;
    seen.add(post.slug);
    return true;
  });
};

const uniquePhotographyPosts = uniquePosts(photographyPosts);
const uniqueMusicPosts = uniquePosts(musicPosts);

const assignedSlugs = new Set([
  acknowledgments?.slug,
  ...uniquePhotographyPosts.map((post) => post.slug),
  ...uniqueMusicPosts.map((post) => post.slug),
].filter(Boolean));

const otherPosts = allPosts
  .filter((post) => !assignedSlugs.has(post.slug))
  .sort(newestFirst);

const sections = [
  {
    id: 'photography',
    title: 'Photography',
    subtitle: 'Images, perspectives & the people behind them',
    posts: uniquePhotographyPosts,
  },
  {
    id: 'music',
    title: 'Music',
    subtitle: 'Sound, artists & creative expression',
    posts: uniqueMusicPosts,
  },
];
