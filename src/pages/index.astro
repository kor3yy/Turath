
---
import TurathIntro from '../components/TurathIntro.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import LiquidCursor from '../components/LiquidCursor.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const allPosts = await getCollection('blog');

const pinnedPosts = allPosts
  .filter((post) => post.data.pinned)
  .sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

const otherPosts = allPosts
  .filter((post) => !post.data.pinned)
  .sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

const posts = [...pinnedPosts, ...otherPosts];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Turath</title>

    <style is:global>
      :root {
        color-scheme: dark;
        --page-bg: #000;
        --page-text: #fff;
        --card-bg: #111;
        --card-text: #fff;
        --border-color: #333;
      }

      :root[data-theme="light"] {
        color-scheme: light;
        --page-bg: #fff;
        --page-text: #111;
        --card-bg: #f5f5f5;
        --card-text: #111;
        --border-color: #ddd;
      }

      html,
      body {
        min-height: 100%;
        background: var(--page-bg);
        color: var(--page-text);
      }

      body.home {
        min-height: 100vh;
        background-image: none;
      }

      body.home header,
      body.home main,
      body.home footer,
      body.home .hero,
      body.home .posts h2 {
        color: var(--page-text);
      }

      body.home .hero {
        background: transparent;
        border: none;
        border-radius: 0;
        box-shadow: none;
        padding: 2rem 1rem;
      }

      body.home .nav-links a {
        color: var(--page-text);
        transition: color 0.25s ease;
      }

      body.home .post-card a {
        display: block;
        position: relative;
        background: var(--card-bg);
        color: var(--card-text);
        border: 1px solid var(--border-color);
      }

      body.home .post-card h3,
      body.home .post-card p,
      body.home .thumbnail-title {
        color: var(--card-text);
      }

      body.home header nav .logo {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }

      body.home .site-logo {
        display: block;
        width: 57.6px;
        height: auto;
        object-fit: contain;
      }

      /* Moving Turath statement */
      body.home .turath-marquee {
        width: 100%;
        overflow: hidden;
        padding: 1rem 0;
        margin: 0 0 0.5rem;
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
      }

      body.home .turath-marquee-track {
        display: flex;
        width: max-content;
        animation: turath-scroll 8s linear infinite;
        will-change: transform;
      }

      body.home .turath-marquee-track span {
        flex-shrink: 0;
        white-space: nowrap;
        padding-right: 1rem;
        font-size: 0.75rem;
        letter-spacing: 0.2em;
        color: var(--page-text);
        opacity: 0.75;
      }

      body.home .turath-tagline {
        margin: 0 auto 2rem;
        padding: 0.5rem 1rem;
        text-align: center;
        font-size: 0.85rem;
        font-style: italic;
        letter-spacing: 0.04em;
        color: var(--page-text);
        opacity: 0.7;
      }

      @keyframes turath-scroll {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }

      @media (max-width: 600px) {
        body.home .site-logo {
          width: 50.4px;
        }

        body.home .turath-marquee-track span {
          font-size: 0.7rem;
          letter-spacing: 0.14em;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        body.home .turath-marquee-track {
          animation: none;
        }
      }
    </style>
  </head>

  <body class="home">
    <TurathIntro />
    <LiquidCursor />

    <header>
      <nav>
        <a href="/" class="logo" aria-label="Turath homepage">
          <img
            src="/images/logo-removebg-preview.png"
            alt="Turath logo"
            class="site-logo"
          />
        </a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/about">About</a>
        </div>

        <ThemeToggle />
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Turath</h1>
      </section>

      <div
        class="turath-marquee"
        aria-label="Culture. Art. Expression. History."
      >
        <div class="turath-marquee-track" aria-hidden="true">
          <span>CULTURE. ART. EXPRESSION. HISTORY. &nbsp; · &nbsp;</span>
          <span>CULTURE. ART. EXPRESSION. HISTORY. &nbsp; · &nbsp;</span>
          <span>CULTURE. ART. EXPRESSION. HISTORY. &nbsp; · &nbsp;</span>
          <span>CULTURE. ART. EXPRESSION. HISTORY. &nbsp; · &nbsp;</span>
          <span>CULTURE. ART. EXPRESSION. HISTORY. &nbsp; · &nbsp;</span>
          <span>CULTURE. ART. EXPRESSION. HISTORY. &nbsp; · &nbsp;</span>
          <span>CULTURE. ART. EXPRESSION. HISTORY. &nbsp; · &nbsp;</span>
          <span>CULTURE. ART. EXPRESSION. HISTORY. &nbsp; · &nbsp;</span>
        </div>
      </div>

      <p class="turath-tagline">
        orchestrated through articles &amp; perspectives.
      </p>

      <section class="posts">
        <h2>Latest Posts</h2>

        <ul class="post-list">
          {posts.map((post) => (
            <li
              class:list={[
                'post-card',
                post.data.title === 'Acknowledgments' && 'acknowledgments-card',
              ]}
            >
              <a href={`/blog/${post.slug}/`}>
                <div class="thumbnail-wrap">
                  {post.data.thumbnail && (
                    <img
                      src={post.data.thumbnail}
                      alt={post.data.title}
                      class="post-thumbnail"
                    />
                  )}
                  <span class="thumbnail-title">{post.data.title}</span>
                </div>

                <h3>{post.data.title}</h3>

                <p class="post-date">
                  {post.data.pubDate
                    ? post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })
                    : ''}
                </p>

                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Turath. All rights reserved.</p>
    </footer>
  </body>
</html>
