
---
import TurathIntro from '../components/TurathIntro.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import LiquidCursor from '../components/LiquidCursor.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const allPosts = await getCollection('blog');

const pinnedPosts = allPosts
  .filter((post) => post.data.pinned)
  .sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

const otherPosts = allPosts
  .filter((post) => !post.data.pinned)
  .sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

const posts = [...pinnedPosts, ...otherPosts];

const postsWithThumbs = posts.map((post) => ({
  ...post,
  firstImage: post.data.thumbnail,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Turath</title>

    <style is:global>
      /* Homepage background */
      body.home {
        background-image: url('/images/6bb21238-7f80-4c33-9544-e25c57cd383a.png');
        background-size: 100% auto;
        background-position: center top;
        background-attachment: scroll;
        background-repeat: no-repeat;
        background-color: #ffffff;
      }

      @media (max-width: 600px) {
        body.home {
          background-size: 100% auto;
          background-position: center top;
          background-repeat: no-repeat;
        }
      }

      /* White background behind article cards */
      body.home .post-card a {
        background: rgba(255, 255, 255, 0.92);
      }

      /* Homepage introduction */
      body.home .hero {
        background: rgba(255, 255, 255, 0.85);
        border-radius: 12px;
        padding: 2rem 1rem;
      }

      /* Website logo */
      body.home header nav .logo {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }

      body.home .site-logo {
        display: block;
        width: 57.6px;
        height: auto;
        object-fit: contain;
      }

      @media (max-width: 600px) {
        body.home .site-logo {
          width: 50.4px;
        }
      }
    </style>
  </head>

  <body class="home">
    <TurathIntro />
    <LiquidCursor />

    <header>
      <nav>
        <a href="/" class="logo" aria-label="Turath homepage">
          <img
            src="/images/logo.jpg"
            alt="Turath logo"
            class="site-logo"
          />
        </a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Turath</h1>
      </section>

      <section class="posts">
        <h2>Latest Posts</h2>

        <ul class="post-list">
          {postsWithThumbs.map((post) => (
            <li class="post-card">
              <a href={`/blog/${post.slug}/`}>
                <div class="thumbnail-wrap">
                  {post.firstImage && (
                    <img
                      src={post.firstImage}
                      alt={post.data.title}
                      class="post-thumbnail"
                    />
                  )}
                  <span class="thumbnail-title">{post.data.title}</span>
                </div>

                <h3>{post.data.title}</h3>

                <p class="post-date">
                  {post.data.pubDate
                    ? post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })
                    : ''}
                </p>

                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Turath. All rights reserved.</p>
    </footer>
  </body>
</html>
