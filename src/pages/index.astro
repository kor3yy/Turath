
---
import TurathIntro from '../components/TurathIntro.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import LiquidCursor from '../components/LiquidCursor.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const allPosts = await getCollection('blog');

const pinnedPosts = allPosts
  .filter((post) => post.data.pinned)
  .sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

const otherPosts = allPosts
  .filter((post) => !post.data.pinned)
  .sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

const posts = [...pinnedPosts, ...otherPosts];

const postsWithThumbs = posts.map((post) => ({
  ...post,
  firstImage: post.data.thumbnail,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Turath</title>

   
<style is:global>
  :root {
    color-scheme: dark;
    --page-bg: #000;
    --page-text: #fff;
    --card-bg: #111;
    --card-text: #fff;
    --hero-bg: #111;
    --border-color: #333;
  }

  :root[data-theme="light"] {
    color-scheme: light;
    --page-bg: #fff;
    --page-text: #111;
    --card-bg: #f5f5f5;
    --card-text: #111;
    --hero-bg: #f5f5f5;
    --border-color: #ddd;
  }

  html,
  body {
    background-color: var(--page-bg);
    color: var(--page-text);
  }

  body.home {
    background-image: none;
    background-color: var(--page-bg);
    color: var(--page-text);
    min-height: 100vh;
  }

  body.home header,
  body.home main,
  body.home footer {
    color: var(--page-text);
  }
body.home .hero {
  background: transparent;
  color: var(--page-text);
  border: none;
  border-radius: 0;
  padding: 2rem 1rem;
  box-shadow: none;
  }

  body.home .posts h2,
  body.home .hero h1 {
    color: var(--page-text);
  }

  body.home .post-card a {
    display: block;
    background: var(--card-bg);
    color: var(--card-text);
    border: 1px solid var(--border-color);
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  body.home .post-card h3,
  body.home .post-card p,
  body.home .thumbnail-title {
    color: var(--card-text);
  }

  body.home header nav .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  body.home .site-logo {
    display: block;
    width: 57.6px;
    height: auto;
    object-fit: contain;
  }

 body.home .nav-links a {
  color: var(--page-text);
  text-decoration-color: var(--page-text);
  transition: color 0.25s ease;
}

body.home .nav-links a:hover {
  opacity: 0.65;
}
  }

  @media (max-width: 600px) {
    body.home .site-logo {
      width: 50.4px;
    }
  }
</style>
  </head>

  <body class="home">
    <TurathIntro />
    <LiquidCursor />

    <header>
      <nav>
        <a href="/" class="logo" aria-label="Turath homepage">
          <img
            src="/images/logo.jpg"
            alt="Turath logo"
            class="site-logo"
          />
        </a>

      <div class="nav-links">
  <a href="/">Home</a>
  <a href="/about">About</a>
</div>

<ThemeToggle />
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Turath</h1>
      </section>

      <section class="posts">
        <h2>Latest Posts</h2>

        <ul class="post-list">
          {postsWithThumbs.map((post) => (
            <li class="post-card">
              <a href={`/blog/${post.slug}/`}>
                <div class="thumbnail-wrap">
                  {post.firstImage && (
                    <img
                      src={post.firstImage}
                      alt={post.data.title}
                      class="post-thumbnail"
                    />
                  )}
                  <span class="thumbnail-title">{post.data.title}</span>
                </div>

                <h3>{post.data.title}</h3>

                <p class="post-date">
                  {post.data.pubDate
                    ? post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })
                    : ''}
                </p>

                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Turath. All rights reserved.</p>
    </footer>
  </body>
</html>
